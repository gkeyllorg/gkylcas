/* This script generates the kernels for the surface terms of Euler's equations.

   The numerical flux is that of the Riemann solver of the wave equation object, as in the
   finite-volume solvers: at each quadrature point of an interface the states of the two cells
   are evaluated, rotated to the frame of the interface, and passed to the solver the object was
   built with (rp_type: Roe, HLLC, Lax, HLL); the flux is F(q_l) + amdq, with amdq the
   left-going fluctuation. The point values of the flux are then converted to an expansion on
   the surface basis (in 1x the interface is a point).

   The quadrature points are the polyOrder+1 Gauss-Legendre points per surface direction of the
   upwinding kernels, which integrate polynomials of degree 2 polyOrder + 1 exactly. */

load("core/modal-basis.mac");
load("util_maxima/out-scripts.mac");
load(stringproc)$
load("core/nodal_operations/nodal_functions.mac")$
fpprec : 24$

cvars : [x, y, z]$

lhs : [outrho, outrhoux, outrhouy, outrhouz, outenergy]$
eulerFlds : ["rho", "rhoux", "rhouy", "rhouz", "energy"]$

/* isIso = false: Euler, [rho, rho ux, rho uy, rho uz, energy], with the inlined rotations and flux
   of the Euler wave equation. isIso = true: isothermal Euler, [rho, rho ux, rho uy, rho uz], with
   the rotations and flux of gkyl_iso_euler_kernels.h (those of the isothermal wave equation are
   not inlined). */
calcEulerUpdateInDir(dir, fh, funcNm, cdim, basisFun, polyOrder, isIso) := block(
  [varsC,bC,NC,cv,surfVars,bSurf,NSurf,basisStr,numNodes,fld,sideStr,evalStr,
   fluxl_e,fluxr_e,incr_l,incr_r,k,m,i,s,numEq,rotLocal,rotGlobal,fluxFn],

  numEq : if isIso then 4 else 5,
  rotLocal : if isIso then "iso_euler_rot_to_local" else "rot_to_local",
  rotGlobal : if isIso then "iso_euler_rot_to_global" else "rot_to_global",
  fluxFn : if isIso then "iso_euler_flux(vt" else "gkyl_euler_flux(gas_gamma",

  kill(varsC, bC),

  /* Load basis of dimensionality requested. */
  [varsC,bC] : loadBasis(basisFun, cdim, polyOrder),

  /* Number of basis monomials. */
  NC : length(bC),

  /* cv = variable in direction of surface update. */
  cv : varsC[dir],

  /* Surface variables to integrate over, surface basis and quadrature points. */
  surfVars : delete(cv,varsC),
  if cdim = 1 then (
    bSurf : [1],
    numNodes : 1
  ) else (
    bSurf : basisFromVars(basisFun,surfVars,polyOrder),
    numNodes : length(gaussOrd(polyOrder+1, cdim-1))
  ),
  NSurf : length(bSurf),
  basisStr : sconcat(basisFun, "_", cdim, "x", "_p", polyOrder),

  printf(fh, "GKYL_CU_DH double ~a~a_~ax_~a_p~a(const double *w, const double *dxv, const double *jacob_pos,
    const struct gkyl_wv_eqn *wv_eqn,
    const struct gkyl_wave_cell_geom *geom_l, const struct gkyl_wave_cell_geom *geom_r,
    const double *fluid_l, const double *fluid_c, const double *fluid_r,
    double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cvars[dir], cdim, basisFun, polyOrder),
  printf(fh, "  // w[NDIM]:      Cell-center coordinates.~%"),
  printf(fh, "  // dxv[NDIM]:    Cell spacing (computational).~%"),
  printf(fh, "  // jacob_pos:    Position-map Jacobian per configuration direction of the cell (cdim blocks of~%"),
  printf(fh, "  //               ~a equal entries): its physical size in direction d is J_d dxv[d].~%", polyOrder+1),
  printf(fh, "  // wv_eqn:       Wave equation: the Riemann solver for the flux at the interfaces.~%"),
  printf(fh, "  // geom_l:       Geometry for the left surface update.~%"),
  printf(fh, "  // geom_r:       Geometry for the right surface update.~%"),
  if isIso then
    printf(fh, "  // fluid_l/c/r:  [rho, rho ux, rho uy, rho uz], Fluid input state vector in left/center/right cells.~%")
  else
    printf(fh, "  // fluid_l/c/r:  [rho, rho ux, rho uy, rho uz, energy], Fluid input state vector in left/center/right cells.~%"),
  printf(fh, "  // out:          Incremented output.~%"),
  printf(fh, "~%"),

  printf(fh, "  const double dx1 = 2.0/(dxv[~a]*jacob_pos[~a]); ~%", dir-1, (polyOrder+1)*(dir-1)),
  if isIso then
    printf(fh, "  const double vt = container_of(wv_eqn, struct wv_iso_euler, eqn)->vt; ~%")
  else
    printf(fh, "  const double gas_gamma = container_of(wv_eqn, struct wv_euler, eqn)->gas_gamma; ~%"),
  printf(fh, "~%"),
  for s in ["l", "c", "r"] do (
    for k : 1 thru numEq do (
      printf(fh, "  const double *~a_~a = &fluid_~a[~a]; ~%", eulerFlds[k], s, s, (k-1)*NC)
    ),
    printf(fh, "~%")
  ),
  for k : 1 thru numEq do (
    printf(fh, "  double *out~a = &out[~a]; ~%", eulerFlds[k], (k-1)*NC)
  ),
  printf(fh, "~%"),

  /* States of the two cells at an interface point, global and in the frame of the interface:
     lr (left cell, its right edge) and cl (center cell, its left edge) at the left interface,
     cr and rl at the right interface. */
  for s in ["lr", "cl", "cr", "rl"] do (
    printf(fh, "  double q_~a[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double q_~a_local[~a] = {0.0}; ~%", s, numEq)
  ),
  for s in ["l", "r"] do (
    printf(fh, "  double delta_~a[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double waves_~a[~a] = {0.0}; ~%", s, 3*numEq),
    printf(fh, "  double speeds_~a[3] = {0.0}; ~%", s),
    printf(fh, "  double amdq_~a_local[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double apdq_~a_local[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double fhat_~a_local[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double fhat_~a[~a] = {0.0}; ~%", s, numEq),
    printf(fh, "  double lenr_~a = geom_~a->lenr[~a]; ~%", s, s, dir-1)
  ),
  /* Flux at the quadrature points and its surface expansion, for each interface. */
  for k : 1 thru numEq do (
    for s in ["l", "r"] do (
      if cdim > 1 then printf(fh, "  double flux_~a_quad_~a[~a] = {0.0}; ~%", eulerFlds[k], s, numNodes),
      printf(fh, "  double flux_~a_~a[~a] = {0.0}; ~%", eulerFlds[k], s, NSurf)
    )
  ),
  printf(fh, "~%"),

  for i : 1 thru numNodes do (
    /* Evaluate the states at the quadrature point. */
    for s in [["lr", "l", "r", 1], ["cl", "c", "l", -1], ["cr", "c", "r", 1], ["rl", "r", "l", -1]] do (
      for k : 1 thru numEq do (
        if cdim = 1 then (
          evalStr : string(float(expand(subst(cv=s[4], doExpand1(eval_string(sconcat(eulerFlds[k], "_", s[2])), bC)))))
        ) else (
          evalStr : sconcat(basisStr, "_surfx", dir, "_eval_quad_node_", i-1, "_", s[3], "(", eulerFlds[k], "_", s[2], ")")
        ),
        printf(fh, "  q_~a[~a] = ~a; ~%", s[1], k-1, evalStr)
      )
    ),
    printf(fh, "~%"),

    /* Rotate to the frame of each interface. */
    printf(fh, "  ~a(wv_eqn, geom_l->tau1[~a], geom_l->tau2[~a], geom_l->norm[~a], q_lr, q_lr_local); ~%", rotLocal, dir-1, dir-1, dir-1),
    printf(fh, "  ~a(wv_eqn, geom_l->tau1[~a], geom_l->tau2[~a], geom_l->norm[~a], q_cl, q_cl_local); ~%", rotLocal, dir-1, dir-1, dir-1),
    printf(fh, "  ~a(wv_eqn, geom_r->tau1[~a], geom_r->tau2[~a], geom_r->norm[~a], q_cr, q_cr_local); ~%", rotLocal, dir-1, dir-1, dir-1),
    printf(fh, "  ~a(wv_eqn, geom_r->tau1[~a], geom_r->tau2[~a], geom_r->norm[~a], q_rl, q_rl_local); ~%", rotLocal, dir-1, dir-1, dir-1),
    printf(fh, "~%"),

    /* Jumps, waves and fluctuations of the Riemann solver, and the flux F(q_l) + amdq (the speeds
       and the physical flux scaled by the face length ratio). */
    printf(fh, "  for (int i = 0; i < ~a; ++i) { ~%", numEq),
    printf(fh, "    delta_l[i] = q_cl_local[i] - q_lr_local[i]; ~%"),
    printf(fh, "    delta_r[i] = q_rl_local[i] - q_cr_local[i]; ~%"),
    printf(fh, "  } ~%"),
    printf(fh, "  gkyl_wv_eqn_waves(wv_eqn, GKYL_WV_HIGH_ORDER_FLUX, delta_l, q_lr_local, q_cl_local, 1.0, 1.0, waves_l, speeds_l); ~%"),
    printf(fh, "  gkyl_wv_eqn_waves(wv_eqn, GKYL_WV_HIGH_ORDER_FLUX, delta_r, q_cr_local, q_rl_local, 1.0, 1.0, waves_r, speeds_r); ~%"),
    printf(fh, "  for (int i = 0; i < 3; ++i) { ~%"),
    printf(fh, "    speeds_l[i] *= lenr_l; ~%"),
    printf(fh, "    speeds_r[i] *= lenr_r; ~%"),
    printf(fh, "  } ~%"),
    printf(fh, "  gkyl_wv_eqn_qfluct(wv_eqn, GKYL_WV_HIGH_ORDER_FLUX, q_lr_local, q_cl_local, 1.0, 1.0, waves_l, speeds_l, amdq_l_local, apdq_l_local); ~%"),
    printf(fh, "  gkyl_wv_eqn_qfluct(wv_eqn, GKYL_WV_HIGH_ORDER_FLUX, q_cr_local, q_rl_local, 1.0, 1.0, waves_r, speeds_r, amdq_r_local, apdq_r_local); ~%"),
    printf(fh, "  ~a, q_lr_local, fhat_l_local); ~%", fluxFn),
    printf(fh, "  ~a, q_cr_local, fhat_r_local); ~%", fluxFn),
    printf(fh, "  for (int i = 0; i < ~a; ++i) { ~%", numEq),
    printf(fh, "    fhat_l_local[i] = lenr_l*fhat_l_local[i] + amdq_l_local[i]; ~%"),
    printf(fh, "    fhat_r_local[i] = lenr_r*fhat_r_local[i] + amdq_r_local[i]; ~%"),
    printf(fh, "  } ~%"),
    printf(fh, "  ~a(wv_eqn, geom_l->tau1[~a], geom_l->tau2[~a], geom_l->norm[~a], fhat_l_local, fhat_l); ~%", rotGlobal, dir-1, dir-1, dir-1),
    printf(fh, "  ~a(wv_eqn, geom_r->tau1[~a], geom_r->tau2[~a], geom_r->norm[~a], fhat_r_local, fhat_r); ~%", rotGlobal, dir-1, dir-1, dir-1),
    for k : 1 thru numEq do (
      if cdim = 1 then (
        printf(fh, "  flux_~a_l[0] = fhat_l[~a]; ~%", eulerFlds[k], k-1),
        printf(fh, "  flux_~a_r[0] = fhat_r[~a]; ~%", eulerFlds[k], k-1)
      ) else (
        printf(fh, "  flux_~a_quad_l[~a] = fhat_l[~a]; ~%", eulerFlds[k], i-1, k-1),
        printf(fh, "  flux_~a_quad_r[~a] = fhat_r[~a]; ~%", eulerFlds[k], i-1, k-1)
      )
    ),
    printf(fh, "~%"),
    flush_output(fh)
  ),

  /* Surface expansion of the flux from its values at the quadrature points. */
  if cdim > 1 then (
    for k : 1 thru numEq do (
      printf(fh, "  ~a_upwind_quad_to_modal(flux_~a_quad_l, flux_~a_l); ~%", basisStr, eulerFlds[k], eulerFlds[k]),
      printf(fh, "  ~a_upwind_quad_to_modal(flux_~a_quad_r, flux_~a_r); ~%", basisStr, eulerFlds[k], eulerFlds[k])
    ),
    printf(fh, "~%")
  ),

  /* Increments of the cell from its left and right interfaces. */
  for m : 1 thru numEq do (
    fluxl_e : doExpand1(eval_string(sconcat("flux_", eulerFlds[m], "_l")), bSurf),
    fluxr_e : doExpand1(eval_string(sconcat("flux_", eulerFlds[m], "_r")), bSurf),
    incr_l : calcInnerProdList(surfVars, 1, subst(cv=-1, bC), fluxl_e),
    incr_r : calcInnerProdList(surfVars, -1, subst(cv=1, bC), fluxr_e),
    writeCIncrExprsCollect1lhsc(lhs[m], dx1*(incr_l + incr_r)),
    printf(fh, "~%"),
    flush_output(fh)
  ),

  printf(fh, "  return 0.;~%"),  /* Return CFL frequency from volume kernel. */
  printf(fh, "~%"),
  printf(fh, "} ~%")
);
