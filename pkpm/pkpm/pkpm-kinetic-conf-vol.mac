/* pkpm-kinetic-conf-vol.mac --------------------------------------------------
   Volume kernel of the configuration-space pass (stage A) of the p=1 PKPM kinetic
   update. With F = F_0, G = (T_perp/m)(F_0 - F_1), theta = T_perp/m, the evolved
   array [F, G] and the weak form  integral(phi dF/dt) = + integral(grad phi . flux)
   - surface terms, the kernel increments out = [out_F, out_G] by

     streaming      integral( d_x phi . (v b + u) [F, G] )                 (all conf directions)
     v_par forces   integral( d_v phi  ( -v K [F, G] + beta [G, H] ) )
     G source       integral( phi ( (K - div u - v beta - 2 nu) G + 2 (nu vth^2)_sum F ) )

   with K = sum_ij b_i b_j d_i u_j, beta = div b, H = 4 theta G + 2 theta^2 (F_2 - F) and
   F_2 = 0 (lowest-order Laguerre closure). The pressure force a_P [F, G] in v_par and the
   v_par surface term belong to the velocity-space pass (stage B) once a_P is closed from
   the first moment of this right-hand side.

   Everything is integrated EXACTLY: the products of modal fields are expanded symbolically
   and the configuration-space factors that are not representable in the p=1 basis are
   first projected, exactly, onto the tensor basis that contains them,

     div b, div u, K         from the weak (surface-averaged) gradients grad_b, grad_u
                             computed by pkpm_vars_grad_u_* (pkpm-vars-grad-u.mac):
                             the in-cell gradient of u feeds a slope sawtooth back into
                             the sources; the weak gradient cancels it, and b is treated
                             the same way for consistency
     theta^2                 tensor p=2
     K                       tensor p=3 (three p=1 factors)
     H = 4 theta G - 2 theta^2 F   (tensor p=3 in configuration space) x (p=2 in v_par)

   so no product is projected back onto p=1 before it multiplies another field. The
   returned CFL estimate covers the G source rate (the streaming and force speeds are
   accumulated by the surface-flux updaters). */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("util_maxima/utilities.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-cas-util.mac")$
load(stringproc)$
fpprec : 24$

cvars : [x, y, z]$
dx1s : [dx10, dx11, dx12]$


calcPKPMKineticConfVol(fh, funcNm, cdim) := block(
  [lb, pkC, pkbC, pkV, pkbV, pkP, pkbP, NC, NP, lb2, bC2, NC2, lb3, bC3, NC3, bP3, NP3,
   vTrans, bx_e, by_e, bz_e, b_e, ux_e, uy_e, uz_e, u_e, theta_e, nu_e, nuvt_e, F_e, G_e,
   div_b_c, div_u_c, theta_sq_c, K_c, div_b_e, div_u_e, theta_sq_e, K_e, H_c, H_e, clst,
   stream_F, stream_G, force_F, force_G, src_G, d, i, j, cflK, cflDivU, cflNu, cflDivB, gu_e],

  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), pkV : copylist(lb[3]), pkbV : copylist(lb[4]),
  pkP : copylist(lb[5]), pkbP : copylist(lb[6]),
  NC : length(pkbC),
  NP : length(pkbP),

  /* Exact containers for the configuration-space products. */
  lb2 : loadBasis("tensor", cdim, 2),
  bC2 : copylist(lb2[2]),
  NC2 : length(bC2),
  lb3 : loadBasis("tensor", cdim, 3),
  bC3 : copylist(lb3[2]),
  NC3 : length(bC3),
  /* (tensor p=3 conf) x (p=2 v_par): orthonormal products. */
  bP3 : [],
  for i : 1 thru NC3 do
    for j : 1 thru length(pkbV) do
      bP3 : endcons(bC3[i]*pkbV[j], bP3),
  NP3 : length(bP3),

  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv,
  const double *bvar, const double *grad_b, const double *u, const double *grad_u, const double *theta,
  const double *nu_sum, const double *nu_vthsq_sum,
  const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:      Cell-center coordinates. ~%"),
  printf(fh, "  // dxv[NDIM]:    Cell spacing. ~%"),
  printf(fh, "  // bvar:         Magnetic field unit vector [bx, by, bz]. ~%"),
  printf(fh, "  // grad_b:       Weak gradient of b, [d_i bx, d_i by, d_i bz] per direction i. ~%"),
  printf(fh, "  // u:            Flow velocity [ux, uy, uz]. ~%"),
  printf(fh, "  // grad_u:       Weak gradient of u, [d_i ux, d_i uy, d_i uz] per direction i. ~%"),
  printf(fh, "  // theta:        T_perp/m. ~%"),
  printf(fh, "  // nu_sum:       Collisionality summed over self and cross collisions. ~%"),
  printf(fh, "  // nu_vthsq_sum: Sum of nu*vth^2 over self and cross collisions. ~%"),
  printf(fh, "  // f:            Input distribution functions [F_0, G]. ~%"),
  printf(fh, "  // out:          Incremented output [F_0, G]. ~%"),
  printf(fh, "  // Returns the CFL frequency estimate of the G source rate. ~%"),
  for d : 1 thru cdim do
    printf(fh, "  const double dx1~a = 2.0/dxv[~a]; ~%", d-1, d-1),
  printf(fh, "  const double dv1 = 2.0/dxv[~a]; ~%", cdim),
  printf(fh, "  const double dvpar = dxv[~a], wvpar = w[~a]; ~%", cdim, cdim),
  printf(fh, "  const double *bx = &bvar[~a]; ~%", 0*NC),
  printf(fh, "  const double *by = &bvar[~a]; ~%", 1*NC),
  printf(fh, "  const double *bz = &bvar[~a]; ~%", 2*NC),
  printf(fh, "  const double *ux = &u[~a]; ~%", 0*NC),
  printf(fh, "  const double *uy = &u[~a]; ~%", 1*NC),
  printf(fh, "  const double *uz = &u[~a]; ~%", 2*NC),
  for d : 1 thru cdim do
    for j : 1 thru 3 do
      printf(fh, "  const double *gu~a~a = &grad_u[~a]; ~%", cvars[d], cvars[j], ((d-1)*3 + (j-1))*NC),
  for d : 1 thru cdim do
    printf(fh, "  const double *gb~a~a = &grad_b[~a]; ~%", cvars[d], cvars[d], ((d-1)*3 + (d-1))*NC),
  printf(fh, "  const double *F_0 = &f[~a]; ~%", 0*NP),
  printf(fh, "  const double *G_1 = &f[~a]; ~%", 1*NP),
  printf(fh, "  double *out_F_0 = &out[~a]; ~%", 0*NP),
  printf(fh, "  double *out_G_1 = &out[~a]; ~%", 1*NP),
  printf(fh, " ~%"),

  vTrans : vx*dvpar/2 + wvpar,

  bx_e : doExpand1(bx, pkbC), by_e : doExpand1(by, pkbC), bz_e : doExpand1(bz, pkbC),
  b_e : [bx_e, by_e, bz_e],
  ux_e : doExpand1(ux, pkbC), uy_e : doExpand1(uy, pkbC), uz_e : doExpand1(uz, pkbC),
  u_e : [ux_e, uy_e, uz_e],
  gu_e : makelist(makelist(doExpand1(concat(gu, cvars[d], cvars[j]), pkbC), j, 1, 3), d, 1, cdim),
  theta_e : doExpand1(theta, pkbC),
  nu_e : doExpand1(nu_sum, pkbC),
  nuvt_e : doExpand1(nu_vthsq_sum, pkbC),
  F_e : doExpand1(F_0, pkbP),
  G_e : doExpand1(G_1, pkbP),

  /* div b, div u: exact in p=1. */
  div_b_c : calcInnerProdList(pkC, 1, pkbC, sum(doExpand1(concat(gb, cvars[d], cvars[d]), pkbC), d, 1, cdim)),
  div_u_c : calcInnerProdList(pkC, 1, pkbC, sum(gu_e[d][d], d, 1, cdim)),
  printf(fh, "  // div(b) and div(u) from the weak gradients (p=1). ~%"),
  printf(fh, "  double div_b[~a] = {0.0}; ~%", NC),
  printf(fh, "  double div_u[~a] = {0.0}; ~%", NC),
  pkpmWriteDefExprs(fh, "div_b", div_b_c),
  pkpmWriteDefExprs(fh, "div_u", div_u_c),
  printf(fh, " ~%"),

  /* theta^2: exact in tensor p=2. */
  theta_sq_c : calcInnerProdList(pkC, 1, bC2, theta_e^2),
  printf(fh, "  // theta^2: exact tensor p=2 expansion. ~%"),
  printf(fh, "  double theta_sq[~a] = {0.0}; ~%", NC2),
  pkpmWriteDefExprs(fh, "theta_sq", theta_sq_c),
  printf(fh, " ~%"),

  /* K = sum_ij b_i b_j d_i u_j: exact in tensor p=3 (only the existing
     configuration directions contribute derivatives). */
  K_c : calcInnerProdList(pkC, 1, bC3,
    sum(sum(b_e[i]*b_e[j]*gu_e[i][j], j, 1, 3), i, 1, cdim)),
  printf(fh, "  // K = b_i b_j d_i u_j: exact tensor p=3 expansion. ~%"),
  printf(fh, "  double K[~a] = {0.0}; ~%", NC3),
  pkpmWriteDefExprs(fh, "K", K_c),
  printf(fh, " ~%"),

  div_b_e : doExpand1(div_b, pkbC),
  div_u_e : doExpand1(div_u, pkbC),
  theta_sq_e : doExpand1(theta_sq, bC2),
  K_e : doExpand1(K, bC3),

  /* H = 4 theta G - 2 theta^2 F: exact in (tensor p=3) x (p=2 v_par). */
  H_c : calcInnerProdList(pkP, 1, bP3, 4*theta_e*G_e - 2*theta_sq_e*F_e),
  printf(fh, "  // H = 4 theta G - 2 theta^2 F (F_2 = 0): exact (tensor p=3) x (p=2) expansion. ~%"),
  printf(fh, "  double H[~a] = {0.0}; ~%", NP3),
  pkpmWriteDefExprs(fh, "H", H_c),
  printf(fh, " ~%"),
  H_e : doExpand1(H, bP3),

  /* Volume increments. */
  stream_F : 0, stream_G : 0,
  for d : 1 thru cdim do (
    stream_F : stream_F + dx1s[d]*calcInnerProdList(pkP, 1, diff(pkbP, pkC[d]), (vTrans*b_e[d] + u_e[d])*F_e),
    stream_G : stream_G + dx1s[d]*calcInnerProdList(pkP, 1, diff(pkbP, pkC[d]), (vTrans*b_e[d] + u_e[d])*G_e)
  ),
  force_F : dv1*calcInnerProdList(pkP, 1, diff(pkbP, vx), -vTrans*K_e*F_e + div_b_e*G_e),
  force_G : dv1*calcInnerProdList(pkP, 1, diff(pkbP, vx), -vTrans*K_e*G_e + div_b_e*H_e),
  src_G : calcInnerProdList(pkP, 1, pkbP, (K_e - div_u_e - 2*nu_e - vTrans*div_b_e)*G_e + 2*nuvt_e*F_e),

  clst : [dx10, dx11, dx12, dv1, dvpar, wvpar],
  printf(fh, "  // Streaming and v_par force volume terms of F_0. ~%"),
  pkpmWriteIncrExprs(fh, out_F_0, stream_F + force_F, clst),
  printf(fh, "  // Streaming, v_par force and mirror volume terms, and perpendicular source of G. ~%"),
  pkpmWriteIncrExprs(fh, out_G_1, stream_G + force_G + src_G, clst),
  printf(fh, " ~%"),

  /* CFL estimate of the G source rate at the cell center. */
  cflK : float(expand(subst(makelist(pkC[d] = 0, d, 1, cdim), K_e))),
  cflDivU : float(expand(subst(makelist(pkC[d] = 0, d, 1, cdim), div_u_e))),
  cflNu : float(expand(subst(makelist(pkC[d] = 0, d, 1, cdim), nu_e))),
  cflDivB : float(expand(subst(makelist(pkC[d] = 0, d, 1, cdim), div_b_e))),
  printf(fh, "  const double vmax = fmax(fabs(wvpar - 0.5*dvpar), fabs(wvpar + 0.5*dvpar)); ~%"),
  printf(fh, "  return fabs(~a - (~a) - 2.0*(~a)) + vmax*fabs(~a); ~%", pkpmPowToC(cflK), pkpmPowToC(cflDivU), pkpmPowToC(cflNu), pkpmPowToC(cflDivB)),
  printf(fh, "} ~%")
)$
