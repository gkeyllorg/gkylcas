/* Functions which compute the components of the surface flux in configuration space. 
   The procedure we utilize a set of functions that compute the characteristics
   alpha at surface quadrature points of the needed order, accumulating each component, 
   e.g., Hamiltonian forces.

   We then evaluate the Lax-Friedrichs flux G = alpha/2*(f^+ + f^-) - |alpha|/2*(f^+ - f^-)
   at each quadrature point, and then convert that back to a modal expansion of the 
   configruation-space flux for use in the final update in hyper_dg. 

   Note that we do not make any assumptions on the order of the phase space expansion
   and thus to evaluate G, we must utilize enough Gauss-Legendre quadrature points
   to integrate a 3*p polynomial (cubic for p=1, sixth order for p=2, ninth order for p=3). 
   We thus must use 2, 4, and 5 Gauss-Legendre points respectively. 

   In velocity space, certain Hamiltonians such as H = v^2/2 require fewer velocity space
   quadrature points since these Hamiltonians are "sparse." We separate the velocity space
   vs. configuration space quadrature loops and generate separate nodal configuration space
   and nodal velocity space surface bases. Since these quadrature rules are all tensor products
   of configuration space and velocity space, the final phase space basis is simply a tensor
   product of the configuration space and velocity space bases.  
*/

load("modal-basis");
load("out-scripts");
load("utilities")$
load("nodal_operations/nodal_functions")$
load("new_vlasov/vlasov-basis");
load("new_vlasov/nodal-lax-emit");
load("new_vlasov/alpha-factor-emit");
load("new_vlasov/surf-eval-tables");
load(stringproc)$
fpprec : 24$

clabels : ["x","y","z"]$
dx1 : [dx10, dx11, dx12]$
dv1 : [dv10, dv11, dv12]$
cidx(cdim) := makelist(i,i,0,cdim-1)$
vidx(cdim,vdim) := makelist(i,i,cdim,cdim+vdim-1)$

/* Phase-space Hamiltonian forces at velocity-space surface quadrature points. */
calcHamilVelSurfForceFlux(dir, fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, useHigherOrder) := block(
  [varsC,bC,varsV,bV,varsP,bP,cid,cv,surfVars,surfCVars,bSurf,NSurf,
   nodes_conf,basisNodalConf,num_nodes_conf,nodes_vel,basisNodalVel,num_nodes_vel,
   surfNodes,numNodes,NC,NV,NB,vid,tag,fact,NA,tabP,NS,b,d,edge,nJPts,jvinvExpr,
   NT,prelude,outerBody,innerBody,elbl,cond,ePre],

  [varsC,bC,varsV,bV,varsP,bP] : loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  NC : length(bC), 

  printf(fh, "#include <gkyl_flux_vlasov_kernels.h> ~%"),
  surfTabInclude(fh, cdim, vdim, basisFun, polyOrder),

  cid : cidx(cdim),
  vid : vidx(cdim,vdim),

  /* Surface contribution is defined as integral(phi^- Fhat) over the surface. */
  /* cv = variable in direction of surface update. */
  cv : varsP[dir],
  surfVars : delete(cv,varsP), /* Surface variables at constant cv surface. */
  surfCVars : delete(cv,varsC), /* Remaining configuration space variables at cv surface. */
  [bSurf,nodes_conf,basisNodalConf,nodes_vel,basisNodalVel,surfNodes] : loadVlasovConfSurfBasis(cdim, vdim, basisFun, polyOrder, surfVars, surfCVars, varsV, useHigherOrder),
  NSurf : length(bSurf),
  num_nodes_conf : length(nodes_conf),
  num_nodes_vel : length(nodes_vel),
  numNodes : length(surfNodes),
  tag : surfTabTag(cdim, vdim, basisFun, polyOrder, useHigherOrder),
  NV : length(bV),
  NB : length(bP),

  /* alpha^dir = Pi^{dir,d} dH/dv_d (Pi_xx = 0, so only velocity gradients
     enter), as outer x inner products, one term per velocity derivative d
     (per (d, outer shape a) for phase Hamiltonians):
       O(i) = Pi^{dir,d}(i)   the Poisson-tensor row evaluated at (cv = edge,
                              transverse configuration node i) [times Cm[i][a]],
       I(j) = dH/dv_d(j) dv1_d / J_v,d(j)   on the velocity-volume node grid
                              [G_d[j][a] for phase Hamiltonians].
     Each cell owns its *lower* edge fluxes: hamil_pt_edge = -1 evaluates at
     cv = -1 (the r-edge tables), +1 at cv = +1 (the l-edge tables); both
     factors branch on it. Each dH/dv_d derivative picks up the inverse
     velocity-map Jacobian of its own direction: a cell constant for the C^0
     linear map (ser), per velocity node for the C^1 cubic map (tensor) whose
     in-cell Jacobian is quadratic. vmap/jacob_pos: shared conf-producer ABI
     (mesh maps), unused here. */
  prelude : [], outerBody : [], innerBody : [],
  for d : 1 thru vdim do prelude : endcons(printf(false, "const double dv1~a = 2.0/dxv[~a];", d-1, vid[d]), prelude),
  nJPts : vlasovJacSurfStride(basisFun, polyOrder, useHigherOrder),
  jvinvExpr : makelist("", d, 1, vdim),
  if (vlasovVelMapRep(basisFun) = "cubic") then (
    for d : 1 thru vdim do block([nidx],
      if (vdim = 1) then nidx : "j"
      elseif (vdim = 2) then nidx : if (d = 1) then sconcat("j/", nJPts) else sconcat("j%", nJPts)
      else nidx : if (d = 1) then sconcat("j/", nJPts*nJPts)
        elseif (d = 2) then sconcat("j/", nJPts, "%", nJPts)
        else sconcat("j%", nJPts),
      jvinvExpr[d] : sconcat("(1.0/jacob_vel_surf[", nJPts*(d-1), " + ", nidx, "])")
    )
  ) else (
    for d : 1 thru vdim do (
      prelude : endcons(printf(false, "const double jacob_v~a_inv = 1.0/jacob_vel_surf[~a];", clabels[d], nJPts*(d-1)), prelude),
      jvinvExpr[d] : sconcat("jacob_v", clabels[d], "_inv")
    )
  ),
  for d : 1 thru vdim do
    prelude : endcons(printf(false, "const double *poisson_tensor_conf_~a = &poisson_tensor_conf[~a];", d - 1, NC*(dir-1)*vdim + NC*(d-1)), prelude),

  if (hamil_rep = "phase") then (
    fact : laxFactorizeBasis(bP, surfCVars, cons(cv, varsV)),
    NA : laxFactorSizes(fact, cv)[1],
    tabP : sconcat("vst_", tag, "_ph_x", dir-1),
    NT : vdim*NA
  ) else (
    NA : 1,
    NT : vdim
  ),

  /* Outer factors: Pi rows at the edge's transverse configuration nodes. */
  for edge in [-1, 1] do (
    if edge = -1 then (elbl : "r", cond : "== -1") else (elbl : "l", cond : "== 1"),
    outerBody : endcons(printf(false, "~a (hamil_pt_edge ~a) {", if edge = -1 then "if" else "else if", cond), outerBody),
    for d : 1 thru vdim do (
      outerBody : endcons(printf(false, "  double P~a = 0.0;", d-1), outerBody),
      outerBody : endcons(printf(false, "  for (int a = 0; a < ~a; ++a) P~a += vst_~a_confsurf_x~a_ev_~a[i*~a + a]*poisson_tensor_conf_~a[a];",
        NC, d-1, tag, dir-1, elbl, NC, d-1), outerBody),
      if (hamil_rep = "phase") then
        outerBody : endcons(printf(false, "  for (int a = 0; a < ~a; ++a) O[(~a + a)*~a + i] = P~a*~a_Cm[i*~a + a];", NA, (d-1)*NA, num_nodes_conf, d-1, tabP, NA), outerBody)
      else
        outerBody : endcons(printf(false, "  O[~a*~a + i] = P~a;", d-1, num_nodes_conf, d-1), outerBody)
    ),
    outerBody : endcons("}", outerBody)
  ),

  /* Inner factors: dH/dv_d at the velocity-volume node, times dv1_d / J_v,d. */
  if (hamil_rep = "phase") then (
    for edge in [-1, 1] do (
      if edge = -1 then (elbl : "r", cond : "== -1") else (elbl : "l", cond : "== 1"),
      innerBody : endcons(printf(false, "~a (hamil_pt_edge ~a) {", if edge = -1 then "if" else "else if", cond), innerBody),
      for d : 1 thru vdim do block([NMVd],
        NMVd : laxDerivSizes(fact, cv, varsV[d]),
        innerBody : endcons(printf(false, "  double G~a[~a];", d-1, NA), innerBody),
        innerBody : endcons(printf(false, "  for (int a = 0; a < ~a; ++a) G~a[a] = 0.0;", NA, d-1), innerBody),
        innerBody : endcons(printf(false, "  for (int k = 0; k < ~a; ++k) {", NB), innerBody),
        innerBody : endcons(printf(false, "    G~a[~a_cmap[k]] += ~a_Vd~a[j*~a + ~a_v~ad~amap[k]]*(~a_dcoef~a~a[k]*hamil[k]);",
          d-1, tabP, tabP, d-1, NMVd, tabP, elbl, d-1, tabP, elbl, d-1), innerBody),
        innerBody : endcons("  }", innerBody),
        innerBody : endcons(printf(false, "  for (int a = 0; a < ~a; ++a) I[(~a + a)*~a + j] = G~a[a]*dv1~a*~a;", NA, (d-1)*NA, num_nodes_vel, d-1, d-1, jvinvExpr[d]), innerBody)
      ),
      innerBody : endcons("}", innerBody)
    )
  )
  else (
    /* Velocity-space Hamiltonian: dH/dv_d has no cv dependence; the sparse
       (separable) flavor only references the constant and single-velocity-
       variable coefficients via the shared sparse index list. */
    NS : 0,
    for b : 1 thru NV do
      if length(intersection(setify(listofvars(bV[b])), setify(varsV))) <= 1 then NS : NS + 1,
    for d : 1 thru vdim do (
      innerBody : endcons(printf(false, "double dH_dv~a = 0.0;", d-1), innerBody),
      if (hamil_rep = "vel_sparse") then
        innerBody : append(innerBody, [
          printf(false, "for (int s = 0; s < ~a; ++s) {", NS),
          printf(false, "  const int b = vst_~a_vel_sparse_idx[s];", tag),
          printf(false, "  dH_dv~a += vst_~a_vel_vol_dv~a[j*~a + b]*hamil[b];", d-1, tag, d-1, NV),
          "}"])
      else
        innerBody : endcons(printf(false, "for (int b = 0; b < ~a; ++b) dH_dv~a += vst_~a_vel_vol_dv~a[j*~a + b]*hamil[b];", NV, d-1, tag, d-1, NV), innerBody),
      innerBody : endcons(printf(false, "I[~a*~a + j] = dH_dv~a*dv1~a*~a;", d-1, num_nodes_vel, d-1, d-1, jvinvExpr[d]), innerBody)
    )
  ),

  alphaEmitFactored(fh, funcNm,
    "const double *w, const double *dxv, const int hamil_pt_edge, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil",
    NT, num_nodes_conf, num_nodes_vel, prelude, outerBody, innerBody)
)$

/* Nodal Lax-Friedrichs to modal configuration-space flux. */
calcNodalLaxToModalVelFlux(dir, fh, funcNm, cdim, vdim, basisFun, polyOrder, useHigherOrder) := block(
  [varsC,bC,varsV,bV,varsP,bP,cid,cv,
   surfVars,surfCVars,bSurf,NSurf,
   nodes_conf,basisNodalConf,num_nodes_conf,nodes_vel,basisNodalVel,num_nodes_vel,
   surfNodes,numNodes,fact,sizesNA,tabP,bSurfP,NK,factP,prjPre],

  [varsC,bC,varsV,bV,varsP,bP] : loadVlasovBasis(basisFun, cdim, vdim, polyOrder),

  cv : varsC[dir],
  surfVars : delete(cv,varsP), /* Surface variables at constant cv surface. */
  surfCVars : delete(cv,varsC),
  [bSurf,nodes_conf,basisNodalConf,nodes_vel,basisNodalVel,surfNodes] : loadVlasovConfSurfBasis(cdim, vdim, basisFun, polyOrder, surfVars, surfCVars, varsV, useHigherOrder),
  NSurf : length(bSurf),
  num_nodes_conf : length(nodes_conf),
  num_nodes_vel : length(nodes_vel),
  numNodes : length(surfNodes),

  /* Sum-factorized nodal evaluation: outer factor = the remaining
     configuration-space surface variables, inner factor = the normal
     configuration variable (evaluated at the +/-1 edge) and all velocity
     variables. Verify the flat node ordering (inner fastest) that the
     loops below reproduce. */
  laxAssertNodeOrder(surfNodes, nodes_conf, nodes_vel),
  fact : laxFactorizeBasis(bP, surfCVars, cons(cv, varsV)),
  sizesNA : laxFactorSizes(fact, cv),
  tabP : sconcat("vst_", surfTabTag(cdim, vdim, basisFun, polyOrder, useHigherOrder), "_ph_x", dir-1),
  /* Surface modal basis and its consumer-projection table sizes (same
     factorization/dedup path as writeConsumerProjTables). */
  bSurfP : basisFromVars(vlasovBtype(basisFun, polyOrder), surfVars, polyOrder),
  NK : length(bSurfP),
  factP : laxFactorizeBasis(bSurfP, if length(surfCVars) = 0 then [prjdummy] else surfCVars, varsV),
  prjPre : sconcat("vst_", surfTabTag(cdim, vdim, basisFun, polyOrder, useHigherOrder), "_prj_x", dir-1),

  printf(fh, "#include <gkyl_flux_vlasov_kernels.h> ~%"),
  surfTabInclude(fh, cdim, vdim, basisFun, polyOrder),
  surfTabIncludeNod2Mod(fh, cdim, vdim, basisFun, polyOrder),

  /* Stage-1 producer (one call per (inner node, outer shape) item) and
     per-node function (one call per surface node). The stored f is
     J_pos-weighted with a cell-constant Jacobian that jumps across the
     interface, so each side is un-weighted by its OWN cell's Jacobian in the
     surface direction before the Lax combination (l = lower neighbor,
     c = current cell, which owns its lower-edge flux). */
  laxEmitStage1Fn(fh, funcNm, tabP, sizesNA[1], sizesNA[2], num_nodes_vel),
  laxEmitNodeFn(fh, funcNm, tabP, length(bP), sizesNA[1], sizesNA[2], num_nodes_vel,
    " const double *jacob_pos_l, const double *jacob_pos_r,", [], false,
    [printf(false, "  f_l_quad *= 1.0/jacob_pos_l[~a]; ", (polyOrder+1)*(dir-1)),
     printf(false, "  f_r_quad *= 1.0/jacob_pos_r[~a]; ", (polyOrder+1)*(dir-1))]),
  laxEmitPrjFn(fh, funcNm, prjPre, NK, length(factP[1]), length(factP[2]), num_nodes_conf, num_nodes_vel,
    (dir-1)*NK),

  /* CFL finalizer for the node-loop's alpha_max reduction: the physical cell
     width in the surface direction is J_pos*dx, so the rate carries the
     inverse position-map Jacobian of the smaller of the two cells sharing
     this interface (the most restrictive physical cell width). */
  cid : cidx(cdim),
  printf(fh, "GKYL_CU_DH double ~a_cfl(const double *dxv, const double *jacob_pos_l, const double *jacob_pos_r, double alpha_max) ~%{ ~%", funcNm),
  printf(fh, "  double dx1~a = 2.0/dxv[~a]; ~%", dir-1, cid[dir]),
  printf(fh, "  const double jacob_pos_min = fmin(jacob_pos_l[~a], jacob_pos_r[~a]); ~%", (polyOrder+1)*(dir-1), (polyOrder+1)*(dir-1)),
  printf(fh, "  return ~a*~a*alpha_max/jacob_pos_min;~%", float(0.5*(2*polyOrder+1)), dx1[dir]),
  printf(fh, "} ~%~%"),

  /* Wrapper with the original ABI (minus the retired dead lax scratch). */
  printf(fh, "GKYL_CU_DH double ~a(const double *dxv, const double *jacob_pos_l, const double *jacob_pos_r,
  const double *alpha_quad, const double *f_l, const double *f_r,
  double* GKYL_RESTRICT flux) ~%{ ~%", funcNm),
  laxEmitWrapperLoop(fh, funcNm, num_nodes_conf, num_nodes_vel, sizesNA[1], NK, " jacob_pos_l, jacob_pos_r,"),
  printf(fh, "  return ~a_cfl(dxv, jacob_pos_l, jacob_pos_r, alpha_max); ~%", funcNm),
  printf(fh, "} ~%")
)$