/* Boundary surface kernels of Maxwell's equations (perfectly hyperbolic form): the update of a
   cell on the edge of the domain in the direction of that edge, when the boundary condition is a
   flux through the boundary face rather than a ghost cell.

   The cell (the "skin" cell) has one interior face, shared with its interior neighbor (the "edge"
   cell in the naming of the boundary kernels), and one face on the boundary:
   - interior face: the numerical flux of the interior kernels, (F(Q_skin) + F(Q_edge))/2;
   - boundary face: the absorbing (outflow) flux, the part of F(Q_skin) carried by the waves that
     leave the domain, with nothing coming in. The flux Jacobian in a direction has four pairs of
     waves: the two transverse (E, B) pairs with speeds +-c, the pair (E_n, phi) with speeds
     +-c chi and the pair (B_n, psi) with speeds +-c gamma (chi and gamma as in the kernels, the
     cleaning speeds over c). Each pair is a 2x2 block with |A| = speed x identity, so
       A^+ Q = (F(Q) + D Q)/2 on an upper edge,  A^- Q = (F(Q) - D Q)/2 on a lower edge,
     with D the diagonal matrix of the speeds. */

load("core/modal-basis.mac");
load("util_maxima/out-scripts.mac");
load(stringproc)$
fpprec : 24$

/* For simpliciations */
let (c^2, c2);
let (c2*chi, c2chi);
let (c2*gamma, c2gamma);

cvars : [x, y, z]$
out : [outEx, outEy, outEz, outBx, outBy, outBz, outPh, outPs]$

/* flux of the perfectly hyperbolic Maxwell equations in each direction */
flux(Ex,Ey,Ez,Bx,By,Bz,phi,psi) := [
 [c^2*chi*phi, c^2*Bz, -c^2*By, gamma*psi, -Ez, Ey, chi*Ex, c^2*gamma*Bx],
 [-c^2*Bz, c^2*chi*phi, c^2*Bx, Ez, gamma*psi, -Ex, chi*Ey, c^2*gamma*By],
 [c^2*By, -c^2*Bx, c^2*chi*phi, -Ey, Ex, gamma*psi, chi*Ez, c^2*gamma*Bz]
]$

/* speeds of the waves each component belongs to, for a face normal to dir
   (cchi = c chi, cgamma = c gamma) */
maxwellWaveSpeeds(dir) := block([spd, d],
  spd : makelist(c, i, 1, 8),
  spd[dir] : cchi,       /* E_n pairs with phi */
  spd[3+dir] : cgamma,   /* B_n pairs with psi */
  spd[7] : cchi,
  spd[8] : cgamma,
  spd
)$

calcBoundaryUpdateInDir(dir, fh, funcNm, cdim, basisFun, polyOrder) := block(
  [varsC,bC,nbasis,cv,surfVars,clst,flds,qS,qE,spd,sg,cvInt,cvBnd,qSint,qEint,qSbnd,
   Gint,Gbnd,incrInt,incrBnd,incr_s,m,k],

  [varsC,bC] : loadBasis(basisFun, cdim, polyOrder),
  nbasis : length(bC),

  printf(fh, "GKYL_CU_DH double ~a~a_~ax_~a_p~a(const gkyl_maxwell_inp *meq, const double *w, const double *dx, const double *jacob_pos_edge, const double *jacob_pos_skin, const int edge, const double *qedge, const double *qskin, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cvars[dir], cdim, basisFun, polyOrder),
  printf(fh, "  // meq:            Speed of light and the cleaning speeds over it.~%"),
  printf(fh, "  // w[NDIM]:        Cell-center coordinates.~%"),
  printf(fh, "  // dx[NDIM]:       Cell spacing.~%"),
  printf(fh, "  // jacob_pos_edge: Position-map Jacobian of the interior neighbor of the boundary cell.~%"),
  printf(fh, "  // jacob_pos_skin: Position-map Jacobian of the boundary cell.~%"),
  printf(fh, "  // edge:           -1 on the lower edge of the domain, +1 on the upper edge.~%"),
  printf(fh, "  // qedge:          Field of the interior neighbor of the boundary cell.~%"),
  printf(fh, "  // qskin:          Field of the boundary cell.~%"),
  printf(fh, "  // out:            Incremented output of the boundary cell: the central flux on its~%"),
  printf(fh, "  //                 interior face and the outgoing waves only on the boundary face.~%"),
  printf(fh, "~%"),

  printf(fh, "  const double c = meq->c, chi = meq->chi, gamma = meq->gamma; ~%"),
  printf(fh, "  const double c2 = c*c; ~%"),
  printf(fh, "  const double c2chi = c2*chi, c2gamma = c2*gamma; ~%"),
  printf(fh, "  const double cchi = c*chi, cgamma = c*gamma; ~% ~%"),
  printf(fh, "  const double dx1 = 2.0/dx[~a]; ~%", dir-1),
  /* As in the interior kernels, the fluxes are built from the physical fields: each cell's stored
     J*field is divided by its own normal-direction Jacobian. */
  printf(fh, "  const double jacob_edge_inv = 1.0/jacob_pos_edge[~a]; ~%", (polyOrder+1)*(dir-1)),
  printf(fh, "  const double jacob_skin_inv = 1.0/jacob_pos_skin[~a]; ~% ~%", (polyOrder+1)*(dir-1)),

  flds : ["ex", "ey", "ez", "bx", "by", "bz", "ph", "ps"],
  for k : 1 thru 8 do printf(fh, "  const double *~a_edge = &qedge[~a]; ~%", flds[k], (k-1)*nbasis),
  printf(fh, "~%"),
  for k : 1 thru 8 do printf(fh, "  const double *~a_skin = &qskin[~a]; ~%", flds[k], (k-1)*nbasis),
  printf(fh, "~%"),
  for k : 1 thru 8 do printf(fh, "  double *~a = &out[~a]; ~%", out[k], (k-1)*nbasis),
  printf(fh, "~%"),
  printf(fh, "  double incr[~a]; ~% ~%", nbasis),

  qS : makelist(jacob_skin_inv*doExpand1(eval_string(sconcat(flds[k], "_skin")), bC), k, 1, 8),
  qE : makelist(jacob_edge_inv*doExpand1(eval_string(sconcat(flds[k], "_edge")), bC), k, 1, 8),

  cv : varsC[dir],
  surfVars : delete(cv,varsC),
  spd : maxwellWaveSpeeds(dir),
  clst : [c2, gamma, chi, c2gamma, c2chi, c, cchi, cgamma],

  /* sg = -1: lower edge of the domain (boundary face at cv = -1, interior face at cv = +1);
     sg = +1: upper edge (boundary face at cv = +1, interior face at cv = -1). */
  for sg in [-1, 1] do (
    if sg = -1 then printf(fh, "  if (edge == -1) { ~%~%") else printf(fh, "  } else { ~%~%"),
    cvBnd : sg, cvInt : -sg,
    qSint : subst(cv=cvInt, qS),
    qEint : subst(cv=-cvInt, qE),
    qSbnd : subst(cv=cvBnd, qS),
    /* interior face: (F(Q_skin) + F(Q_edge))/2; boundary face: (F(Q_skin) + sg D Q_skin)/2 */
    Gint : (1/2)*apply(flux, qSint + qEint)[dir],
    Gbnd : (1/2)*(apply(flux, qSbnd)[dir] + sg*spd*qSbnd),
    for m : 1 thru 8 do (
      /* a face at cv = -1 enters with +, a face at cv = +1 with - */
      incrInt : calcInnerProdList(surfVars, -cvInt, subst(cv=cvInt, bC), letsimp(Gint[m])),
      incrBnd : calcInnerProdList(surfVars, -cvBnd, subst(cv=cvBnd, bC), letsimp(Gbnd[m])),
      writeCExprsDoubleCollect1lhsc(incr, incrInt + incrBnd, clst),
      printf(fh, "~%"),
      incr_s : makelist(incr[i-1], i, 1, nbasis),
      writeCIncrExprsCollect1lhsc(out[m], dx1*incr_s),
      printf(fh, "~%")
    ),
    flush_output(fh)
  ),
  printf(fh, "  } ~%~%"),

  printf(fh, "  return 0.;~%"),  /* Return CFL frequency in volume kernel. */
  printf(fh, "~%"),

  printf(fh, "} ~%")
)$
