/* Functions which compute the components of the volume update of the Vlasov 
   equation using a discontinuous Galerkin (DG) method. Different 
   component include: 
   1. Streaming in configuration space via velocity-space derivatives of 
      the Hamiltonian, with either a velocity-space only Hamiltonian such as
      H = p^2/2m or H = mc^2*sqrt(1 + p^2), or a full phase-space Hamiltonian
      including geometric terms, H = g^ij p_i p_j/2m. 
   2. Forces in velocity space due to geometric terms in the Hamiltonian, -grad_x(H)
*/

load("modal-basis");
load("out-scripts");
load("utilities")$
load("nodal_operations/nodal_functions")$
load("new_vlasov/vlasov-basis");
load(stringproc)$
fpprec : 24$

clabels : ["x","y","z"]$
pt_conf_total : [1,6,18]$ 
dx1 : [dx10, dx11, dx12]$
dv1_inv : [dv10, dv11, dv12]$
vTrans  : [vx*dv0/2+wx1, vy*dv1/2+wx2, vz*dv2/2+wx3]$
/* Constant per-direction inverse mesh Jacobians of the C^0 linear maps:
   each derivative d/dz_i picks up the Jacobian of ITS OWN direction only. */
jacobCInv_sym : [jacob_cx_inv, jacob_cy_inv, jacob_cz_inv]$
jacobVInv_sym : [jacob_vx_inv, jacob_vy_inv, jacob_vz_inv]$
cidx(cdim) := makelist(i,i,0,cdim-1)$
vidx(cdim,vdim) := makelist(i,i,cdim,cdim+vdim-1)$
PB_vol(f,g,x,y) := diff(f,x)*diff(g,y) - diff(g,x)*diff(f,y)$


grab_dir_from_pt_index(vdim, pt_index) := block(
  [pairs, ijk],

  /* ijk correspond to: (row, column, j-index) of the poisson tensor*/

  if vdim = 1 then (
    /* 1D: Shape of conf_poisson_tensor non-zero elements.
    +----+----+
    | -- | 00 |
    +----+----+
    | -- | -- |
    +----+----+
    */
    pairs : [[1, 2, 0]]
  )
  else if vdim = 2 then (
    /* 2D: Shape of conf_poisson_tensor non-zero elements.
    +----+----+----+----+
    | -- | -- | 00 | 01 |
    +----+----+----+----+
    | -- | -- | 02 | 03 |
    +----+----+----+----+
    | -- | -- | -- |04+j|
    +----+----+----+----+
    | -- | -- | -- | -- |
    +----+----+----+----+
    */
    pairs : [[1,3,0],[1,4,0],
             [2,3,0],[2,4,0],
             [3,4,1],[3,4,2]]
  )
  else if vdim = 3 then (
    /* 3D: Shape of conf_poisson_tensor non-zero elements.
    +----+----+----+----+----+----+
    | -- | -- | -- | 00 | 01 | 02 |
    +----+----+----+----+----+----+
    | -- | -- | -- | 03 | 04 | 05 |
    +----+----+----+----+----+----+
    | -- | -- | -- | 06 | 07 | 08 |
    +----+----+----+----+----+----+
    | -- | -- | -- | -- |09+j|10+j|
    +----+----+----+----+----+----+
    | -- | -- | -- | -- | -- |11+j|
    +----+----+----+----+----+----+
    | -- | -- | -- | -- | -- | -- |
    +----+----+----+----+----+----+
    */
    pairs : [[1,4,0],[1,5,0],[1,6,0],
             [2,4,0],[2,5,0],[2,6,0],
             [3,4,0],[3,5,0],[3,6,0],
             [4,5,1],[4,6,1],[5,6,1],
             [4,5,2],[4,6,2],[5,6,2],
             [4,5,3],[4,6,3],[5,6,3]]
  ),

  ijk : pairs[pt_index],
  return(ijk)
)$


/* Hamiltonian volume contribution for Non-Canonical Brackets, either just streaming, 
   grad_x(w) . grad_v(H) f, if Hamiltonian only depends on velocity space, or, 
   grad_x(w) . grad_v(H) f - grad_v(w) . grad_x(H) f  */
calcHamilVolNonCanonical(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, vmap) := block(
  [varsC, bC, varsV, bV, varsP, bP, NP,
  cid, vid, pdim, NC,
  hamil, f_e, f_vol_e,
  poissonTensorConf, pt_conf_comp_total,
  varsPFull, pt_index, dir1, dir2, index_vsum, varsP1, varsP2,
  dz_val1, dz_val2, dvol, p_factor,
  pbBasis, pb, clst_vol,
  poissonTensorConf_local, i, dir],

  pdim : cdim + vdim,
  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  NC : length(bC), 
  NP : length(bP), 

  printf(fh, "#include <gkyl_vlasov_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(const double *w, const double *dxv, const double *vmap,
  const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f,
  const double *f_no_J, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  if (hamil_rep = "phase") then (
    hamil : doExpand1(hamil, bP)
  )
  else (
    /* Velocity-space Hamiltonian. The sparse (separable) representation keeps
       the dense storage layout but only references the constant and
       single-velocity-variable coefficients (cross terms are exactly zero). */
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  ),
  f_e : doExpand1(f, bP),

  /* Save enough distribution names for 3D */
  poissonTensorConf : [poisson_tensor_conf_0, poisson_tensor_conf_1, poisson_tensor_conf_2, 
    poisson_tensor_conf_3, poisson_tensor_conf_4, poisson_tensor_conf_5, poisson_tensor_conf_6,
    poisson_tensor_conf_7, poisson_tensor_conf_8, poisson_tensor_conf_9, poisson_tensor_conf_10,
    poisson_tensor_conf_11, poisson_tensor_conf_12, poisson_tensor_conf_13, poisson_tensor_conf_14,
    poisson_tensor_conf_15, poisson_tensor_conf_16, poisson_tensor_conf_17],

  pt_conf_comp_total : pt_conf_total[vdim],
  
  cid : cidx(cdim),
  vid : vidx(cdim,vdim), 
  for dir : 1 thru cdim do printf(fh, "  const double dx1~a = 2.0/dxv[~a]; ~%", dir-1, cid[dir]),
  for dir : 1 thru vdim do printf(fh, "  const double dv~a = dxv[~a]; ~%", dir-1, vid[dir]),
  for dir : 1 thru vdim do printf(fh, "  const double dv1~a = 2.0/dxv[~a]; ~%", dir-1, vid[dir]),
  /* Constant per-direction mesh Jacobians (C^0 linear maps): first entry of
     each direction's block. Each derivative folds in the inverse Jacobian of
     its own direction. */
  for dir : 1 thru cdim do (
    printf(fh, "  const double jacob_c~a_inv = 1.0/jacob_pos[~a]; ~%", clabels[dir], (polyOrder+1)*(dir-1))
  ),
  /* Velocity-map Jacobians. The f slot carries the full Jf; each velocity
     derivative d/dv_i folds in the inverse Jacobian of ITS OWN direction:
     - C^0 linear map (ser): J is a per-cell constant per direction (entry 0
       of the direction's block) -- scalar 1/J multiplication (original form).
     - C^1 cubic map (tensor): J is quadratic in-cell -- divide NODALLY per
       direction with a 1D transform (evaluate at the 1D Gauss-Legendre
       Jacobian nodes of that direction, divide, project back), exactly as
       the validated plain hamil vols do. A vel-vel bracket term applies two
       sequential 1D divides (one per derivative direction). */
  jacRep : vlasovVelMapRep(basisFun),
  if (jacRep = "cubic") then (
    [bV_vi, NV_1D, jacobNodes, numJacobNodes, jacobNodes_vi, basisNodal_vi] : loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)),
    for dir : 1 thru vdim do (
      printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[dir], numJacobNodes*(dir-1))
    ),
    clst_J : append(makelist(arraymake(jacob_vx,[i-1]), i, 1, numJacobNodes),
                    makelist(arraymake(jacob_vy,[i-1]), i, 1, numJacobNodes),
                    makelist(arraymake(jacob_vz,[i-1]), i, 1, numJacobNodes)),
    /* Emit the single-direction divided distributions f_dJv<d> once each;
       vel-vel pairs reuse them with one extra 1D divide. */
    fDiv1_e : makelist(0, k, 1, vdim),
    for d : 1 thru vdim do block([fl_v, fl_ne, f_c, symNm],
      symNm : eval_string(sconcat("f_dJv", d-1)),
      printf(fh, "  double f_dJv~a[~a] = {0.0}; ~%", d-1, NP),
      fl_v : evAtNodes(f_e, jacobNodes, [varsV[d]]),
      fl_ne : sum(fl_v[i]/jacobNodes_vi[d][i]*basisNodal_vi[d][i], i, 1, numJacobNodes),
      f_c : calcInnerProdList(varsP, 1, bP, fl_ne),
      writeCExprsCollect1(symNm, f_c, clst_J),
      printf(fh, "~%"),
      fDiv1_e[d] : doExpand1(symNm, bP)
    ),
    /* Pair-divided distributions for the vel-vel block, from the singles. */
    fDiv2_e : makelist(makelist(0, k2, 1, vdim), k1, 1, vdim),
    if (vdim > 1) then (
      for d1 : 1 thru vdim do (
        for d2 : d1+1 thru vdim do block([fl_v, fl_ne, f_c, symNm],
          symNm : eval_string(sconcat("f_dJv", d1-1, "v", d2-1)),
          printf(fh, "  double f_dJv~av~a[~a] = {0.0}; ~%", d1-1, d2-1, NP),
          fl_v : evAtNodes(fDiv1_e[d1], jacobNodes, [varsV[d2]]),
          fl_ne : sum(fl_v[i]/jacobNodes_vi[d2][i]*basisNodal_vi[d2][i], i, 1, numJacobNodes),
          f_c : calcInnerProdList(varsP, 1, bP, fl_ne),
          writeCExprsCollect1(symNm, f_c, clst_J),
          printf(fh, "~%"),
          fDiv2_e[d1][d2] : doExpand1(symNm, bP)
        )
      )
    )
  ) else (
    for dir : 1 thru vdim do (
      printf(fh, "  const double jacob_v~a_inv = 1.0/jacob_vel[~a]; ~%", clabels[dir], (polyOrder+1)*(dir-1))
    )
  ),
  /* Physical transverse velocity from the C^0 linear velocity map (slots
     [0],[1] of each direction's 4-slot block); only the (vel,vel) Poisson
     tensor block (vdim > 1) carries the momentum factor. */
  if (vdim > 1) then (
    for dir : 1 thru vdim do (
      printf(fh, "  const double *vmap_v~a = &vmap[~a]; ~%", clabels[dir], 4*(dir-1))
    )
  ),

  /* Create a projection of the momentum */
  for i : 1 thru vdim do (
    printf(fh, "  const double wx~a = w[~a]; ~%", i, cdim+i-1),
    printf(fh, "  const double dv1~a_sq = dv1~a*dv1~a; ~%",  i-1, i-1, i-1)
  ),
  loadVelLinearMapBasis(),
  if (jacRep = "cubic") then (
    /* C^1 cubic velocity map: vmap holds a genuine 1D p=3 tensor modal
       expansion per direction (4 slots). The physical transverse velocity in
       the vel-vel Poisson-tensor momentum factor must use the FULL cubic
       expansion (the linear slots alone misrepresent the map in-cell). */
    [varsV_p3map, bV_p3map] : loadBasis("Tensor", 1, 3),
    bV_map_vi : [subst(x=vx, copylist(bV_p3map)), subst(x=vy, copylist(bV_p3map)), subst(x=vz, copylist(bV_p3map))]
  ) else (
    bV_map_vi : bV_lin_vi
  ),
  vmapTrans : [doExpand1(vmap_vx, bV_map_vi[1]), doExpand1(vmap_vy, bV_map_vi[2]), doExpand1(vmap_vz, bV_map_vi[3])],


  /* for a 2*vdim space varsPFull */
  if (vdim = 3) then (
    varsPFull : [x, y, z, vx, vy, vz]
  )
  else if (vdim = 2) then (
    varsPFull : [x, y, vx, vy]
  )
  else if (vdim = 1) then (
    varsPFull : [x, vx]
  ),

  /* The Poisson Tensor is sparse and antisymmetric, which is exploited here by only
    indexing over unique and non-zero elements */
  /* If the system is independant of a spatial coordinate, this code skips those contributions
    which are zero */
  /* Assumed a 2*vdim Poisson tensor size. */
  /* cdim is only used to determind coordinate independance. */
  printf(fh, "  ~%"),
  f_vol_e : f_e, 
  for pt_index : 1 thru pt_conf_comp_total do (
    [dir1, dir2, index_vsum] : grab_dir_from_pt_index(vdim, pt_index),
    varsP1 : varsPFull[dir1], varsP2 : varsPFull[dir2],

    poissonTensorConf_local : doExpand1(poissonTensorConf[pt_index],bC),

    /* Exclude making variables for when cdim < vdim */
    if not((( dir1 <= vdim ) and ( dir1 > cdim )) or (( dir2 <= vdim ) and ( dir2 > cdim ))) then (
      printf(fh, "  const double *poisson_tensor_conf_~a = &poisson_tensor_conf[~a]; ~%", pt_index - 1, NC*(pt_index-1)),

      /* Derivative factors: each d/dz_i carries 2/dz and (conf) the constant
         inverse position-map Jacobian. Velocity Jacobians: ser folds the
         own-direction scalar inverse per derivative; tensor selects the
         appropriately nodally-divided distribution instead. */
      if (dir1 <= vdim ) then dz_val1 : dx1[dir1]*jacobCInv_sym[dir1] else dz_val1 : dv1_inv[dir1-vdim],
      if (dir2 <= vdim ) then dz_val2 : dx1[dir2]*jacobCInv_sym[dir2] else dz_val2 : dv1_inv[dir2-vdim],
      if (jacRep = "cubic") then (
        if (dir1 > vdim and dir2 > vdim) then f_vol_e : fDiv2_e[dir1-vdim][dir2-vdim]
        else if (dir2 > vdim) then f_vol_e : fDiv1_e[dir2-vdim]
        else f_vol_e : f_e
      ) else (
        f_vol_e : f_e,
        if (dir1 > vdim) then dz_val1 : dz_val1*jacobVInv_sym[dir1-vdim],
        if (dir2 > vdim) then dz_val2 : dz_val2*jacobVInv_sym[dir2-vdim]
      ),
      dvol : dz_val1*dz_val2,
      /* For cdim /= vdim, we assume the ignorable coordinates are the last pairs.
        For instance if we have varsC = [x,y,z] with:
        - 1 ignorable coordinate: [x, y, \dot{x}, \dot{y}] are all that show up in {f,H} 
        - 2 ignorable coordinates: [x, \dot{x},] are all that show up in {f,H} 
        It is assumed that H does not depend on these ignorable coordinates. */

      /* Convert to a phase space PT by mulitplying by p for the bottom right block comps */
      if ( (dir1 > vdim) and (dir2 > vdim) ) then p_factor : vmapTrans[index_vsum] else p_factor : 1,
      pbBasis : dvol*(PB_vol(bP,hamil,varsP1,varsP2))*poissonTensorConf_local*p_factor,
      pb : fullratsimp(calcInnerProdList(varsP, 1, pbBasis, f_vol_e)), 
      /* Volume factor for intergation */
      clst_vol : [dx10, dx11, dx12, dv10, dv11, dv12,
        jacob_cx_inv, jacob_cy_inv, jacob_cz_inv, jacob_vx_inv, jacob_vy_inv, jacob_vz_inv],
      /* Replace dv*dv with dv_sq */
      pb : subst([dv10*dv10 = dv10_sq, dv11*dv11 = dv11_sq, dv12*dv12 = dv12_sq], pb),
      pb : subst([dv10^2 = dv10_sq, dv11^2 = dv11_sq, dv12^2 = dv12_sq], pb),
      writeCIncrExprsCollect1(out, pb, clst_vol), 
      printf(fh, "~%") 
    )
  ),

  printf(fh, "} ~%")
)$  


/* Hamiltonian volume contribution for Non-Canonical Brackets, either just streaming, 
   grad_x(w) . grad_v(H) f, if Hamiltonian only depends on velocity space, or, 
   grad_x(w) . grad_v(H) f - grad_v(w) . grad_x(H) f  */
/* Precomputed-alpha volume update: projects alpha = P . grad(H) onto the
   dense phase basis, then accumulates the bracket via the hamil_gen vol
   component kernels (Hamiltonian-agnostic once alpha is modal). Used by the
   vel_dense and phase flavors only; the sparse (separable) Hamiltonian
   always takes the inline exact-bracket path (calcHamilVolNonCanonical). */
calcHamilVolNonCanonicalAlphaPreComp(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamilLabel, vmap) := block(
  [varsC, bC, varsV, bV, varsP, bP, NP,
  cid, vid, pdim, NC,
  funcNameDot, funcNameZero, funcNameComputePiDh, funcNameBracket,
  dir, component],

  pdim : cdim + vdim,
  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  NC : length(bC), 
  NP : length(bP), 

  printf(fh, "#include <gkyl_nc_hamil_gen_vol_comps_kernels.h> ~%"),
  printf(fh, "#include <gkyl_vlasov_kernels.h> ~%"),

  funcNameDot : sconcat("dot_pb_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
  /* GKYL_NOINLINE: these helpers are called NP x (partner classes) times per
     direction; inlined into the wrapper they blow up the loop vectorizer's
     compile time (1108 s vs 4 s at -O3 for the 2x3v tensor wrapper). */
  printf(fh, "GKYL_CU_DH GKYL_NOINLINE static void ~a(const double *list_1, const double *list_2, double* GKYL_RESTRICT out) ~%{ ~%", funcNameDot),

  printf(fh, "  for (int i = 0; i<~a; ++i) out[0] += list_1[i]*list_2[i]; ~%",NP),
  printf(fh, "} ~%"),
  printf(fh, "  ~%"),


  funcNameZero : sconcat("zero_pb_list"),
  printf(fh, "GKYL_CU_DH GKYL_NOINLINE static void ~a(double *pb_list) ~%{ ~%", funcNameZero),

  /* Zero out the pb_list */
  printf(fh, "  for (int i = 0; i<~a; ++i) pb_list[i] = 0.0; ~%",NP),
  printf(fh, "} ~%"),
  printf(fh, "  ~%"),


  printf(fh, "GKYL_CU_DH void ~a(const double *w, const double *dxv, const double *vmap,
  const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f,
  const double *f_no_J, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
 
  funcNameComputePiDh : sconcat("vlasov_nc_hamil_", hamilLabel, "_vol_alpha_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),

  if (vlasovVelMapRep(bName[bInd]) = "linear") then (
    /* ---- C^0 linear map (ser): original single-block flow, contraction
       with f (constant Jacobians ride inside alpha/comps). ---- */
    printf(fh, "  double alphai[~a] = {0.0}; ~%", length(bP)),
    printf(fh, "  double bracket_w_Hi[~a] = {0.0}; ~%", length(bP)),
    printf(fh, "  for (int dir = 0; dir<~a; ++dir) { ~%",pdim),
    printf(fh, "    // Compute the per-direction charateristic ~%"),
    printf(fh, "    ~a(alphai); ~%", funcNameZero),
    printf(fh, "    ~a(w, dxv, dir, vmap, jacob_pos, jacob_vel, poisson_tensor_conf, hamil, alphai); ~%", funcNameComputePiDh),
    printf(fh, "    ~%"),
    printf(fh, "    // Compute the modal basis backet coeffcients, accumulate the outputs ~%"),
    for component : 1 thru NP do (
      printf(fh, "    ~a(bracket_w_Hi); ~%", funcNameZero),
      funcNameBracket : sconcat("vlasov_nc_hamil_gen_vol_comp", (component -1),"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
      printf(fh, "    ~a(w, dxv, dir, jacob_pos, jacob_vel, alphai, bracket_w_Hi); ~%", funcNameBracket),
      printf(fh, "    ~a(f, bracket_w_Hi, &out[~a]); ~%", funcNameDot, component-1),
      flush_output(fh)
    ),
    printf(fh, "    ~%"),
    printf(fh, "  } ~%")
  ) else (
    /* ---- C^1 cubic map (tensor): division-free exact-conservation flow.
       The alpha kernel is J-FREE and writes PER-PARTNER blocks; every
       velocity-Jacobian factor is applied here as a MODAL TEMPORARY built
       from f_no_J by 1D nodal multiplication (the magnetic-force J*f
       reconstruction pattern), and each block's bracket is contracted with
       the f-object of its (dir, partner) pair. Both pieces of every
       antisymmetric pair dot the SAME object, and the alpha kernel builds
       both blocks of a pair from ONE projected momentum factor (see the
       antisymmetry note in triadVolHelperFuncs.mac) => H conserved exactly. ---- */
    block([f_e, fl, fmul_ne, f_c, fJ_e, clst_J, fS_nm, i1, k1],
      [bV_vi, NV_1D, jacobNodes, numJacobNodes, jacobNodes_vi, basisNodal_vi] : loadVelJacobianBasis(vlasovPVel(bName[bInd], polyOrder)),
      for d : 1 thru vdim do printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[d], numJacobNodes*(d-1)),
      clst_J : append(makelist(arraymake(jacob_vx,[i-1]), i, 1, numJacobNodes),
                      makelist(arraymake(jacob_vy,[i-1]), i, 1, numJacobNodes),
                      makelist(arraymake(jacob_vz,[i-1]), i, 1, numJacobNodes)),
      f_e : doExpand1(f_no_J, bP),
      /* Singles: f_Jv<k> = Proj[J_k * f_no_J]. */
      fJ_e : makelist(0, k, 1, vdim),
      for k : 1 thru vdim do (
        printf(fh, "  double f_Jv~a[~a] = {0.0}; ~%", k-1, NP),
        fl : evAtNodes(f_e, jacobNodes, [varsV[k]]),
        fmul_ne : sum(fl[i]*jacobNodes_vi[k][i]*basisNodal_vi[k][i], i, 1, numJacobNodes),
        f_c : calcInnerProdList(varsP, 1, bP, fmul_ne),
        writeCExprsCollect1(eval_string(sconcat("f_Jv", k-1)), f_c, clst_J),
        printf(fh, "~%"),
        fJ_e[k] : doExpand1(eval_string(sconcat("f_Jv", k-1)), bP)
      ),
      /* Conf-partner complements: f_Sv<j> = Proj[prod_{k#j} J_k * f_no_J]
         (a second 1D multiply on a single; vdim=2 reuses the other single;
         vdim=1 is f_no_J itself). */
      fS_nm : makelist("", j, 1, vdim),
      if (vdim = 1) then fS_nm[1] : "f_no_J"
      else if (vdim = 2) then (fS_nm[1] : "f_Jv1", fS_nm[2] : "f_Jv0")
      else (
        for j : 1 thru vdim do block([othr],
          othr : delete(j, [1,2,3]),
          i1 : othr[1], k1 : othr[2],
          printf(fh, "  double f_Sv~a[~a] = {0.0}; ~%", j-1, NP),
          fl : evAtNodes(fJ_e[i1], jacobNodes, [varsV[k1]]),
          fmul_ne : sum(fl[i]*jacobNodes_vi[k1][i]*basisNodal_vi[k1][i], i, 1, numJacobNodes),
          f_c : calcInnerProdList(varsP, 1, bP, fmul_ne),
          writeCExprsCollect1(eval_string(sconcat("f_Sv", j-1)), f_c, clst_J),
          printf(fh, "~%"),
          fS_nm[j] : sconcat("f_Sv", j-1)
        )
      ),
      printf(fh, "  double alphai[~a] = {0.0}; ~%", pdim*NP),
      printf(fh, "  double bracket_w_Hi[~a] = {0.0}; ~%", NP),
      /* Per-direction unrolled: each direction owns its partner classes. */
      for dird : 0 thru pdim-1 do block([classes, cls, i0, obj],
        classes : [],
        if (dird < cdim) then (
          /* conf dir: partners are all velocity directions. */
          for j : 1 thru vdim do classes : endcons([cdim + j - 1, fS_nm[j]], classes)
        ) else (
          /* vel dir v_i: partners are the OTHER velocity directions, plus --
             for a PHASE-space Hamiltonian (dH/dx != 0) -- every conf
             direction: the antisymmetric piece of the (x_j, v_i) pair has
             one velocity derivative (dir i), so it dots the same complement
             object f_Sv<i> as its symmetric partner at dir x_j (exact
             cancellation under the H-contraction). The conf blocks vanish
             identically for velocity-space Hamiltonians and are skipped. */
          i0 : dird - cdim + 1,
          if (hamilLabel = "phase") then (
            for j : 1 thru cdim do classes : endcons([j - 1, fS_nm[i0]], classes)
          ),
          for j : 1 thru vdim do (
            if (j # i0) then (
              if (vdim = 2) then obj : "f_no_J"
              else obj : sconcat("f_Jv", first(delete(j, delete(i0, [1,2,3]))) - 1),
              classes : endcons([cdim + j - 1, obj], classes)
            )
          )
        ),
        if (length(classes) > 0) then (
          printf(fh, "  { ~%"),
          printf(fh, "    const int dir = ~a; ~%", dird),
          printf(fh, "    for (int i = 0; i<~a; ++i) alphai[i] = 0.0; ~%", pdim*NP),
          printf(fh, "    ~a(w, dxv, dir, vmap, jacob_pos, jacob_vel, poisson_tensor_conf, hamil, alphai); ~%", funcNameComputePiDh),
          for component : 1 thru NP do (
            funcNameBracket : sconcat("vlasov_nc_hamil_gen_vol_comp", (component -1),"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
            for cls in classes do (
              printf(fh, "    ~a(bracket_w_Hi); ~%", funcNameZero),
              printf(fh, "    ~a(w, dxv, dir, jacob_pos, jacob_vel, &alphai[~a], bracket_w_Hi); ~%", funcNameBracket, cls[1]*NP),
              printf(fh, "    ~a(~a, bracket_w_Hi, &out[~a]); ~%", funcNameDot, cls[2], component-1)
            ),
            flush_output(fh)
          ),
          printf(fh, "  } ~%")
        )
      )
    )
  ),
  printf(fh, "} ~%") 
)$  