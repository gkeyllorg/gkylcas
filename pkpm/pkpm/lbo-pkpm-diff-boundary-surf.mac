/* This script generates the kernels for the boundary surface term
   diffusion contribution from Lenard Bernstein operator. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac");
load("core/recovery.mac")$
load("util_maxima/utilities.mac")$
load(stringproc)$
load("pkpm/pkpm/lbo-pkpm-blocks.mac")$
fpprec : 24$

calcVlasovPKPMLBODiffBoundarySurfUpdater(fh, funcNm, cdim, vdim, basisFun, polyOrder) := block(
  [varsC,bC,varsP,bP,NP,NC,pDim,vid1,vv,surfVars,basis_v,fEdge_e,fSkin_e,bType,
   hl_e,hr_e,hOrder,hsol_l,hsol_r,nuVtSqSum_e,bSurf,facDiff_c,expr,i,facDiff_NoZero,
   facDiff_NoZero_e,vol_incr_e,Gdiff_l_c,Gdiff_r_c,Gdiff_l_e,Gdiff_r_e,Gdiff2_l_c,Gdiff2_r_c,
   Gdiff2_l_e,Gdiff2_r_e,temp_diff_le,temp_diff_re,temp_edge_le,temp_edge_re,diff_incr_le,
   diff_incr_re,edge_incr_le,edge_incr_re,vol_out,diff_out,edge_out],

  /* Load basis of dimensionality requested. */
  [varsC,bC,varsP,bP] : loadPhaseBasis(if polyOrder=1 then "hyb" else basisFun, cdim, vdim, polyOrder),

  /* Number of basis monomials. */
  NP : length(bP),  NC : length(bC),

  pDim : cdim+vdim,
  /* Variables. */
  surfVars : delete(vx,varsP),

  basis_v : diff(bP,vx),

  /* The same diffusion acts on every block (F_0, G_1, M0_perp, N_perp). */
  blk : pkpmLBOBlocks,
  nb : length(blk),
  bsym(k, sfx) := parse_string(sconcat(blk[k], sfx)),
  Skin_e : makelist(doExpand1(bsym(k, "Skin"), bP), k, 1, nb),
  /* Construct the recovery polynomial */
  if polyOrder=1 then /* Force p=1 to mean hybrid. */
    bType : "hyb"
  else
    bType : basisFun,
  coefs(k, sfx) := dg(makelist(arraymake(bsym(k, sfx), [i-1]),i,1,NP)),
  h_l_e : makelist(calcRecov2CellGen(bType,vx,varsP,polyOrder,coefs(k, "Edge"), coefs(k, "Skin")), k, 1, nb),
  h_r_e : makelist(calcRecov2CellGen(bType,vx,varsP,polyOrder,coefs(k, "Skin"), coefs(k, "Edge")), k, 1, nb),
  hOrder : 2*polyOrder+1,
  hsol(h) := cons(subst(vx=0,h),makelist(subst(vx=0,diff(h,vx,ord)/(ord!)),ord,1,hOrder)),
  hsol_l : makelist(hsol(h_l_e[k]), k, 1, nb),
  hsol_r : makelist(hsol(h_r_e[k]), k, 1, nb),
  /*............. RECOVERY DONE ..............................*/

  printf(fh, "#include <gkyl_lbo_pkpm_kernels.h> ~%"),        
  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv, const double *nuSum, const double *nuPrimMomsSum, const int edge, const double *fSkin, const double *fEdge, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:       Cell-center coordinates. ~%"),
  printf(fh, "  // dxv[NDIM]:     Cell spacing. ~%"),
  printf(fh, "  // nuSum:         Collisionalities added (self and cross species collisionalities). ~%"),
  printf(fh, "  // nuPrimMomsSum: Sum of bulk velocities and thermal speeds (squared) times their respective collisionalities. ~%"),
  printf(fh, "  // fSkin/fEdge:   Input distribution functions [F_0, T_perp G = T_perp (F_1 - F_0), M0_perp, N_perp] in skin cell/last edge cell. ~%"),
  printf(fh, "  // out:           Incremented distribution functions in skin cell. ~%"),
  printf(fh, "  double rdvSq4 = 4.0/(dxv[~a]*dxv[~a]); ~%", cdim, cdim),
  /* Create a pointer to nuVtSqSum. */
  printf(fh, "  const double *nuVtSqSum = &nuPrimMomsSum[~a];~%", vdim*NC),
  printf(fh, "~%"),
  
  for k : 1 thru nb do (
    printf(fh, "  const double *~aSkin = &fSkin[~a]; ~%", blk[k], (k-1)*NP),
    printf(fh, "  const double *~aEdge = &fEdge[~a]; ~%", blk[k], (k-1)*NP)
  ),
  for k : 1 thru nb do
    printf(fh, "  double *out_~a = &out[~a]; ~%", blk[k], (k-1)*NP),
  printf(fh, "~%"),
  /* First compute the contribution coming from the second
     differentiation by parts to left and right cells. */
  nuVtSqSum_e : doExpand1(nuVtSqSum,bC),
  if polyOrder=1 then (  /* Force p=1 to use hybrid basis. */
    bSurf : basisFromVars("hyb",surfVars,polyOrder)
  ) else (
    bSurf : basisFromVars(basisFun,surfVars,polyOrder)
  ),

  /* Volume increment from configuration space. */
  for k : 1 thru nb do (
    printf(fh, "  double vol_incr_~a[~a] = {0.0}; ~%", blk[k], NP),
    writeCExprs1(parse_string(sconcat("vol_incr_", blk[k])),
      rdvSq4*calcInnerProdList(varsP, 1, diff(bP,vx,2), nuVtSqSum_e*Skin_e[k]))
  ),
  printf(fh, "~%"),

  Gd(hs, i) := doExpand(calcInnerProdList(surfVars,1,bSurf,hs[i]), bSurf),
  Gdiff_l_e : makelist(Gd(hsol_l[k], 2), k, 1, nb),
  Gdiff_r_e : makelist(Gd(hsol_r[k], 2), k, 1, nb),
  Gdiff2_l_e : makelist(Gd(hsol_l[k], 1), k, 1, nb),
  Gdiff2_r_e : makelist(Gd(hsol_r[k], 1), k, 1, nb),

  if (polyOrder=1 or sdowncase(basisFun)="tensor") then (
    /* This simplification of separating vth^2 from the recovered distribution function
       only works for p=1 because it is a tensor product of
       conf and velocity space (remains to be checked for tensor basis). */
    temp_diff_le : makelist(fullratsimp(calcInnerProdList(surfVars, -1, subst(vx=-1, bP), Gdiff_l_e[k])
                              -calcInnerProdList(surfVars, -1, subst(vx=-1, basis_v), Gdiff2_l_e[k])), k, 1, nb),
    temp_diff_re : makelist(fullratsimp(calcInnerProdList(surfVars, 1, subst(vx=1, bP), Gdiff_r_e[k])
                              -calcInnerProdList(surfVars, 1, subst(vx=1, basis_v), Gdiff2_r_e[k])), k, 1, nb),
    temp_edge_le : makelist(-calcInnerProdList(surfVars, -1, subst(vx=-1, basis_v), subst(vx=-1, Skin_e[k])), k, 1, nb),
    temp_edge_re : makelist(-calcInnerProdList(surfVars, 1, subst(vx=1, basis_v), subst(vx=1, Skin_e[k])), k, 1, nb),
    incr_diff : makelist(calcInnerProdList(varsP, nuVtSqSum_e, bP, doExpand1(bsym(k, "_temp_diff"), bP)), k, 1, nb),
    incr_edge : makelist(calcInnerProdList(varsP, nuVtSqSum_e, bP, doExpand1(bsym(k, "_temp_edge"), bP)), k, 1, nb),

    for k : 1 thru nb do (
      printf(fh, "  double ~a_temp_diff[~a] = {0.0}; ~%", blk[k], NP),
      printf(fh, "  double ~a_temp_edge[~a] = {0.0}; ~%", blk[k], NP),
      printf(fh, "  double ~a_diff_incr[~a] = {0.0}; ~%", blk[k], NP),
      printf(fh, "  double ~a_edge_incr[~a] = {0.0}; ~%", blk[k], NP)
    ),
    printf(fh, "~%"),

    /* edge == -1: left edge boundary, the skin cell evaluated at +1; otherwise the right edge
       boundary, the skin cell evaluated at -1. */
    for side : 1 thru 2 do (
      if side = 1 then printf(fh, "  if (edge == -1) { ~%~%") else printf(fh, "~%  } else { ~%~%"),
      for k : 1 thru nb do (
        writeCExprs1(bsym(k, "_temp_diff"), if side = 1 then temp_diff_re[k] else temp_diff_le[k]),
        writeCExprs1(bsym(k, "_temp_edge"), if side = 1 then temp_edge_le[k] else temp_edge_re[k]),
        writeCExprs1(bsym(k, "_diff_incr"), incr_diff[k]),
        writeCExprs1(bsym(k, "_edge_incr"), incr_edge[k]),
        printf(fh, "~%")
      )
    ),
    printf(fh, "  } ~%"),
    printf(fh, "~%")

  ) else (
    for k : 1 thru nb do (
      printf(fh, "  double ~a_diff_incr[~a] = {0.0}; ~%", blk[k], NP),
      printf(fh, "  double ~a_edge_incr[~a] = {0.0}; ~%", blk[k], NP)
    ),
    printf(fh, "~%"),
    for side : 1 thru 2 do (
      if side = 1 then printf(fh, "  if (edge == -1) { ~%~%") else printf(fh, "~%  } else { ~%~%"),
      for k : 1 thru nb do (
        if side = 1 then (
          writeCExprs1(bsym(k, "_diff_incr"), fullratsimp(calcInnerProdList(surfVars, nuVtSqSum_e, subst(vx=1, bP), Gdiff_r_e[k])
                                   -calcInnerProdList(surfVars, nuVtSqSum_e, subst(vx=1, basis_v), Gdiff2_r_e[k]))),
          writeCExprs1(bsym(k, "_edge_incr"), -calcInnerProdList(surfVars, -nuVtSqSum_e, subst(vx=-1, basis_v), subst(vx=-1, Skin_e[k])))
        ) else (
          writeCExprs1(bsym(k, "_diff_incr"), fullratsimp(calcInnerProdList(surfVars, -nuVtSqSum_e, subst(vx=-1, bP), Gdiff_l_e[k])
                                   -calcInnerProdList(surfVars, -nuVtSqSum_e, subst(vx=-1, basis_v), Gdiff2_l_e[k]))),
          writeCExprs1(bsym(k, "_edge_incr"), -calcInnerProdList(surfVars, nuVtSqSum_e, subst(vx=1, basis_v), subst(vx=1, Skin_e[k])))
        ),
        printf(fh, "~%")
      )
    ),
    printf(fh, "  } ~%"),
    printf(fh, "~%")
  ),

  for k : 1 thru nb do (
    vol_out : makelist(arraymake(parse_string(sconcat("vol_incr_", blk[k])), [i-1]),i,1,NP),
    diff_out : makelist(arraymake(bsym(k, "_diff_incr"), [i-1]),i,1,NP),
    edge_out : makelist(arraymake(bsym(k, "_edge_incr"), [i-1]),i,1,NP),
    writeCIncrExprs1(parse_string(sconcat("out_", blk[k])), rdvSq4*(diff_out + edge_out) + vol_out)
  ),
  printf(fh, "~%"),

  printf(fh, "  return 0.;~%"),  /* Return CFL frequency from volume kernel. */
  printf(fh, "~%"),

  printf(fh, "} ~%")
);
