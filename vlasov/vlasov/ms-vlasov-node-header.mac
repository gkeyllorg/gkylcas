/* Generate gkyl_vlasov_surf_node_kernels.h: declarations of the per-node
   (Design A) companion functions of the from-flux producers and Lax kernels,
   plus the Lax CFL finalizers. The per-node dispatch in the vel/conf flux
   updaters composes these directly (one register alpha per node); combo
   coverage mirrors ms-vlasovVelFluxSurf.mac / ms-triadConfFluxSurf.mac.

   PAIRING CONSTRAINT: each declaration here has a whole-array wrapper twin
   (declared in gkyl_vlasov_kernels.h) living in the SAME generated .c file;
   the priv-header dispatch tables reference both symbol sets (`_arr` ->
   wrappers on CPU, `_node` -> node functions for the GPU launcher), so both
   forms must exist for every combo declared here or the link fails. Keep
   this script's gates in lockstep with the kernel drivers it mirrors. */
load(stringproc)$

clabels : ["x","y","z"]$
vlabels : ["vx","vy","vz"]$

fh : openw("~/max-out/gkyl_vlasov_surf_node_kernels.h")$
printf(fh, "#pragma once ~%")$
printf(fh, "// Sum-factorized surface kernel API. A cell's surface update runs as stages, ~%")$
printf(fh, "// each called once per node thread of the cell (the CUDA launcher gives one ~%")$
printf(fh, "// thread per surface node; the CPU dispatch loops over them): ~%")$
printf(fh, "//   _shared(tid, off, ...)  force producer: node thread tid fills row tid of its ~%")$
printf(fh, "//       outer factors O[(off+t)*NO + i] (if tid < NO) and of its inner factors ~%")$
printf(fh, "//       I[(off+t)*NI + j] (if tid < NI) for its terms t, starting at term off; ~%")$
printf(fh, "//       returns the term count (O == NULL: size query only). The dispatch chains ~%")$
printf(fh, "//       the producers and forms alpha(i, j) = sum_t O*I over all terms. ~%")$
printf(fh, "//   _g(tid, ...)            stage 1 of the nodal f evaluation: node thread tid does ~%")$
printf(fh, "//       one (outer shape a, inner node j) pair, fills G_l/G_r[j][a]; tid >= NA*NI: no-op. ~%")$
printf(fh, "//   _node(i, j, ...)        the node's Lax flux from alpha (by value) and the filled ~%")$
printf(fh, "//       G, into the nodal buffer; returns |alpha| for the CFL reduction (_cfl). ~%")$
printf(fh, "//   _prj(tid, ...)          projection of the nodal buffer onto the surface modal ~%")$
printf(fh, "//       basis: node thread tid does inner surface mode tid (the inner-node ~%")$
printf(fh, "//       contraction once, then every surface mode sharing it); beyond the count: no-op. ~%")$
printf(fh, "// tid is the thread's index among the cell's node threads, NOT its node: that ~%")$
printf(fh, "// keeps each stage's work in the fewest warps. Only _node is indexed by the ~%")$
printf(fh, "// node (i, j). ~%")$
printf(fh, "#include <math.h> ~%")$
printf(fh, "#include <gkyl_util.h> ~%")$
printf(fh, "EXTERN_C_BEG ~%")$
printf(fh, "~%")$
deco : "GKYL_CU_DH "$

/* Velocity-direction surfaces (mirror ms-vlasovVelFluxSurf.mac gates). */
bName : ["ser","tensor"]$
for bInd : 1 thru 2 do (
  for c : 1 thru 3 do (
    minVdimB : max(c,1), if (c = 2) then minVdimB : 1,
    for v : minVdimB thru 3 do (
      minPolyOrderB : 1, /* tensor p=1 = hybrid */
      maxPolyOrderB : 2,
      if (v=1) then maxPolyOrderB : 3,
      if (c+v>5 and maxPolyOrderB > 1) then maxPolyOrderB : 1,
      /* 2x3v tensor p=2 is generated for the velocity-space Hamiltonian
         (hamil_vel_dense/sparse) Vlasov path only; gkeyll builds it as an
         optional kernel set. hamil_phase and triad pieces stay p=1 at c+v>=5
         through their own gates. */
      for pi : minPolyOrderB thru maxPolyOrderB do (
        for hoInd : 1 thru 2 do (
          useHigherOrder : is(hoInd = 2),
          si : if useHigherOrder then "ho_" else "",
          if (not((bName[bInd] = "ser") and (pi = 1) and useHigherOrder) and not((not useHigherOrder) and (bName[bInd] = "tensor") and (pi > 1))) then (
            if (((bName[bInd] = "ser") and (pi = 1) and (not useHigherOrder)) or (useHigherOrder and (bName[bInd] = "tensor") and (pi > 1))) then si : "",
            maxC : c, if (v < c) then maxC : v,
            for dir : 1 thru maxC do (
              printf(fh, "~aint phi_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *jacob_pos, const double *phi, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              /* Phase-space Hamiltonian velocity flux: serendipity and the
                 tensor p=1 hybrid (no phase rep for tensor p>1). */
              if ((bName[bInd] = "ser" or bName[bInd] = "tensor") and not(c+v>=5 and pi>1)) then
                (printf(fh, "~aint hamil_phase_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                  deco, si, vlabels[dir], c, v, bName[bInd], pi))
            ),
            for dir : 1 thru v do (
              printf(fh, "~aint E_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *qmem, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              printf(fh, "~aint rad_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *rad, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              if (v > 1) then (
                printf(fh, "~aint B_~ahamil_vel_dense_alpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *jacob_vel_surf, const double *hamil, const double *qmem, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                  deco, si, vlabels[dir], c, v, bName[bInd], pi),
                printf(fh, "~aint B_~ahamil_vel_sparse_alpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *jacob_vel_surf, const double *hamil, const double *qmem, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                  deco, si, vlabels[dir], c, v, bName[bInd], pi),
                /* Phase-space Hamiltonian magnetic force: serendipity and
                   the tensor p=1 hybrid (no tensor p>1 representation). */
                if ((bName[bInd] = "ser" or bName[bInd] = "tensor") and not(c+v>=5 and pi>1)) then
                  (printf(fh, "~aint B_~ahamil_phase_alpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *dxv, const double *jacob_vel_surf, const double *hamil, const double *qmem, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                    deco, si, vlabels[dir], c, v, bName[bInd], pi))
              ),
              printf(fh, "~avoid ~alax_flux_nodal_~a_~ax~av_~a_p~a_g(int tid, const double *f_l, const double *f_r, double* GKYL_RESTRICT G_l, double* GKYL_RESTRICT G_r); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              printf(fh, "~adouble ~alax_flux_nodal_~a_~ax~av_~a_p~a_node(int i, int j, const double *jacob_vel_surf_r, double alpha, const double *G_l, const double *G_r, double* GKYL_RESTRICT Fhat_nodal); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              printf(fh, "~avoid ~alax_flux_nodal_~a_~ax~av_~a_p~a_prj(int tid, const double *Fhat_nodal, double* GKYL_RESTRICT flux); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              printf(fh, "~adouble ~alax_flux_nodal_~a_~ax~av_~a_p~a_cfl(const double *dxv, const double *jacob_vel_surf_l, const double *jacob_vel_surf_r, double alpha_max); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi)
              /* DISABLED until the per-mode GPU launcher lands (the volume
                 kernels need the same per-output-mode decomposition first;
                 re-enable together with emitConsumerModeFns in
                 surf-eval-tables.mac): the from-flux consumer per-mode decls
                 -- volume-mode ownership, iteration m computes its surface
                 mode's projection and updates out[m] only; mirror
                 ms-vlasovSurf.mac and ms-vlasovBoundarySurf.mac --
              , printf(fh, "~avoid vlasov_~asurf~a_~ax~av_~a_p~a_mode(int m, double dv1, const double *Fhat_l_nodal, const double *Fhat_r_nodal, double* GKYL_RESTRICT out); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi),
              printf(fh, "~avoid vlasov_boundary_~asurf~a_~ax~av_~a_p~a_mode(int m, int edge, double dv1, const double *flux, double* GKYL_RESTRICT out); ~%",
                deco, si, vlabels[dir], c, v, bName[bInd], pi)
              */
            ),
            printf(fh, "~%")
          )
        )
      )
    )
  )
)$

/* Configuration-direction surfaces (mirror ms-triadConfFluxSurf.mac gates;
   serendipity plus the tensor p=1 hybrid, which gets ONLY the lax kernels
   and the phase-Hamiltonian producers (vel_dense/vel_sparse conf producers
   belong to the triads campaign); tensor p=1 emits both lo and ho_ forms. */
for bInd : 1 thru 2 do (
for c : 1 thru 3 do (
  for v : max(c,1) thru 3 do (
    maxPolyOrderB : (if bInd = 1 then 2 else 1), if (c+v>5 and maxPolyOrderB > 1) then maxPolyOrderB : 1,
    for pi : 1 thru maxPolyOrderB do (
      for dir : 1 thru c do (
        for hoInd : 1 thru 2 do (
          useHigherOrder : is(hoInd = 2),
          si : if useHigherOrder then "ho_" else "",
          if not((bName[bInd] = "ser") and (pi = 1) and useHigherOrder) then (
            if ((bName[bInd] = "ser") and (pi = 1)) then si : "",
            printf(fh, "~avoid ~alax_flux_nodal_~a_~ax~av_~a_p~a_g(int tid, const double *f_l, const double *f_r, double* GKYL_RESTRICT G_l, double* GKYL_RESTRICT G_r); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi),
            printf(fh, "~adouble ~alax_flux_nodal_~a_~ax~av_~a_p~a_node(int i, int j, const double *jacob_pos_l, const double *jacob_pos_r, double alpha, const double *G_l, const double *G_r, double* GKYL_RESTRICT Fhat_nodal); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi),
            printf(fh, "~avoid ~alax_flux_nodal_~a_~ax~av_~a_p~a_prj(int tid, const double *Fhat_nodal, double* GKYL_RESTRICT flux); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi),
            printf(fh, "~adouble ~alax_flux_nodal_~a_~ax~av_~a_p~a_cfl(const double *dxv, const double *jacob_pos_l, const double *jacob_pos_r, double alpha_max); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi),
            /* Velocity-space Hamiltonian producers: Serendipity and the
               tensor p=1 hybrid (every rep is usable on tensor p=1). */
            printf(fh, "~aint hamil_vel_dense_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *w, const double *dxv, const int hamil_pt_edge, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi),
            if (v > 1) then
              (printf(fh, "~aint hamil_vel_sparse_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *w, const double *dxv, const int hamil_pt_edge, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                deco, si, clabels[dir], c, v, bName[bInd], pi)),
            if not(c+v>=5 and pi>1) then (printf(fh, "~aint hamil_phase_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *w, const double *dxv, const int hamil_pt_edge, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
              deco, si, clabels[dir], c, v, bName[bInd], pi))
            /* DISABLED until the per-mode GPU launcher lands (re-enable with
               emitConsumerModeFns in surf-eval-tables.mac): the from-flux
               stream consumer per-mode decls -- mirror ms-triadSurf.mac and
               ms-triadBoundarySurf.mac --
            , printf(fh, "~avoid vlasov_~asurf~a_~ax~av_ser_p~a_mode(int m, double dx1, const double *Fhat_l_nodal, const double *Fhat_r_nodal, double* GKYL_RESTRICT out); ~%",
              deco, si, clabels[dir], c, v, pi),
            printf(fh, "~avoid vlasov_boundary_~asurf~a_~ax~av_ser_p~a_mode(int m, int edge, double dx1, const double *flux, double* GKYL_RESTRICT out); ~%",
              deco, si, clabels[dir], c, v, pi)
            */
          )
        )
      ),
      printf(fh, "~%")
    )
  )
)
)$
/* Triad velocity-direction Hamiltonian producers (mirror
   ms-triadVelFluxSurf.mac gates: serendipity p1/p2 and the tensor p=1
   hybrid with every rep; vel_sparse skipped in 1V where sparse aliases
   dense; ser p1 has a single lo form, tensor p1 has lo and ho_). */
for bInd : 1 thru 2 do (
for c : 1 thru 3 do (
  for v : max(c,1) thru 3 do (
    maxPolyOrderB : (if bInd = 1 then 2 else 1), if (c+v>5) then maxPolyOrderB : 1,
    for pi : 1 thru maxPolyOrderB do (
      for dir : 1 thru v do (
        for hoInd : 1 thru 2 do (
          useHigherOrder : is(hoInd = 2),
          si : if useHigherOrder then "ho_" else "",
          if not((bName[bInd] = "ser") and (pi = 1) and useHigherOrder) then (
            if ((bName[bInd] = "ser") and (pi = 1)) then si : "",
            for rep in (if v > 1 then ["vel_dense", "vel_sparse", "phase"] else ["vel_dense", "phase"]) do
              if not(rep = "phase" and c+v>=5 and pi>1) then (printf(fh, "~aint nc_hamil_~a_~aalpha_quad_~a_~ax~av_~a_p~a_shared(int tid, int off, const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT O, double* GKYL_RESTRICT I); ~%",
                deco, rep, si, vlabels[dir], c, v, bName[bInd], pi))
          )
        )
      ),
      printf(fh, "~%")
    )
  )
)
)$
printf(fh, "EXTERN_C_END ~%")$
close(fh)$
