load("pkpm/pkpm/pkpm-remap-flux.mac")$
load(stringproc)$
/* This script generates, for the p=1 PKPM solver and cdim = 1, 2, 3, the kernels of the
   exact-remap configuration-space face flux (see pkpm-remap-flux.mac) and their header
   gkyl_pkpm_remap_flux_kernels.h. */

remapDirs : ["x", "y", "z"]$

fhH : openw("~/max-out/gkyl_pkpm_remap_flux_kernels.h")$
printf(fhH, "#pragma once ~%")$
printf(fhH, "#include <math.h> ~%")$
printf(fhH, "#include <gkyl_util.h> ~%")$
printf(fhH, "EXTERN_C_BEG ~%~%")$
for c : 1 thru 3 do (
  for d : 1 thru c do (
    funcName : sconcat("pkpm_remap_flux_trace_", remapDirs[d], "_", c, "x1v_ser_p1"),
    disp(printf(false, "Creating ~a", funcName)),
    printf(fhH, "GKYL_CU_DH void ~a(double jdinv_l, double jdinv_r, const double *f_l, const double *f_r, double* GKYL_RESTRICT G_l, double* GKYL_RESTRICT G_r); ~%", funcName),
    fh : openw(sconcat("~/max-out/", funcName, ".c")),
    calcPKPMRemapFluxTrace(d, fh, funcName, c),
    close(fh),
    funcName : sconcat("pkpm_remap_flux_store_", remapDirs[d], "_", c, "x1v_ser_p1"),
    disp(printf(false, "Creating ~a", funcName)),
    printf(fhH, "GKYL_CU_DH void ~a(const double *wpsi, const double *proj, double* GKYL_RESTRICT flux); ~%", funcName),
    fh : openw(sconcat("~/max-out/", funcName, ".c")),
    calcPKPMRemapFluxStore(d, fh, funcName, c),
    close(fh)
  ),
  printf(fhH, "~%")
)$
printf(fhH, "EXTERN_C_END ~%")$
close(fhH)$
