/* Generate the header file for the phase-space kernels of the refactored (p=1)
   PKPM solver: configuration-space HLL flux producers, the v_par flux producer, the
   hyper_dg surface kernels scattering stored modal fluxes, the volume kernels of
   the configuration-space (stage A) and velocity-space (stage B) passes, and the normalization
   and transversality projection of the distributions. */

cvars : ["x", "y", "z"]$

fh : openw("~/max-out/gkyl_pkpm_kinetic_kernels.h")$

printf(fh, "#pragma once ~%")$
printf(fh, "#include <math.h> ~%")$
printf(fh, "#include <gkyl_util.h> ~%")$
printf(fh, "EXTERN_C_BEG ~%")$
printf(fh, "~%")$

deco : "GKYL_CU_DH "$
for c : 1 thru 3 do (
  printf(fh, "~adouble pkpm_kinetic_conf_vol_~ax1v_ser_p1(const double *w, const double *dxv, const double *jacob_pos,
  const double *bvar, const double *u, const double *xi, const double *f, double* GKYL_RESTRICT out); ~%", deco, c),
  printf(fh, "~aint pkpm_dist_normalize_~ax1v_ser_p1(const double *nmoms, const double *f, double* GKYL_RESTRICT fbar); ~%", deco, c),
  printf(fh, "~avoid pkpm_dist_transverse_~ax1v_ser_p1(const double *bvar, double* GKYL_RESTRICT f); ~%", deco, c),
  for d : 1 thru c do (
    printf(fh, "~adouble pkpm_conf_flux_~a_~ax1v_ser_p1(const double *w, const double *dxv,
  const double *jacob_pos_l, const double *jacob_pos_r, const double *b_l, const double *b_r,
  const double *u_l, const double *u_r, const double *xi_l, const double *xi_r,
  const double *theta_l, const double *theta_r, const double *f_l, const double *f_r,
  double* GKYL_RESTRICT flux); ~%", deco, cvars[d], c),
    printf(fh, "~adouble pkpm_stream_surf~a_~ax1v_ser_p1(const double *w, const double *dxv,
  const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[d], c)
  ),
  printf(fh, "~adouble pkpm_accel_surfvpar_~ax1v_ser_p1(const double *w, const double *dxv,
  const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, c),
  printf(fh, "~avoid pkpm_vel_flux_nodes_~ax_ser_p1(const double *wn, const double *theta, const double *bvar,
  const double *alpha_0, const double *c_h, double* GKYL_RESTRICT nv); ~%", deco, c),
  printf(fh, "~adouble pkpm_vel_flux_vpar_~ax1v_ser_p1(const double *w, const double *dxv, const double *nv,
  const double *f_l, const double *f_r, double* GKYL_RESTRICT flux); ~%", deco, c),
  printf(fh, "~adouble pkpm_kinetic_vel_vol_~ax1v_ser_p1(const double *w, const double *dxv,
  const double *c_0, const double *alpha_0, const double *c_h, const double *a_perp,
  const double *f, double* GKYL_RESTRICT out); ~%", deco, c),
  printf(fh, "~avoid pkpm_harm_build_~ax_ser_p1(double qbym, const double *bvar, const double *grad_b, const double *u,
  const double *grad_u, const double *xi, const double *grad_xi, const double *grad_ln_n, const double *theta,
  const double *dtb, const double *em, double* GKYL_RESTRICT ho, double* GKYL_RESTRICT wn); ~%", deco, c),
  printf(fh, "~avoid pkpm_harm_mat_~ax_ser_p1(const double *dxv, const double *jacob_pos, const double *ho,
  double* GKYL_RESTRICT mat); ~%", deco, c),
  printf(fh, "~avoid pkpm_harm_vol_~ax1v_ser_p1(const double *w, const double *dxv, const double *mat, const double *f,
  double* GKYL_RESTRICT out); ~%", deco, c),
  printf(fh, "~%")
)$
printf(fh, "EXTERN_C_END ~%")$
close(fh)$
