/* pkpm-vars-prim.mac -----------------------------------------------------------
   Primitive variables of the factored, energy-constrained (p=1) PKPM fluid state
   [rho, rho ux, rho uy, rho uz, E]: at the 2^cdim Gauss-Legendre nodes

     u = M/rho,   xi^2 = (2 E/rho - |u|^2)/3,   xi = sqrt(xi^2),   p = rho xi^2,

   interpolated to the p=1 basis with the 2-point rule. For p=1 (tensor = serendipity for
   cdim <= 3) the nodal quotient IS the weak division: rho u phi has degree <= 3 per direction,
   which the 2-point rule integrates exactly, so int phi rho u = int phi M for every p=1 phi,
   and that solution is unique when rho > 0 at the nodes. Every quotient of the solver follows
   this pattern. The flow u (3 expansions) and [xi, xi^2, p] (3 expansions) are stored: the
   kinetic equations use u and xi, the fluid kernels the pressures built from p.

   Policy: at a node where rho <= 0 all outputs are zero there; where rho > 0 but xi^2 <= 0,
   u = M/rho and [xi, xi^2, p] are zero there. The kernel returns the number of such nodes. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load(stringproc)$
fpprec : 24$

calcPKPMVarsPrim(fh, funcNm, cdim) := block(
  [varsC, bC, NC, nodes, weights, NN, nodeSub, rho_e, E_e, M_e, n, k, i, xi_c, xisq_c, p_c, u_c, nm],

  kill(varsC, bC),
  [varsC, bC] : loadBasis("ser", cdim, 1),
  NC : length(bC),
  [nodes, weights] : gaussOrdWeight(2, cdim),
  NN : length(nodes),

  printf(fh, "#include <gkyl_pkpm_vars_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH int ~a(const double *fluid, double* GKYL_RESTRICT u, double* GKYL_RESTRICT xi) ~%{ ~%", funcNm),
  printf(fh, "  // fluid: Input fluid state [rho, rho ux, rho uy, rho uz, E]. ~%"),
  printf(fh, "  // u:     Output flow velocity [ux, uy, uz]: the nodal quotient M/rho, the weak division at p=1. ~%"),
  printf(fh, "  // xi:    Output [xi, xi^2, p], xi^2 = (2 E/rho - |u|^2)/3, p = rho xi^2, at the ~a Gauss-Legendre nodes, ~%", NN),
  printf(fh, "  //        interpolated to the p=1 basis. ~%"),
  printf(fh, "  // Returns the number of nodes where rho <= 0 (all outputs zero there) or xi^2 <= 0 ([xi, xi^2, p] zero there). ~%"),
  printf(fh, " ~%"),
  printf(fh, "  const double *rho = &fluid[~a]; ~%", 0*NC),
  printf(fh, "  const double *Mx = &fluid[~a]; ~%", 1*NC),
  printf(fh, "  const double *My = &fluid[~a]; ~%", 2*NC),
  printf(fh, "  const double *Mz = &fluid[~a]; ~%", 3*NC),
  printf(fh, "  const double *E = &fluid[~a]; ~%", 4*NC),
  printf(fh, "  double *ux = &u[~a]; ~%", 0*NC),
  printf(fh, "  double *uy = &u[~a]; ~%", 1*NC),
  printf(fh, "  double *uz = &u[~a]; ~%", 2*NC),
  printf(fh, "  double *xi_1 = &xi[~a]; ~%", 0*NC),
  printf(fh, "  double *xi_sq = &xi[~a]; ~%", 1*NC),
  printf(fh, "  double *p_sc = &xi[~a]; ~%", 2*NC),
  printf(fh, " ~%"),

  rho_e : doExpand1(rho, bC),
  E_e : doExpand1(E, bC),
  M_e : [doExpand1(Mx, bC), doExpand1(My, bC), doExpand1(Mz, bC)],

  printf(fh, "  double u_n[3][~a] = {{0.0}}; ~%", NN),
  printf(fh, "  double xi_n[~a] = {0.0}; ~%", NN),
  printf(fh, "  double xisq_n[~a] = {0.0}; ~%", NN),
  printf(fh, "  double p_n[~a] = {0.0}; ~%", NN),
  printf(fh, "  int num_null = 0; ~%"),
  for n : 1 thru NN do (
    nodeSub : makelist(varsC[d]=nodes[n][d], d, 1, cdim),
    printf(fh, "  { ~%"),
    printf(fh, "    const double rho_q = ~a; ~%", float(expand(subst(nodeSub, rho_e)))),
    printf(fh, "    const double E_q = ~a; ~%", float(expand(subst(nodeSub, E_e)))),
    for i : 1 thru 3 do
      printf(fh, "    const double M~a_q = ~a; ~%", i-1, float(expand(subst(nodeSub, M_e[i])))),
    printf(fh, "    if (rho_q > 0.0) { ~%"),
    printf(fh, "      const double inv_rho = 1.0/rho_q; ~%"),
    printf(fh, "      const double xisq = (2.0*E_q - (M0_q*M0_q + M1_q*M1_q + M2_q*M2_q)*inv_rho)*inv_rho/3.0; ~%"),
    printf(fh, "      u_n[0][~a] = M0_q*inv_rho; u_n[1][~a] = M1_q*inv_rho; u_n[2][~a] = M2_q*inv_rho; ~%", n-1, n-1, n-1),
    printf(fh, "      if (xisq > 0.0) { ~%"),
    printf(fh, "        xisq_n[~a] = xisq; xi_n[~a] = sqrt(xisq); p_n[~a] = rho_q*xisq; ~%", n-1, n-1, n-1),
    printf(fh, "      } else { num_null += 1; } ~%"),
    printf(fh, "    } else { ~%"),
    printf(fh, "      num_null += 1; ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "  } ~%")
  ),
  printf(fh, " ~%"),
  nm : ["ux", "uy", "uz"],
  for i : 1 thru 3 do (
    u_c : makelist(sum(weights[n]*subst(makelist(varsC[d]=nodes[n][d], d, 1, cdim), bC[k])*u_n[i-1][n-1], n, 1, NN), k, 1, NC),
    writeCExprs1(eval_string(nm[i]), u_c)
  ),
  xi_c : makelist(sum(weights[n]*subst(makelist(varsC[d]=nodes[n][d], d, 1, cdim), bC[k])*xi_n[n-1], n, 1, NN), k, 1, NC),
  xisq_c : makelist(sum(weights[n]*subst(makelist(varsC[d]=nodes[n][d], d, 1, cdim), bC[k])*xisq_n[n-1], n, 1, NN), k, 1, NC),
  p_c : makelist(sum(weights[n]*subst(makelist(varsC[d]=nodes[n][d], d, 1, cdim), bC[k])*p_n[n-1], n, 1, NN), k, 1, NC),
  writeCExprs1(xi_1, xi_c),
  writeCExprs1(xi_sq, xisq_c),
  writeCExprs1(p_sc, p_c),
  printf(fh, " ~%"),
  printf(fh, "  return num_null; ~%"),
  printf(fh, "} ~%")
)$
