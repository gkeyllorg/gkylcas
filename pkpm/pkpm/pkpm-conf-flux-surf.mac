/* pkpm-conf-flux-surf.mac -------------------------------------------------------
   Configuration-space surface fluxes of the PKPM kinetic equations of the eight blocks
   X = [F, G, M0_perp (x, y, z), N_perp (x, y, z)] and the hyper_dg surface kernels that scatter
   stored modal fluxes.

   pkpm_conf_face_coef_<dir>_<c>x_ser_p1(b_l, b_r, u_l, u_r, xi_l, xi_r, theta_l, theta_r, fc)
     The face coefficients of the flux on the LOWER face of the current cell in direction dir
     (normal e_d) at the face nodes (pkpmConfFluxNumPts Gauss-Legendre points per transverse
     configuration direction), once per configuration face (plan 17.42): from the traces of b,
     u_d, xi and theta of both cells (the left cell at its upper edge, the current cell at its lower
     edge), the face averages {q} = (q_l + q_r)/2 that the flux function uses (the field direction
     renormalized, b = {b}/|{b}|) and the per-side speeds of the time step (pkpm_harm_face_coef,
     gkyl_pkpm_harm_coeffs.h): fc[q*NO + i] for the coefficient q = PKPM_FC_* at the node i.

   pkpm_conf_flux_<dir>_<c>x1v_ser_p1(w, dxv, jacob_pos_l, jacob_pos_r, fc, f_l, f_r, flux)
     On the same face, at the face nodes and pkpmConfFluxNumWPts nodes in w, the HLL flux of the
     eight blocks (plans 17.14, 17.41) for the flux function with face-averaged coefficients,

       J(X) = a X + T(X),  a = {u_d} + {xi} {b_d} w,
       T_F = xi M0_d, T_G = xi N_d, T_M0 = xi G (e_d - b b_d), T_N = xi H (e_d - b b_d),

     H = 4 theta G - 2 theta^2 F, each side keeping its own state X, formed from the face
     coefficients fc by pkpm_harm_conf_flux (gkyl_pkpm_harm_coeffs.h), and its projection onto the
     surface modal basis of each block:
     flux = [8 blocks x NK]. The distributions are the normalized blocks of the factored,
     thermal-velocity normalized update; the traces of the Jacobian-weighted J X are scaled by
     1/J_d of their cell. Returns the stable time-step estimate (2p+1)/2 dx1 max(-S_L, S_R)/J_d with
     S_L, S_R the envelope of both sides' speeds and of the face flux at the nodes (plan 17.42).

   pkpm_stream_surf<dir>_<c>x1v_ser_p1(w, dxv, flux_l, flux_r, out)
     Scatter the stored modal fluxes of the lower (flux_l) and upper (flux_r) faces of the cell
     into the volume increment of the eight blocks, through the consumer projection maps of the
     table header.

   The node loop (HLL) is emitted by pkpmEmitConfFaceFlux, which the fluid-moment kernel
   pkpm_fluid_flux_accum_* (pkpm-fluid-flux-kinetic.mac) shares: the fluid flux is the moment of
   this flux, node by node, with the same arithmetic and face coefficients. */
load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/nodal_functions.mac")$
load("vlasov/vlasov/vlasov-basis.mac")$
load("vlasov/vlasov/nodal-lax-emit.mac")$
load("vlasov/vlasov/nodal-hll-emit.mac")$
load("vlasov/vlasov/surf-eval-tables.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load(stringproc)$
fpprec : 24$

cvars : [x, y, z]$


/* Emit `  name[i] = expr;` for a list of node expressions. */
pkpmWriteNodeExprs(fh, name, exprs) := block([i],
  for i : 1 thru length(exprs) do
    printf(fh, "  ~a[~a] = ~a; ~%", name, i-1, float(expand(exprs[i])))
)$

/* Edge traces of a modal configuration field at the transverse face nodes:
   edge = +1 for the left cell (its upper edge), -1 for the current cell. */
pkpmFaceNodeExprs(coeff, bC, cv, edge, cdim, surfCVars, nodes) := block([e],
  e : doExpand1(coeff, bC),
  makelist(subst(cv = edge,
    if cdim > 1 then subst(makelist(surfCVars[d] = nodes[i][d], d, 1, cdim-1), e) else e),
    i, 1, length(nodes))
)$

/* Sizes of the configuration-face tables of direction dir: [NC, NP, NO, NI, NA, nodes_crem,
   nodes_vvol, surfCVars, cv, pkbC, tabP]. */
pkpmConfFaceSizes(dir, cdim) := block(
  [tag, lb, pkC, pkbC, pkV, pkbP, cv, surfCVars, nodes_crem, nodes_vvol, fact],
  tag : pkpmFluxTag(cdim),
  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), pkV : copylist(lb[3]), pkbP : copylist(lb[6]),
  cv : pkC[dir],
  surfCVars : delete(cv, pkC),
  nodes_crem : if cdim > 1 then gaussOrd(pkpmConfFluxNumPts, cdim-1) else [1],
  nodes_vvol : gaussOrd(pkpmConfFluxNumWPts, 1),
  fact : laxFactorizeBasis(pkbP, if cdim > 1 then surfCVars else [prjdummy], cons(cv, pkV)),
  [length(pkbC), length(pkbP), length(nodes_crem), length(nodes_vvol),
   laxFactorSizes(fact, cv)[1], laxFactorSizes(fact, cv)[2], nodes_crem, nodes_vvol, surfCVars, cv,
   pkbC, sconcat("vst_", tag, "_ph_x", dir-1)]
)$

/* Emit the trace factors function funcNm_g of the eight blocks (one block per call). */
pkpmEmitConfFaceStage1(fh, funcNm, dir, cdim) := block([sz],
  sz : pkpmConfFaceSizes(dir, cdim),
  laxEmitStage1Fn(fh, funcNm, sz[12], sz[5], sz[6], sz[4])
)$

/* Face-coefficient kernel of direction dir (configuration space): the traces of b, u_d, xi and
   theta of both cells at the transverse face nodes and, node by node, pkpm_harm_face_coef. */
calcPKPMConfFaceCoef(dir, fh, funcNm, cdim) := block(
  [sz, NC, NO, nodes_crem, surfCVars, cv, pkbC, a],
  sz : pkpmConfFaceSizes(dir, cdim),
  NC : sz[1], NO : sz[3],
  nodes_crem : sz[7], surfCVars : sz[9], cv : sz[10], pkbC : sz[11],
  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(const double *b_l, const double *b_r, const double *u_l, const double *u_r,
  const double *xi_l, const double *xi_r, const double *theta_l, const double *theta_r,
  double* GKYL_RESTRICT fc) ~%{ ~%", funcNm),
  printf(fh, "  // b_l/b_r:   Magnetic field unit vector [bx, by, bz] in the left/current cell. ~%"),
  printf(fh, "  // u_l/u_r:   Flow velocity [ux, uy, uz] in the left/current cell. ~%"),
  printf(fh, "  // xi_l/xi_r: Thermal speed [xi, xi^2, p] in the left/current cell (the first expansion is used). ~%"),
  printf(fh, "  // theta_l/r: T_perp/T in the left/current cell. ~%"),
  printf(fh, "  // fc:        Output face coefficients of the flux on the lower face of the current cell in ~%"),
  printf(fh, "  //            direction ~a at the ~a transverse nodes: fc[q*~a + i] for q = PKPM_FC_*. ~%", cvars[dir], NO, NO),
  for a : 1 thru 3 do (
    printf(fh, "  const double *b~a_l = &b_l[~a], *b~a_r = &b_r[~a]; ~%", a-1, (a-1)*NC, a-1, (a-1)*NC)
  ),
  printf(fh, "  const double *ud_l = &u_l[~a], *ud_r = &u_r[~a]; ~%", (dir-1)*NC, (dir-1)*NC),
  printf(fh, "  const double *xd_l = &xi_l[0], *xd_r = &xi_r[0]; ~%"),
  printf(fh, " ~%"),
  printf(fh, "  // Traces of b, u_~a, xi and theta at the transverse nodes: the left cell at its upper ~%", cvars[dir]),
  printf(fh, "  // edge, the current cell at its lower edge. ~%"),
  for a : 1 thru 3 do (
    printf(fh, "  double bq~a_l[~a], bq~a_r[~a]; ~%", a-1, NO, a-1, NO),
    pkpmWriteNodeExprs(fh, sconcat("bq", a-1, "_l"), pkpmFaceNodeExprs(concat(b, a-1, '_l), pkbC, cv, 1, cdim, surfCVars, nodes_crem)),
    pkpmWriteNodeExprs(fh, sconcat("bq", a-1, "_r"), pkpmFaceNodeExprs(concat(b, a-1, '_r), pkbC, cv, -1, cdim, surfCVars, nodes_crem))
  ),
  printf(fh, "  double uq_l[~a], uq_r[~a], xq_l[~a], xq_r[~a], thq_l[~a], thq_r[~a]; ~%", NO, NO, NO, NO, NO, NO),
  pkpmWriteNodeExprs(fh, "uq_l", pkpmFaceNodeExprs(ud_l, pkbC, cv, 1, cdim, surfCVars, nodes_crem)),
  pkpmWriteNodeExprs(fh, "uq_r", pkpmFaceNodeExprs(ud_r, pkbC, cv, -1, cdim, surfCVars, nodes_crem)),
  pkpmWriteNodeExprs(fh, "xq_l", pkpmFaceNodeExprs(xd_l, pkbC, cv, 1, cdim, surfCVars, nodes_crem)),
  pkpmWriteNodeExprs(fh, "xq_r", pkpmFaceNodeExprs(xd_r, pkbC, cv, -1, cdim, surfCVars, nodes_crem)),
  pkpmWriteNodeExprs(fh, "thq_l", pkpmFaceNodeExprs(theta_l, pkbC, cv, 1, cdim, surfCVars, nodes_crem)),
  pkpmWriteNodeExprs(fh, "thq_r", pkpmFaceNodeExprs(theta_r, pkbC, cv, -1, cdim, surfCVars, nodes_crem)),
  printf(fh, " ~%"),
  printf(fh, "  for (int i = 0; i < ~a; ++i) { ~%", NO),
  printf(fh, "    const double bn_l[3] = {bq0_l[i], bq1_l[i], bq2_l[i]}, bn_r[3] = {bq0_r[i], bq1_r[i], bq2_r[i]}; ~%"),
  printf(fh, "    pkpm_harm_face_coef(~a, uq_l[i], uq_r[i], xq_l[i], xq_r[i], bn_l, bn_r, thq_l[i], thq_r[i], ~a, &fc[i]); ~%", dir-1, NO),
  printf(fh, "  } ~%"),
  printf(fh, "} ~%")
)$

/* Emit the body of a configuration-face flux kernel up to and including the call of
   pkpm_harm_conf_flux at every face node: the trace factors of the eight blocks (scaled by 1/J_d of
   their cell) and, in the loop over the transverse node i and the w node j (w value wq), the side
   contributions phi_l[8], phi_r[8] and the bounds sb[2] from the face coefficients fc of the node.
   consumer(fh) emits the statements that use them, inside the loop. The kernel arguments are named
   w, dxv, jacob_pos_l/r, fc, f_l/r. */
pkpmEmitConfFaceFlux(fh, funcNm, dir, cdim, consumer) := block(
  [sz, NC, NP, NO, NI, NA, nodes_vvol, tabP, j],
  sz : pkpmConfFaceSizes(dir, cdim),
  NC : sz[1], NP : sz[2], NO : sz[3], NI : sz[4], NA : sz[5],
  nodes_vvol : sz[8], tabP : sz[12],
  printf(fh, "  const double jdinv_l = 1.0/jacob_pos_l[~a], jdinv_r = 1.0/jacob_pos_r[~a]; ~%", 2*(dir-1), 2*(dir-1)),
  printf(fh, "  const double wv = w[~a], dv = dxv[~a]; ~%", cdim, cdim),
  printf(fh, "  // w of the nodes: wv + wn[j] dv ~%"),
  printf(fh, "  const double wn[~a] = {~{~a~^, ~}}; ~%", NI, makelist(float(0.5*nodes_vvol[j][1]), j, 1, NI)),
  printf(fh, " ~%"),
  printf(fh, "  // Trace factors of the eight blocks, scaled by 1/J_~a of their cell. ~%", cvars[dir]),
  printf(fh, "  double GU_l[8][~a], GU_r[8][~a]; ~%", NI*NA, NI*NA),
  printf(fh, "  for (int c = 0; c < 8; ++c) { ~%"),
  printf(fh, "    for (int tid = 0; tid < ~a; ++tid) ~a_g(tid, &f_l[c*~a], &f_r[c*~a], GU_l[c], GU_r[c]); ~%", NI*NA, funcNm, NP, NP),
  printf(fh, "    for (int k = 0; k < ~a; ++k) { GU_l[c][k] *= jdinv_l; GU_r[c][k] *= jdinv_r; } ~%", NI*NA),
  printf(fh, "  } ~%"),
  printf(fh, " ~%"),
  printf(fh, "  for (int i = 0; i < ~a; ++i) { ~%", NO),
  printf(fh, "    for (int j = 0; j < ~a; ++j) { ~%", NI),
  printf(fh, "      const double wq = wv + wn[j]*dv; ~%"),
  printf(fh, "      double X_l[8], X_r[8]; ~%"),
  printf(fh, "      for (int c = 0; c < 8; ++c) { ~%"),
  printf(fh, "        double x_l = 0.0, x_r = 0.0; ~%"),
  printf(fh, "        for (int a = 0; a < ~a; ++a) { ~%", NA),
  printf(fh, "          x_l += ~a_Cm[i*~a + a]*GU_l[c][j*~a + a]; ~%", tabP, NA, NA),
  printf(fh, "          x_r += ~a_Cm[i*~a + a]*GU_r[c][j*~a + a]; ~%", tabP, NA, NA),
  printf(fh, "        } ~%"),
  printf(fh, "        X_l[c] = x_l; X_r[c] = x_r; ~%"),
  printf(fh, "      } ~%"),
  printf(fh, "      double phi_l[8], phi_r[8], sb[2]; ~%"),
  printf(fh, "      pkpm_harm_conf_flux(~a, X_l, X_r, wq, &fc[i], ~a, phi_l, phi_r, sb); ~%", dir-1, NO),
  consumer(fh),
  printf(fh, "    } ~%"),
  printf(fh, "  } ~%")
)$

calcPKPMConfFluxSurf(dir, fh, funcNm, cdim) := block(
  [tag, lb, pkC, pkV, pkP, NO, NI, cv, surfCVars, bSurfP, NK, factP, prjPre, NMVp, sz],
  tag : pkpmFluxTag(cdim),
  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkV : copylist(lb[3]), pkP : copylist(lb[5]),
  sz : pkpmConfFaceSizes(dir, cdim),
  NO : sz[3], NI : sz[4],
  cv : pkC[dir],
  surfCVars : delete(cv, pkC),
  bSurfP : basisFromVars("tenhyb", delete(cv, pkP), 1),
  NK : length(bSurfP),
  factP : laxFactorizeBasis(bSurfP, if cdim > 1 then surfCVars else [prjdummy], pkV),
  NMVp : length(factP[2]),
  prjPre : sconcat("vst_", tag, "_prj_x", dir-1),

  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%"),
  pkpmFluxTabInclude(fh, cdim),
  pkpmEmitConfFaceStage1(fh, funcNm, dir, cdim),
  laxEmitPrjFn(fh, funcNm, prjPre, NK, length(factP[1]), NMVp, NO, NI, 0),

  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv,
  const double *jacob_pos_l, const double *jacob_pos_r, const double *fc, const double *f_l,
  const double *f_r, double* GKYL_RESTRICT flux) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:   Cell-center coordinates (current cell, computational). ~%"),
  printf(fh, "  // dxv[NDIM]: Cell spacing (current cell, computational). ~%"),
  printf(fh, "  // jacob_pos_l/r: Position-map Jacobian per configuration direction (cdim blocks of 2 equal ~%"),
  printf(fh, "  //            entries) of the left/current cell; the total Jacobian J is their product. ~%"),
  printf(fh, "  // fc:        Face coefficients of the face (pkpm_conf_face_coef_~a_~ax_ser_p1). ~%", cvars[dir], cdim),
  printf(fh, "  // f_l/f_r:   Jacobian-weighted normalized distributions J [F, G, M0_perp, N_perp] in the left/current cell. ~%"),
  printf(fh, "  // flux:      Output modal surface fluxes of the eight evolved blocks on the lower face of the ~%"),
  printf(fh, "  //            current cell in direction ~a: the physical HLL flux of the physical traces ~%", cvars[dir]),
  printf(fh, "  //            (J f)/J times the face Jacobian J/J_~a, i.e. the traces scaled by 1/J_~a of their cell. ~%", cvars[dir], cvars[dir]),
  printf(fh, "  // Returns the stable time-step estimate from the largest speed bound over the nodes. ~%"),
  printf(fh, "  const double dx1 = 2.0/dxv[~a]; ~%", dir-1),
  printf(fh, "  double Fhat[8][~a]; ~%", NO*NI),
  printf(fh, "  double alpha_max = 0.0; ~%"),
  pkpmEmitConfFaceFlux(fh, funcNm, dir, cdim, lambda([fh],
    printf(fh, "      for (int c = 0; c < 8; ++c) Fhat[c][i*~a + j] = phi_l[c] + phi_r[c]; ~%", NI),
    printf(fh, "      alpha_max = fmax(alpha_max, fmax(-sb[0], sb[1])); ~%"))),
  printf(fh, " ~%"),
  printf(fh, "  for (int c = 0; c < 8; ++c) { ~%"),
  printf(fh, "    for (int tid = 0; tid < ~a; ++tid) ~a_prj(tid, Fhat[c], &flux[c*~a]); ~%", NMVp, funcNm, NK),
  printf(fh, "  } ~%"),
  printf(fh, "  return 1.5*dx1*jdinv_r*alpha_max; ~%"),
  printf(fh, "} ~%")
)$

/* Surface kernel scattering stored modal fluxes of the eight blocks into the
   volume increment (surface-mode CSR form of the consumer maps). dirLabel is
   the C name suffix, pre the projection-table prefix, dxIdx the dxv index of
   the surface direction. */
calcPKPMScatterSurf(fh, funcNm, pre, NK, NP, dxIdx) := block(
  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv,
  const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  printf(fh, "  // flux_l/flux_r: Stored modal fluxes [F, G, M0_perp, N_perp] on the lower/upper face of the cell. ~%"),
  printf(fh, "  // out:           Incremented output [F, G, M0_perp, N_perp]. ~%"),
  printf(fh, "  const double dx1 = 2.0/dxv[~a]; ~%", dxIdx),
  printf(fh, "  for (int c = 0; c < 8; ++c) { ~%"),
  printf(fh, "    const double *fl = &flux_l[c*~a]; ~%", NK),
  printf(fh, "    const double *fr = &flux_r[c*~a]; ~%", NK),
  printf(fh, "    double *o = &out[c*~a]; ~%", NP),
  printf(fh, "    for (int k = 0; k < ~a; ++k) { ~%", NK),
  printf(fh, "      const double g_l = fl[k]; ~%"),
  printf(fh, "      const double g_r = fr[k]; ~%"),
  printf(fh, "      for (int q = ~a_out_off[k]; q < ~a_out_off[k+1]; ++q) { ~%", pre, pre),
  printf(fh, "        o[~a_out_mode[q]] += dx1*(~a_out_cl[q]*g_l + ~a_out_cr[q]*g_r); ~%", pre, pre, pre),
  printf(fh, "      } ~%"),
  printf(fh, "    } ~%"),
  printf(fh, "  } ~%"),
  printf(fh, "  return 0.0; ~%"),
  printf(fh, "} ~%")
)$


calcPKPMStreamSurf(dir, fh, funcNm, cdim) := block([tag, lb, pkC, pkP, NP, NK],
  tag : pkpmFluxTag(cdim),
  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkP : copylist(lb[5]), NP : length(lb[6]),
  NK : length(basisFromVars("tenhyb", delete(pkC[dir], pkP), 1)),
  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  pkpmFluxTabInclude(fh, cdim),
  calcPKPMScatterSurf(fh, funcNm, sconcat("vst_", tag, "_prj_x", dir-1), NK, NP, dir-1)
)$

calcPKPMAccelSurf(fh, funcNm, cdim) := block([tag, lb, pkV, pkP, NP, NK],
  tag : pkpmFluxTag(cdim),
  lb : loadPKPMPhaseBasis(cdim),
  pkV : copylist(lb[3]), pkP : copylist(lb[5]), NP : length(lb[6]),
  NK : length(basisFromVars("tenhyb", delete(pkV[1], pkP), 1)),
  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  pkpmFluxTabInclude(fh, cdim),
  calcPKPMScatterSurf(fh, funcNm, sconcat("vst_", tag, "_prj_v0"), NK, NP, cdim)
)$
