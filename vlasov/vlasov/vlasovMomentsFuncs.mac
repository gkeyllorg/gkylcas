/* Functions which compute the moments of the distribution function in 
   a Vlasov model. Certain moments, M1i, M2, and M3i, are defined in 
   terms of a specified Hamiltonian (dH/dv_i, H, H*dH/dv_i) which is
   either only a function of velocity-space (such as p^2/2m or mc^2*sqrt(1 + p^2)) 
   or a function of the full phase space through geometric terms, e.g., g^ij p_i p_j/2m. */

load("core/modal-basis.mac");
load("util_maxima/out-scripts.mac");
load("util_maxima/utilities.mac")$
load("core/nodal_operations/nodal_functions.mac")$
load("vlasov/vlasov/vlasov-basis.mac");
load(stringproc)$
fpprec : 24$

clabels : ["x","y","z"]$
/* Symbols for the constant per-direction inverse Jacobian of the C^0 linear
   map (Serendipity); kernels read the first entry of each direction's
   jacob_vel block. */
jacobConstInv_vi : [jacob_vx_inv, jacob_vy_inv, jacob_vz_inv]$
volExpr(cdim, vdim) := prod(dxv[cdim+i-1], i, 1, vdim)$
volExprTot(totDim) := prod(dxv[i-1], i, 1, totDim)$
vidx(cdim,vdim) := makelist(i,i,cdim,cdim+vdim-1)$
dv11 : [dv10, dv11, dv12]$

/* Number density */
/* M0 = < f > */
calcM0(fh, funcNm, cdim, vdim, basisFun, polyOrder) := block(
  [varsC,bC,varsV,bV,varsP,bP,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 

  printf(fh, "GKYL_CU_DH void ~a_M0_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
  const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  fl : doExpand1(f, bP),
  M : calcInnerProdList(varsP, 1, bC, fl),
  writeCIncrExprs1(out, volFact*M),
  
  printf(fh, "} ~%")
)$  

/* Mass flux (no mass factor) */
/* M1i = < dH/dv_i f > where H is the Hamiltonian. 
   Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcM1i(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_M1i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_M1i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i])
  ),

  fl : doExpand1(f, bP),

  M : (M : [],
    for dir : 1 thru vdim do (
      M : append(M, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), bC, fl))
    ),
  M),
  
  clst : [dv10, dv11, dv12, volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),
  
  printf(fh, "} ~%")
)$  

/* Energy (no mass factor) */
/* M2 = < H f > where H is the Hamiltonian. 
   Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcM2(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_M2_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_M2_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  fl : doExpand1(f, bP),
  M : calcInnerProdList(varsP, hamil, bC, fl),
  
  clst : [volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),
  
  printf(fh, "} ~%")
)$  

/* Energy flux (no mass factor) */
/* M3i = < H*dH/dv_i f > where H is the Hamiltonian. 
   Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcM3i(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,NV,NP,hamil,fl,M,jfac],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder),
  NV : length(bV),
  NP : length(bP),

  [bV_vi,NV_1D,jacobNodes,numJacobNodes,jacobNodes_vi,basisNodal_vi] = loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)),

  /* dH/dv_i in physical velocity divides the per-direction Jacobian out of the
     computational derivative; the C^0 linear map Jacobian is constant. */
  if (rep = "linear") then jfac : jacobConstInv_vi else jfac : [1, 1, 1],

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_M3i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx,
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse"),
    printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
    vid : vidx(cdim,vdim),
    for i : 1 thru vdim do (
      printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i]),
      printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[i], numJacobNodes*(i-1)) ,
      if (rep = "linear") then printf(fh, "  const double jacob_v~a_inv = 1.0/jacob_v~a[0]; ~%", clabels[i], clabels[i])
    ),

    printf(fh, "  double dH_dpx[~a] = {0.0}; ~%", NV),
    dH_dpx_c : calcInnerProdList(varsV, 1, bV, jfac[1]*dv11[1]*diff(hamil, vx)),
    writeCExprs1(dH_dpx, dH_dpx_c), 
    /* zero out components of px/gamma which are empty due to derivative */
    dH_dpx_NoZero : makelistNoZeros1(dH_dpx_c, dH_dpx),
    dH_dpx_NoZero_e : doExpand(dH_dpx_NoZero, bV), 
    dH_dp_fld : [dH_dpx_NoZero_e],
    printf(fh, "~%"),
    if (vdim > 1) then (
      printf(fh, "  double dH_dpy[~a] = {0.0}; ~%", NV),
      dH_dpy_c : calcInnerProdList(varsV, 1, bV, jfac[2]*dv11[2]*diff(hamil, vy)),
      writeCExprs1(dH_dpy, dH_dpy_c), 
      /* zero out components of py/gamma which are empty due to derivative */
      dH_dpy_NoZero : makelistNoZeros1(dH_dpy_c, dH_dpy),
      dH_dpy_NoZero_e : doExpand(dH_dpy_NoZero, bV), 
      dH_dp_fld : [dH_dpx_NoZero_e, dH_dpy_NoZero_e],
      printf(fh, "~%")
    ),
    if (vdim = 3) then (
      printf(fh, "  double dH_dpz[~a] = {0.0}; ~%", NV),
      dH_dpz_c : calcInnerProdList(varsV, 1, bV, jfac[3]*dv11[3]*diff(hamil, vz)),
      writeCExprs1(dH_dpz, dH_dpz_c), 
      /* zero out components of px/gamma which are empty due to derivative */
      dH_dpz_NoZero : makelistNoZeros1(dH_dpz_c, dH_dpz),
      dH_dpz_NoZero_e : doExpand(dH_dpz_NoZero, bV), 
      dH_dp_fld : [dH_dpx_NoZero_e, dH_dpy_NoZero_e, dH_dpz_NoZero_e],
      printf(fh, "~%")
    )
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_M3i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
    vid : vidx(cdim,vdim),
    for i : 1 thru vdim do (
      printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i])
    ),
    hamil : doExpand1(hamil, bP), 

    printf(fh, "  double dH_dpx[~a] = {0.0}; ~%", NP), 
    dH_dpx_c : calcInnerProdList(varsP, 1, bP, dv11[1]*diff(hamil, vx)), 
    writeCExprs1(dH_dpx, dH_dpx_c), 
    /* zero out components of px/gamma which are empty due to derivative */
    dH_dpx_NoZero : makelistNoZeros1(dH_dpx_c, dH_dpx),
    dH_dpx_NoZero_e : doExpand(dH_dpx_NoZero, bP), 
    dH_dp_fld : [dH_dpx_NoZero_e],
    printf(fh, "~%"),
    if (vdim > 1) then (
      printf(fh, "  double dH_dpy[~a] = {0.0}; ~%", NP), 
      dH_dpy_c : calcInnerProdList(varsP, 1, bP, dv11[2]*diff(hamil, vy)), 
      writeCExprs1(dH_dpy, dH_dpy_c), 
      /* zero out components of py/gamma which are empty due to derivative */
      dH_dpy_NoZero : makelistNoZeros1(dH_dpy_c, dH_dpy),
      dH_dpy_NoZero_e : doExpand(dH_dpy_NoZero, bP), 
      dH_dp_fld : [dH_dpx_NoZero_e, dH_dpy_NoZero_e],
      printf(fh, "~%")
    ),
    if (vdim = 3) then (
      printf(fh, "  double dH_dpz[~a] = {0.0}; ~%", NP), 
      dH_dpz_c : calcInnerProdList(varsP, 1, bP, dv11[3]*diff(hamil, vz)), 
      writeCExprs1(dH_dpz, dH_dpz_c), 
      /* zero out components of px/gamma which are empty due to derivative */
      dH_dpz_NoZero : makelistNoZeros1(dH_dpz_c, dH_dpz),
      dH_dpz_NoZero_e : doExpand(dH_dpz_NoZero, bP), 
      dH_dp_fld : [dH_dpx_NoZero_e, dH_dpy_NoZero_e, dH_dpz_NoZero_e],
      printf(fh, "~%")
    )        
  ),

  fl : doExpand1(f, bP),
  M : (M : [],
    for dir : 1 thru vdim do (
      M : append(M, calcInnerProdList(varsP, hamil*dH_dp_fld[dir], bC, fl))
    ),
  M),
  
  clst : [volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),
  
  printf(fh, "} ~%")
)$  

/* Pressure tensor */
calcM2ij(fh, funcNm, cdim, vdim, basisFun, polyOrder, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,varsV_p3,bV_p3,NV_p3,vmap_e,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder),
  /* 1D bases for expanding the stored velocity map (vdim*4 layout). */
  [varsV_p3,bV_p3] : loadBasis(basisFun, 1, 3),
  bV_vx : subst(x=vx, copylist(bV_p3)),
  bV_vy : subst(x=vy, copylist(bV_p3)),
  bV_vz : subst(x=vz, copylist(bV_p3)),
  NV_p3 : length(bV_p3),

  printf(fh, "GKYL_CU_DH void ~a_M2ij_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
  const double *vmap, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  for i : 1 thru vdim do (
    printf(fh, "  const double *vmap_v~a = &vmap[~a]; ~%", clabels[i], NV_p3*(i-1))
  ),
  /* The velocity coordinate always comes from the stored velocity map:
     C^1 cubic (tensor bases) or C^0 linear in slots [0],[1] (Serendipity). */
  if (rep = "cubic") then (
    vmap_e : [doExpand1(vmap_vx, bV_vx), doExpand1(vmap_vy, bV_vy), doExpand1(vmap_vz, bV_vz)]
  )
  else (
    loadVelLinearMapBasis(),
    vmap_e : [doExpand1(vmap_vx, bV_lin_vi[1]), doExpand1(vmap_vy, bV_lin_vi[2]), doExpand1(vmap_vz, bV_lin_vi[3])]
  ),

  fl : doExpand1(f, bP),

  M : (M : [],
    for d1 : 1 thru vdim do (
      for d2 : d1 thru vdim do (
        M : append(M, calcInnerProdList(varsP, vmap_e[d1]*vmap_e[d2], bC, fl))
    )),
  M),

  /* Maxima prints powers of the map coefficients as vmap_vx[k]^2, which is
     not valid C. Hoist them into precomputed scalars. */
  M : float(expand(M)),
  vmapS_vi : [vmap_vx, vmap_vy, vmap_vz],
  subList : [],
  for d : 1 thru vdim do (
    for k : 0 thru NV_p3-1 do (
      vS : vmapS_vi[d][k],
      sqS : concat('vmap_v, clabels[d], k, '_sq),
      if (not freeof(vS^2, M)) then (
        subList : cons(vS^2 = sqS, subList),
        printf(fh, "  const double ~a = ~a*~a; ~%", sqS, vS, vS)
      )
    )
  ),
  M : subst(subList, M),

  clst : [volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),

  printf(fh, "} ~%")
)$

/* Heat-flux tensor */
calcM3ijk(fh, funcNm, cdim, vdim, basisFun, polyOrder, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,varsV_p3,bV_p3,NV_p3,vmap_e,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder),
  /* 1D bases for expanding the stored velocity map (vdim*4 layout). */
  [varsV_p3,bV_p3] : loadBasis(basisFun, 1, 3),
  bV_vx : subst(x=vx, copylist(bV_p3)),
  bV_vy : subst(x=vy, copylist(bV_p3)),
  bV_vz : subst(x=vz, copylist(bV_p3)),
  NV_p3 : length(bV_p3),

  printf(fh, "GKYL_CU_DH void ~a_M3ijk_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
  const double *vmap, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  for i : 1 thru vdim do (
    printf(fh, "  const double *vmap_v~a = &vmap[~a]; ~%", clabels[i], NV_p3*(i-1))
  ),
  if (rep = "cubic") then (
    vmap_e : [doExpand1(vmap_vx, bV_vx), doExpand1(vmap_vy, bV_vy), doExpand1(vmap_vz, bV_vz)]
  )
  else (
    loadVelLinearMapBasis(),
    vmap_e : [doExpand1(vmap_vx, bV_lin_vi[1]), doExpand1(vmap_vy, bV_lin_vi[2]), doExpand1(vmap_vz, bV_lin_vi[3])]
  ),

  fl : doExpand1(f, bP),

  M : (M : [],
    for d1 : 1 thru vdim do (
      for d2 : d1 thru vdim do (
        for d3 : d2 thru vdim do (
          M : append(M, calcInnerProdList(varsP, vmap_e[d1]*vmap_e[d2]*vmap_e[d3], bC, fl))
    ))),
  M),

  /* Maxima prints powers of the map coefficients as vmap_vx[k]^n, which is
     not valid C. Hoist squares and cubes into precomputed scalars. */
  M : float(expand(M)),
  vmapS_vi : [vmap_vx, vmap_vy, vmap_vz],
  subList : [],
  for d : 1 thru vdim do (
    for k : 0 thru NV_p3-1 do (
      vS : vmapS_vi[d][k],
      sqS : concat('vmap_v, clabels[d], k, '_sq),
      cuS : concat('vmap_v, clabels[d], k, '_cu),
      if (not freeof(vS^2, M)) then (
        subList : cons(vS^2 = sqS, subList),
        printf(fh, "  const double ~a = ~a*~a; ~%", sqS, vS, vS)
      ),
      if (not freeof(vS^3, M)) then (
        subList : cons(vS^3 = cuS, subList),
        printf(fh, "  const double ~a = ~a*~a*~a; ~%", cuS, vS, vS, vS)
      )
    )
  ),
  M : subst(subList, M),

  clst : [volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),

  printf(fh, "} ~%")
)$

/* Calculate M0 = <f>, M1i = < dH/dv_i f >, and M2 = < H f > simultaneously */
/* Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcFiveMoments(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i])
  ),

  fl : doExpand1(f, bP),

  M0 : calcInnerProdList(varsP, 1, bC, fl),
  M1i : (M1i : [],
    for dir : 1 thru vdim do (
      M1i : append(M1i, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), bC, fl))
    ),
  M1i),
  M2 : calcInnerProdList(varsP, hamil, bC, fl),
  
  clst : [dv10, dv11, dv12, volFact],
  five_moments : [],
  five_moments : append(five_moments, volFact*M0),
  five_moments : append(five_moments, volFact*M1i),
  five_moments : append(five_moments, volFact*M2),
  writeCIncrExprsCollect1(out, five_moments, clst),
  
  printf(fh, "} ~%")
)$ 

/* Calculate integrated M0 = <f>, M1i = < dH/dv_i f >, and M2 = < H f > */
/* Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcIntFiveMoments(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_int_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_int_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a*~a; ~%", volExprTot(cdim+vdim), float(1/(2^(cdim+vdim))) ),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i])
  ),

  fl : doExpand1(f, bP),

  M0 : calcInnerProdList(varsP, 1, [1], fl),
  M1i : (M1i : [],
    for dir : 1 thru vdim do (
      M1i : append(M1i, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), [1], fl))
    ),
  M1i),
  M2 : calcInnerProdList(varsP, hamil, [1], fl),
  
  clst : [dv10, dv11, dv12, volFact],
  int_five_moments : [],
  int_five_moments : append(int_five_moments, volFact*M0),
  int_five_moments : append(int_five_moments, volFact*M1i),
  int_five_moments : append(int_five_moments, volFact*M2),
  writeCIncrExprsCollect1(out, int_five_moments, clst),
  
  printf(fh, "} ~%")
)$ 

/* Mass flux (no mass factor) with velocity mapping */
/* M1i = < 1/J_vi dH/dv_i Jf > where H is the Hamiltonian. 
   Takes boolean input for whether Hamiltonian is a function of only velocity space 
   or a function of the full phase space. */
calcM1iVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  NC : length(bC), 
  NP : length(bP), 

  [bV_vi,NV_1D,jacobNodes,numJacobNodes,jacobNodes_vi,basisNodal_vi] = loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_M1i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_M1i_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i]), 
    printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[i], numJacobNodes*(i-1)) ,
    if (rep = "linear") then printf(fh, "  const double jacob_v~a_inv = 1.0/jacob_v~a[0]; ~%", clabels[i], clabels[i])
  ),

  fl : doExpand1(f, bP),
  M : (M : [],
    for dir : 1 thru vdim do (
      if (rep = "cubic") then (
        fl_v : evAtNodes(fl,jacobNodes,[varsV[dir]]), 
        jacob_vi : jacobNodes_vi[dir], 
        basisNodal : basisNodal_vi[dir], 
        fl_v_ne : 0, 
        for i : 1 thru numJacobNodes do (
          fl_v_ne : fl_v_ne + fl_v[i]/jacob_vi[i]*basisNodal[i]
        )
      )
      else (
        /* C^0 linear map: constant Jacobian, exact scalar multiplication. */
        fl_v_ne : jacobConstInv_vi[dir]*fl
      ), 
      M : append(M, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), bC, fl_v_ne))
    ),
  M),
  clst : [jacob_vx[0], jacob_vx[1], jacob_vx[2], jacob_vx[3], jacob_vy[0], jacob_vy[1], jacob_vy[2], jacob_vy[3], jacob_vz[0], jacob_vz[1], jacob_vz[2], jacob_vz[3], jacob_vx_inv, jacob_vy_inv, jacob_vz_inv, dv10, dv11, dv12, volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),
  
  printf(fh, "} ~%")
)$  

/* Calculate M0 = <Jf>, M1i = < (1/J_v,i) dH/dv_i Jf >, and M2 = < H Jf >
   simultaneously. Jf carries the TOTAL velocity-map Jacobian; the 1/J_v,i on
   M1i is the Jacobian in the i-th direction only, picked up by the dH/dv_i
   derivative. Takes boolean input for whether Hamiltonian is a function of only
   velocity space or a function of the full phase space. */
calcFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  [bV_vi,NV_1D,jacobNodes,numJacobNodes,jacobNodes_vi,basisNodal_vi] = loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i]), 
    printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[i], numJacobNodes*(i-1)) ,
    if (rep = "linear") then printf(fh, "  const double jacob_v~a_inv = 1.0/jacob_v~a[0]; ~%", clabels[i], clabels[i])
  ),

  fl : doExpand1(f, bP),

  M0 : calcInnerProdList(varsP, 1, bC, fl),
  M1i : (M1i : [],
    for dir : 1 thru vdim do (
      if (rep = "cubic") then (
        fl_v : evAtNodes(fl,jacobNodes,[varsV[dir]]), 
        jacob_vi : jacobNodes_vi[dir], 
        basisNodal : basisNodal_vi[dir], 
        fl_v_ne : 0, 
        for i : 1 thru numJacobNodes do (
          fl_v_ne : fl_v_ne + fl_v[i]/jacob_vi[i]*basisNodal[i]
        )
      )
      else (
        /* C^0 linear map: constant Jacobian, exact scalar multiplication. */
        fl_v_ne : jacobConstInv_vi[dir]*fl
      ), 
      M1i : append(M1i, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), bC, fl_v_ne))
    ),
  M1i),
  M2 : calcInnerProdList(varsP, hamil, bC, fl),
  
  clst : [jacob_vx[0], jacob_vx[1], jacob_vx[2], jacob_vx[3], jacob_vy[0], jacob_vy[1], jacob_vy[2], jacob_vy[3], jacob_vz[0], jacob_vz[1], jacob_vz[2], jacob_vz[3], jacob_vx_inv, jacob_vy_inv, jacob_vz_inv, dv10, dv11, dv12, volFact],
  five_moments : [],
  five_moments : append(five_moments, volFact*M0),
  five_moments : append(five_moments, volFact*M1i),
  five_moments : append(five_moments, volFact*M2),
  writeCIncrExprsCollect1(out, five_moments, clst),
  
  printf(fh, "} ~%")
)$ 

/* Calculate integrated M0 = <Jf>, M1i = < (1/J_v,i) dH/dv_i Jf >, and
   M2 = < H Jf > simultaneously. Jf carries the TOTAL velocity-map Jacobian; the
   1/J_v,i on M1i is the Jacobian in the i-th direction only, picked up by the
   dH/dv_i derivative. Takes boolean input for whether Hamiltonian is a function
   of only velocity space or a function of the full phase space. */
calcIntFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  [bV_vi,NV_1D,jacobNodes,numJacobNodes,jacobNodes_vi,basisNodal_vi] = loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)), 

  if (hamil_rep # "phase") then (
    printf(fh, sconcat("GKYL_CU_DH void ~a_hamil_", hamil_rep, "_int_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%"), funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : hamilExpand(hamil, bV, varsV, hamil_rep = "vel_sparse")
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_hamil_phase_int_five_moments_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder),
    hamil : doExpand1(hamil, bP)    
  ),
  printf(fh, "  double volFact = ~a*~a; ~%", volExprTot(cdim+vdim), float(1/(2^(cdim+vdim))) ),
  vid : vidx(cdim,vdim),
  for i : 1 thru vdim do (
    printf(fh, "  double dv1~a = 2.0/dxv[~a]; ~%", i-1, vid[i]),
    printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", clabels[i], numJacobNodes*(i-1)) ,
    if (rep = "linear") then printf(fh, "  const double jacob_v~a_inv = 1.0/jacob_v~a[0]; ~%", clabels[i], clabels[i])
  ),

  fl : doExpand1(f, bP),

  M0 : calcInnerProdList(varsP, 1, [1], fl),
  M1i : (M1i : [],
    for dir : 1 thru vdim do (
      if (rep = "cubic") then (
        fl_v : evAtNodes(fl,jacobNodes,[varsV[dir]]), 
        jacob_vi : jacobNodes_vi[dir], 
        basisNodal : basisNodal_vi[dir], 
        fl_v_ne : 0, 
        for i : 1 thru numJacobNodes do (
          fl_v_ne : fl_v_ne + fl_v[i]/jacob_vi[i]*basisNodal[i]
        )
      )
      else (
        /* C^0 linear map: constant Jacobian, exact scalar multiplication. */
        fl_v_ne : jacobConstInv_vi[dir]*fl
      ), 
      M1i : append(M1i, calcInnerProdList(varsP, dv11[dir]*diff(hamil,varsV[dir]), [1], fl_v_ne))
    ),
  M1i),
  M2 : calcInnerProdList(varsP, hamil, [1], fl),
  
  clst : [jacob_vx[0], jacob_vx[1], jacob_vx[2], jacob_vx[3], jacob_vy[0], jacob_vy[1], jacob_vy[2], jacob_vy[3], jacob_vz[0], jacob_vz[1], jacob_vz[2], jacob_vz[3], jacob_vx_inv, jacob_vy_inv, jacob_vz_inv, dv10, dv11, dv12, volFact],
  int_five_moments : [],
  int_five_moments : append(int_five_moments, volFact*M0),
  int_five_moments : append(int_five_moments, volFact*M1i),
  int_five_moments : append(int_five_moments, volFact*M2),
  writeCIncrExprsCollect1(out, int_five_moments, clst),
  
  printf(fh, "} ~%")
)$ 

/* M0 integrated over a subset of velocity-space in the upper/lower half-plane */
calcM0ReduceVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, upper, rep) := block(
  [varsC,bC,varsV,bV,varsP,bP,hamil,fl,M],

  [varsC,bC,varsV,bV,varsP,bP] :  loadVlasovBasis(basisFun, cdim, vdim, polyOrder), 
  [bV_vi,NV_1D,jacobNodes,numJacobNodes,jacobNodes_vi,basisNodal_vi] = loadVelJacobianBasis(vlasovPVel(basisFun, polyOrder)), 

  if (upper) then (
    printf(fh, "GKYL_CU_DH void ~a_M0_upper_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *vmap, const double *jacob_vel, double v_thresh, double f_thresh, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder)
  )
  else (
    printf(fh, "GKYL_CU_DH void ~a_M0_lower_~ax~av_~a_p~a(const double *w, const double *dxv, const int *idx, 
    const double *vmap, const double *jacob_vel, double v_thresh, double f_thresh, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm, cdim, vdim, basisFun, polyOrder)
  ), 
  printf(fh, "  const double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),

  /* M0 Reduced only works for 1v, so only load the x velocity coordinate */
  printf(fh, "  const double *px = &vmap[0]; ~%"), 
  printf(fh, "  const double *jacob_vx = &jacob_vel[0]; ~%"), 
  if (rep = "cubic") then (
    px_e : doExpand1(px, bV_vi[1])
  )
  else (
    /* C^0 linear map: p=1 coefficients in slots [0],[1] of the 4-slot block. */
    loadVelLinearMapBasis(),
    px_e : doExpand1(px, bV_lin_vi[1])
  ), 
  /* Make a set of Gauss-Legendre nodes for evaluating configuration-space basis. */
  nodes_conf : gaussOrd(polyOrder+1, cdim),
  num_nodes_conf : length(nodes_conf), 

  /* Make a set of Gauss-Legendre nodes for evaluating velocity-space mapping. */
  nodes_vel : gaussOrd(polyOrder+1, vdim),
  num_nodes_vel : length(nodes_vel), 
  px_ords : gcfac(float(evAtNodes(px_e,nodes_vel,varsV))),
  py_ords : gcfac(float(evAtNodes(py_e,nodes_vel,varsV))),
  pz_ords : gcfac(float(evAtNodes(pz_e,nodes_vel,varsV))),

  f_e : doExpand1(f, bP),

  nodes_phase : gaussOrd(polyOrder+1, cdim+vdim), 
  basisNodal_phase : getVarsNodalBasisWithNodes("Tensor", cdim+vdim, polyOrder, varsP, nodes_phase),
  num_nodes_phase : length(nodes_phase), 
  f_ords : gcfac(float(evAtNodes(f_e,nodes_phase,varsP))),
  printf(fh, "  double f_nodes[~a] = {0.0};~%", num_nodes_phase),
  printf(fh, "  double fquad = 0.0;~%"),
  for j : 1 thru num_nodes_vel do (
    if (upper) then (
      printf(fh, "  if ((~a) > v_thresh) { ~%", px_ords[j])
    )
    else (
      printf(fh, "  if ((~a) < -v_thresh) { ~%", px_ords[j])
    ), 
    for i : 1 thru num_nodes_conf do (
      printf(fh, "    fquad = ~a; ~%", f_ords[j+(i-1)*num_nodes_vel]),
      if (rep = "cubic") then jthr : j-1 else jthr : 0,
      printf(fh, "    f_nodes[~a] = fquad > jacob_vx[~a]*f_thresh ? fquad : 0.0; ~%", (j-1)+(i-1)*num_nodes_vel, jthr)
    ), 
    printf(fh, "  } ~%")
  ), 
  fNodal_e : doExpand1(f_nodes, basisNodal_phase),
  /* Compute moment in nodal basis since we can do so without aliasing */
  M : calcInnerProdList(varsP, 1, bC, fNodal_e), 
  clst : [volFact],
  writeCIncrExprsCollect1(out, volFact*M, clst),
  
  printf(fh, "} ~%")
)$  

calcMoments(fh, funcNm, cdim, vdim, basisFun, polyOrder, calcHamilPhase) := block([rep, hyb],
  /* Serendipity -> C^0 linear map (constant Jacobian); tensor -> C^1 cubic
     map (quadratic Jacobian) at EVERY p, including the p=1 hybrid. */
  rep : vlasovVelMapRep(basisFun),
  /* The tensor p=1 hybrid factors the M1i and five-moment velocity integrals by direction
     (calcMomHybFactored). */
  hyb : is(basisFun = "tensor" and polyOrder = 1),
  printf(fh, "#include <gkyl_mom_vlasov_kernels.h> ~%"),  
  calcM0(fh, funcNm, cdim, vdim, basisFun, polyOrder), 
  /* New energy flux kernels which are formally H*dH/dv are very dense, 
     so not generating them for right now. JJ 07/26/25. */
  /* calcM3i(fh, funcNm, cdim, vdim, basisFun, polyOrder, true), 
  calcM3i(fh, funcNm, cdim, vdim, basisFun, polyOrder, false),  */
  calcM2ij(fh, funcNm, cdim, vdim, basisFun, polyOrder, rep),
  calcM3ijk(fh, funcNm, cdim, vdim, basisFun, polyOrder, rep),
  /* Velocity-space Hamiltonian moments. M1i = < (1/J_v,i) dH/dv_i Jf >: the
     dH/dv_i derivative picks up 1/J_v,i -- the velocity-map Jacobian in the
     DIRECTION OF THE DERIVATIVE only; the total map Jacobian stays on Jf. */
  if hyb then calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_dense", "M1i")
  else calcM1iVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_dense", rep),
  calcM2(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_dense"),
  /* The hamil_vel M3i energy flux is only in the Serendipity kernel tables. */
  if (basisFun = "ser") then calcM3i(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_dense", rep),
  if hyb then (
    calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_dense", "five_moments"),
    calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_dense", "int_five_moments")
  ) else (
    calcFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_dense", rep),
    calcIntFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_dense", rep)
  ),
  /* Sparse (separable) velocity-space Hamiltonian moments. In 1V sparse and
     dense are identical: only generate for vdim > 1 and let the kernel tables
     alias the 1V sparse entries to dense. */
  if (vdim > 1) then (
    if hyb then calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_sparse", "M1i")
    else calcM1iVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_sparse", rep),
    calcM2(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_sparse"),
    if (basisFun = "ser") then calcM3i(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_sparse", rep),
    if hyb then (
      calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_sparse", "five_moments"),
      calcMomHybFactored(fh, funcNm, cdim, vdim, "vel_sparse", "int_five_moments")
    ) else (
      calcFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_sparse", rep),
      calcIntFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "vel_sparse", rep)
    )
  ), 
  /* Partial (threshold) M0 moments: 1V only for now, but defined for every
     basis/rep (the velocity map is folded into all bases uniformly). */
  if (vdim = 1) then (
    calcM0ReduceVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, true, rep),
    calcM0ReduceVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, false, rep) 
  ),
  /* Phase-space Hamiltonian moments (canonical-PB/Triads): the Vmap variants
     carry the same per-direction derivative factors as the vel-Hamiltonian
     flavors -- M1i's dH/dv_i picks up 1/J_v,i (the Jacobian in the derivative's
     direction, NOT the total Jacobian, which stays on Jf). Identity map =>
     runtime factors of 1.0. M2 = <H Jf> has no derivative, so no factor. */
  /* Phase moments exist for Serendipity and the tensor p=1 hybrid (no phase
     rep for tensor p>1). */
  if (calcHamilPhase) then (
    if hyb then calcMomHybFactored(fh, funcNm, cdim, vdim, "phase", "M1i")
    else calcM1iVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "phase", rep),
    calcM2(fh, funcNm, cdim, vdim, basisFun, polyOrder, "phase"),
    if hyb then (
      calcMomHybFactored(fh, funcNm, cdim, vdim, "phase", "five_moments"),
      calcMomHybFactored(fh, funcNm, cdim, vdim, "phase", "int_five_moments")
    ) else (
      calcFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "phase", rep),
      calcIntFiveMomentsVmap(fh, funcNm, cdim, vdim, basisFun, polyOrder, "phase", rep)
    )
  )
)$
/* Moments of the tensor p=1 hybrid basis with the velocity integrals factored by direction:
   mom = "M1i", "five_moments" or "int_five_moments" of calcM1iVmap, calcFiveMomentsVmap and
   calcIntFiveMomentsVmap (cubic map; M2 alone, a plain product, stays the modal calcM2). In the
   orthonormal 1D Legendre polynomials the velocity integral of a product is the dot product of
   the coefficient tuples, d/dv_i is the 1D derivative matrix along direction i, and the division
   of Jf by the velocity-map Jacobian J_i at the 3 Gauss-Legendre nodes along direction i is the 1D
   matrix Et diag(1/J_i) E. A phase-space Hamiltonian evaluates the velocity integrals at the 2^cdim
   configuration-space Gauss-Legendre nodes (exact: the configuration-space integrand is at most
   cubic per direction), or, for the cell integrals, as the dot product of the configuration-space
   coefficients; for a velocity-space Hamiltonian every configuration-space mode is a spectator.
   Same as the modal kernels to round off. */
calcMomHybFactored(fh, funcNm, cdim, vdim, hamil_rep, mom) := block(
  [varsC, bC, varsV, bV, varsP, bP, NC, NV, NP, nq, NQV, cIdx, mIdx, coefL, degV, coefV, vars1,
   phi1, x1, w1, E, Et, Dm, flat, tupOf, phase, sparse, needM0, needM1, needM2, intg, lab, Bt,
   modalF, modalH, velH, m0, m1, m2, Fs, Hs, sSyms, bcq, nm, k, c, m, d, i, j, a, b, t, base],

  [varsC, bC, varsV, bV, varsP, bP] : loadVlasovBasis("tensor", cdim, vdim, 1),
  NC : length(bC), NV : length(bV), NP : length(bP), nq : 3, NQV : nq^vdim,
  [cIdx, mIdx, coefL, degV, coefV, vars1, phi1] : hybFactorBasis(bP, bC, bV, varsV, nq - 1),
  [x1, w1] : gaussOrdWeight1D(nq),
  /* E[i][p] = phi_p(x_i), Et[p][i] = w_i phi_p(x_i), d phi_b/dx = sum_a Dm[a][b] phi_a. */
  E : makelist(makelist(subst(vars1[1] = x1[i], phi1[b]), b, 1, nq), i, 1, nq),
  Et : makelist(makelist(w1[i]*E[i][a], i, 1, nq), a, 1, nq),
  Dm : makelist(makelist(integrate(phi1[a]*diff(phi1[b], vars1[1]), vars1[1], -1, 1), b, 1, nq), a, 1, nq),
  flat : lambda([tp], sum(tp[d]*nq^(vdim-d), d, 1, vdim)),
  tupOf : lambda([ii], makelist(mod(floor(ii/nq^(vdim-d)), nq), d, 1, vdim)),
  phase : is(hamil_rep = "phase"), sparse : is(hamil_rep = "vel_sparse"),
  needM0 : member(mom, ["five_moments", "int_five_moments"]),
  needM1 : member(mom, ["M1i", "five_moments", "int_five_moments"]),
  needM2 : member(mom, ["M2", "five_moments", "int_five_moments"]),
  intg : is(mom = "int_five_moments"),

  /* Coefficient tuples (flat 1D-degree index) of f and H: per configuration-space mode for the
     phase-space expansions, and the velocity-space Hamiltonian (sparse: modes of at most one
     velocity variable). */
  modalF : lambda([cc, sym], block([F : makelist(0, ii, 1, NQV)],
    for kk : 1 thru NP do if cIdx[kk] = cc then
      F[flat(degV[mIdx[kk]])+1] : coefL[kk]*coefV[mIdx[kk]]*arraymake(sym, [kk-1]),
    F)),
  velH : makelist(0, ii, 1, NQV),
  for m : 1 thru NV do
    if not (sparse and length(sublist(degV[m], lambda([e], e > 0))) > 1) then
      velH[flat(degV[m])+1] : coefV[m]*arraymake(hamil, [m-1]),

  /* Velocity integrals of tuple vectors: m0 = int F, m2 = int H F, m1 = (2/dv_i) int dH/dv_i (Jf/J_i). */
  m0 : lambda([F], 2^(vdim/2)*F[1]),
  m2 : lambda([H, F], sum(H[ii]*F[ii], ii, 1, NQV)),
  m1 : lambda([H, F, dd], block([lb : clabels[dd]], dv11[dd]*sum(block([tp : tupOf(ii-1)],
    sum(Dm[tp[dd]+1][bb+1]*H[flat(makelist(if e = dd then bb else tp[e], e, 1, vdim))+1], bb, 0, nq-1)
    *sum(arraymake(eval_string(sconcat("bdiv_v", lb)), [nq*tp[dd]+bb])*F[flat(makelist(if e = dd then bb else tp[e], e, 1, vdim))+1], bb, 0, nq-1)),
    ii, 1, NQV))),

  nm : sconcat(funcNm, "_hamil_", hamil_rep, "_", mom, "_", cdim, "x", vdim, "v_tensor_p1"),
  if mom = "M2" then
    printf(fh, "GKYL_CU_DH void ~a(const double *w, const double *dxv, const int *idx, 
    const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", nm)
  else
    printf(fh, "GKYL_CU_DH void ~a(const double *w, const double *dxv, const int *idx, 
    const double *jacob_vel, const double *hamil, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", nm),
  if intg then printf(fh, "  double volFact = ~a*~a; ~%", volExprTot(cdim+vdim), float(1/(2^(cdim+vdim))))
  else printf(fh, "  double volFact = ~a/~a; ~%", volExpr(cdim, vdim), 2^vdim),
  if needM1 then for d : 1 thru vdim do block([lb : clabels[d]],
    printf(fh, "  const double dv1~a = 2.0/dxv[~a]; ~%", d-1, cdim+d-1),
    printf(fh, "  const double *jacob_v~a = &jacob_vel[~a]; ~%", lb, nq*(d-1)),
    /* Division by J along direction d at its 3 nodes, as a 1D matrix on the coefficients. */
    printf(fh, "  double bdiv_v~a[~a]; ~%", lb, nq*nq),
    for a : 1 thru nq do for b : 1 thru nq do
      printf(fh, "  bdiv_v~a[~a] = ~a; ~%", lb, nq*(a-1)+b-1,
        float(expand(sum(Et[a][i]*E[i][b]/arraymake(eval_string(sconcat("jacob_v", lb)), [i-1]), i, 1, nq))))
  ),

  if not phase then (
    for c : 1 thru NC do block([F : modalF(c, f), cf, outs : []],
      /* int_five_moments: only the constant configuration-space mode has a nonzero cell integral. */
      cf : if intg then (if c = 1 then 2^(cdim/2) else 0) else 1,
      if cf # 0 then (
        base : if intg then 0 else c-1,
        if needM0 then outs : endcons([base, m0(F)], outs),
        if needM1 then for d : 1 thru vdim do
          outs : endcons([base + (if intg then d else NC*(d - (if mom = "M1i" then 1 else 0))), m1(velH, F, d)], outs),
        if needM2 then
          outs : endcons([base + (if mom = "M2" then 0 else (if intg then vdim+1 else NC*(vdim+1))), m2(velH, F)], outs),
        for o in outs do printf(fh, "  out[~a] += ~a; ~%", o[1], float(expand(volFact*cf*o[2])))
      )
    )
  ) else if intg then (
    /* Cell integrals of products of the phase-space expansions: by orthonormality, the sum over the
       configuration-space modes of the velocity integrals. */
    printf(fh, "  out[0] += ~a; ~%", float(expand(volFact*2^(cdim/2)*m0(modalF(1, f))))),
    for d : 1 thru vdim do
      printf(fh, "  out[~a] += ~a; ~%", d, float(expand(volFact*sum(m1(modalF(c, hamil), modalF(c, f), d), c, 1, NC)))),
    printf(fh, "  out[~a] += ~a; ~%", vdim+1, float(expand(volFact*sum(m2(modalF(c, hamil), modalF(c, f)), c, 1, NC))))
  ) else (
    /* M0 needs no node: the velocity integral only reads the constant velocity coefficient. */
    if needM0 then for c : 1 thru (if intg then 1 else NC) do
      printf(fh, "  out[~a] += ~a; ~%", c-1, float(expand(volFact*(if intg then 2^(cdim/2) else 1)*m0(modalF(c, f))))),
    sSyms : makelist(eval_string(sconcat("s", d-1)), d, 1, cdim),
    printf(fh, "  for (int q = 0; q < ~a; ++q) { ~%", 2^cdim),
    for d : 1 thru cdim do
      printf(fh, "  const double ~a = ((q >> ~a) & 1) ? 1.0 : -1.0; ~%", sSyms[d], cdim-d),
    bcq : makelist(subst(makelist(varsC[d] = sSyms[d]/sqrt(3), d, 1, cdim), bC[c]), c, 1, NC),
    printf(fh, "  double f_node[~a], h_node[~a]; ~%", NQV, NQV),
    for i : 1 thru NQV do printf(fh, "  f_node[~a] = ~a; ~%", i-1,
      float(expand(sum(bcq[c]*modalF(c, f)[i], c, 1, NC)))),
    for i : 1 thru NQV do printf(fh, "  h_node[~a] = ~a; ~%", i-1,
      float(expand(sum(bcq[c]*modalF(c, hamil)[i], c, 1, NC)))),
    Fs : makelist(f_node[i-1], i, 1, NQV), Hs : makelist(h_node[i-1], i, 1, NQV),
    if needM1 then for d : 1 thru vdim do
      printf(fh, "  const double m1_~a = ~a; ~%", clabels[d], float(expand(m1(Hs, Fs, d)))),
    if needM2 then printf(fh, "  const double m2q = ~a; ~%", float(expand(m2(Hs, Fs)))),
    /* Projection onto the configuration-space modes (Gauss-Legendre weights 1). */
    for c : 1 thru (if intg then 1 else NC) do block([cf : if intg then 1 else bcq[c]],
      base : if intg then 0 else c-1,
      if needM1 then for d : 1 thru vdim do
        printf(fh, "  out[~a] += ~a; ~%", base + (if intg then d else NC*(d - (if mom = "M1i" then 1 else 0))),
          float(expand(volFact*cf*eval_string(sconcat("m1_", clabels[d]))))),
      if needM2 then
        printf(fh, "  out[~a] += ~a; ~%", base + (if mom = "M2" then 0 else (if intg then vdim+1 else NC*(vdim+1))),
          float(expand(volFact*cf*m2q)))
    ),
    printf(fh, "  } ~%")
  ),
  printf(fh, "} ~%")
)$
