/* Generate kernels that compute theta = T_perp/m = p_perp/rho in the PKPM model by a
   pointwise quotient at the 2^cdim Gauss-Legendre nodes of the cell followed by projection
   onto the p=1 modal basis with the same 2-point rule. For a p=1 density that is positive at
   the nodes this is algebraically identical to weak division (every triple product in the
   weak form is integrated exactly by the rule), without forming a mass matrix.

   Policy for a non-positive density: at a node where rho <= 0 the quotient is undefined and
   theta is set to zero there; the kernel returns the number of such nodes. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load(stringproc)$
fpprec : 24$

calcPKPMVarsTheta(fh, funcNm, cdim, basisFun, polyOrder) := block(
  [varsC, bC, NC, nodes, weights, NN, nodeSub, rho_e, p_perp_e, rho_q, p_perp_q, n, k, theta_c],

  kill(varsC, bC),

  /* Load basis of dimensionality requested. */
  [varsC, bC] : loadBasis(basisFun, cdim, polyOrder),
  NC : length(bC),

  /* Gauss-Legendre nodes and weights of the (polyOrder+1)-point tensor rule. */
  [nodes, weights] : gaussOrdWeight(polyOrder+1, cdim),
  NN : length(nodes),

  printf(fh, "#include <gkyl_pkpm_vars_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH int ~a(const double *vlasov_pkpm_moms, double* GKYL_RESTRICT theta) ~%{ ~%", funcNm),
  printf(fh, "  // vlasov_pkpm_moms: Input [rho, p_parallel, p_perp, M1], moments computed from the kinetic equation. ~%"),
  printf(fh, "  // theta:            Output T_perp/m = p_perp/rho, evaluated at the ~a Gauss-Legendre nodes ~%", NN),
  printf(fh, "  //                   and interpolated to the p=~a basis. ~%", polyOrder),
  printf(fh, "  // Returns the number of nodes where rho <= 0 (theta is set to zero at such nodes). ~%"),
  printf(fh, " ~%"),

  printf(fh, "  const double *rho = &vlasov_pkpm_moms[~a]; ~%", 0),
  printf(fh, "  const double *p_perp = &vlasov_pkpm_moms[~a]; ~%", NC*2),
  printf(fh, " ~%"),

  rho_e : doExpand1(rho, bC),
  p_perp_e : doExpand1(p_perp, bC),

  printf(fh, "  double theta_n[~a] = {0.0}; ~%", NN),
  printf(fh, "  int num_null_rho = 0; ~%"),
  printf(fh, " ~%"),

  /* Evaluate rho and p_perp at each node, divide pointwise. */
  for n : 1 thru NN do (
    nodeSub : makelist(varsC[d]=nodes[n][d], d, 1, cdim),
    rho_q : float(expand(subst(nodeSub, rho_e))),
    p_perp_q : float(expand(subst(nodeSub, p_perp_e))),
    printf(fh, "  { ~%"),
    printf(fh, "    const double rho_q = ~a; ~%", rho_q),
    printf(fh, "    const double p_perp_q = ~a; ~%", p_perp_q),
    printf(fh, "    if (rho_q > 0.0) { ~%"),
    printf(fh, "      theta_n[~a] = p_perp_q/rho_q; ~%", n-1),
    printf(fh, "    } else { ~%"),
    printf(fh, "      num_null_rho += 1; ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "  } ~%")
  ),
  printf(fh, " ~%"),

  /* Quadrature projection onto the modal basis: c_k = sum_n w_n psi_k(x_n) theta(x_n). */
  theta_c : makelist(sum(weights[n]*subst(makelist(varsC[d]=nodes[n][d], d, 1, cdim), bC[k])*theta_n[n-1], n, 1, NN), k, 1, NC),
  writeCExprs1(theta, theta_c),
  printf(fh, " ~%"),

  printf(fh, "  return num_null_rho; ~%"),
  printf(fh, "} ~%")
)$
