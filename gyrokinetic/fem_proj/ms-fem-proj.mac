/* Generate kernels for the various elements of a direct
   solve of the weak equation
       weight_left * phi = weight_right * rho
   using the (continuous Galerkin) finite element method (FEM).
   Generate the header separately with ms-fem-proj-header.mac. */

load(stringproc)$
load("gyrokinetic/fem_proj/fem-proj.mac")$

/* ...... USER INPUTS........ */

/* Serendipity basis. 3D kernels are not generated yet. */
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
maxCdim_Ser : 2$

/* Output directory must exist. May be set before loading this script. */
if not stringp(fem_proj_out) then fem_proj_out : "~/max-out"$

/* ...... END OF USER INPUTS........ */

bName        : ["ser"]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

/* Node indexing, mass and source matrices, and nodal/modal transformations.
   Keep one C file per dimension and polynomial order. */
for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : 1 thru maxPolyOrder[bInd] do (
      funcName : sconcat("fem_proj_", c, "x_", bName[bInd], "_p", polyOrder),
      disp(printf(false, "Creating ~a.c", funcName)),
      fname : sconcat(fem_proj_out, "/", funcName, ".c"),
      fh    : openw(fname),
      printf(fh, "/* Generated by gkylcas/gyrokinetic/fem_proj/ms-fem-proj.mac. */~%"),
      printf(fh, "#include <gkyl_fem_proj_kernels.h>~%"),
      printf(fh, "~%"),
      /* Node counts and index mapping. */
      generate_fem_proj_num_nodes(fh, funcName, c, polyOrder),
      generate_fem_proj_local_to_global(fh, funcName, c, bName[bInd], polyOrder),

      /* Mass matrices and source vectors, with unity or DG weights. */
      for weighted in [false, true] do (
        generate_fem_proj_mass(fh, funcName, c, bName[bInd], polyOrder, weighted),
        generate_fem_proj_src(fh, funcName, c, bName[bInd], polyOrder, weighted)
      ),

      /* Solution reconstruction. */
      generate_fem_proj_sol(fh, funcName, c, bName[bInd], polyOrder),
      close(fh)
    )
  )
)$
