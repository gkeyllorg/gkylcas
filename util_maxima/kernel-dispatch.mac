/* Emit updater selection tables and CUDA call targets from one description.
   Each table is [C name, C element type, nested initializer]. Initializer leaves
   are C function names, "NULL", or dispatchIf("BUILD_FLAG", "kernel"); nested
   lists retain the C aggregate shape. Each optional kernel uses one build flag.
   No knowledge of basis, dimension, stencil, or BC indices is needed here. */
load(stringproc)$

/* dispatchIf("BUILD_FLAG", "kernel") is a conditional leaf, not a table index. */
dispatchConditionalP(entry) := not atom(entry) and not listp(entry)
  and op(entry) = 'dispatchIf$

/* Collect non-null function names from every level of the initializer. */
dispatchInitializerTargets(initializer) := block([targets : [], entry],
  if not listp(initializer) then (
    if dispatchConditionalP(initializer) then (
      if length(args(initializer)) # 2 or not every(stringp, args(initializer)) then
        error("Expected dispatchIf(build flag, kernel name)", initializer),
      return([initializer])
    ),
    if not stringp(initializer) then error("Expected a C function name or NULL", initializer),
    return(if initializer = "NULL" then [] else [initializer])
  ),

  for entry in initializer do
    targets : append(targets, dispatchInitializerTargets(entry)),

  targets
)$

/* Write a nested C initializer, preserving its shape and replacing conditional
   entries with their guarded kernel macros. */
writeDispatchInitializer(fh, initializer, indent, optional) := block([i, nested : false, entry],
  if dispatchConditionalP(initializer) then
    return(printf(fh, "~a_KERNEL", assoc(initializer, optional))),
  if not listp(initializer) then return(printf(fh, "~a", initializer)),

  /* Keep leaf rows on one line; indent nested aggregates. */
  for entry in initializer do if listp(entry) then nested : true,
  printf(fh, "{"),
  for i : 1 thru length(initializer) do (
    if nested then printf(fh, "~%~a  ", indent),
    writeDispatchInitializer(fh, initializer[i], sconcat(indent, "  "), optional),
    if i < length(initializer) then printf(fh, if nested then "," else ", ")
  ),
  if nested then printf(fh, "~%~a", indent),
  printf(fh, "}")
)$

/* Validate all families and return one deduplicated target list per family.
   Table and macro names must be unique across the entire header. */
dispatchFamiliesTargets(families) := block(
  [targets, names : [], macroNames : [], targetLists : [], family, table, entry, guardedNames],

  for family in families do (
    if length(family) # 2 then error("Expected [target macro, tables]", family),
    if member(family[1], macroNames) then error("Duplicate target macro", family[1]),
    macroNames : cons(family[1], macroNames),
    targets : [],
    for table in family[2] do (
      if length(table) # 3 then error("Expected [name, type, initializer]", table),
      if member(table[1], names) then error("Duplicate dispatch table", table[1]),
      names : cons(table[1], names),
      targets : append(targets, dispatchInitializerTargets(table[3]))
    ),

    targets : listify(setify(targets)),
    if targets = [] then error("An indirect call must have at least one target"),
    if sublist(targets, stringp) = [] then
      error("A callback family needs an unconditional target"),
    guardedNames : [],
    for entry in targets do if dispatchConditionalP(entry) then (
      if second(args(entry)) = "NULL" or member(second(args(entry)), guardedNames) then
        error("An optional kernel must be non-null and use one build flag", entry),
      guardedNames : cons(second(args(entry)), guardedNames)
    ),
    targetLists : endcons(targets, targetLists)
  ),
  if families = [] then error("Expected at least one callback family"),

  targetLists
)$

/* Emit one validated family: conditional macros, tables, and PTX targets. */
writeDispatchFamily(fh, family, targets) := block(
  [unconditional : sublist(targets, stringp), optional : [], table, entry, macroName, i],

  /* One guard controls both the table pointer and the PTX string fragment. */
  for entry in targets do if dispatchConditionalP(entry) then (
    macroName : sconcat(family[1], "_OPTIONAL_", length(optional) + 1),
    optional : endcons([entry, macroName], optional),
    printf(fh, "#ifdef ~a~%", first(args(entry))),
    printf(fh, "#define ~a_KERNEL ~a~%", macroName, second(args(entry))),
    printf(fh, "#define ~a ~a,~a~a~%", macroName, ascii(34), second(args(entry)), ascii(34)),
    printf(fh, "#else~%#define ~a_KERNEL NULL~%", macroName),
    printf(fh, "#define ~a ~a~a~%#endif~%~%", macroName, ascii(34), ascii(34))
  ),
  for table in family[2] do (
    printf(fh, "GKYL_CU_D static const ~a ~a[] = ", table[2], table[1]),
    writeDispatchInitializer(fh, table[3], "", optional),
    printf(fh, ";~%~%")
  ),

  /* Emit adjacent C strings: ASCII 34 is a quote, 92 a continuation backslash. */
  targets : unconditional,
  for entry in optional do (
    if not member(second(args(entry[1])), unconditional) then
      targets : endcons(entry[1], targets)
  ),
  printf(fh, "// Complete, deduplicated targets for this callback family.~%"),
  printf(fh, "#define ~a ~a~%", family[1], ascii(92)),
  for i : 1 thru length(targets) do (
    if dispatchConditionalP(targets[i]) then
      printf(fh, "  ~a", assoc(targets[i], optional))
    else printf(fh, "  ~a~a~a~a", ascii(34), if i = 1 then "" else ",", targets[i], ascii(34)),
    if i < length(targets) then printf(fh, " ~a", ascii(92)),
    printf(fh, "~%")
  )
)$

/* A family is [target macro, tables]. Families share a header, not a target list. */
writeKernelDispatchFamiliesHeader(filename, generator, families) := block([fh, targetLists, j],
  /* Validate every family before opening the output. */
  targetLists : dispatchFamiliesTargets(families),

  fh : openw(filename),
  printf(fh, "// Generated by gkylcas/~a. Do not edit.~%", generator),
  printf(fh, "// Include after the callback table types and kernel declarations.~%"),
  printf(fh, "#pragma once~%~%"),

  for j : 1 thru length(families) do (
    writeDispatchFamily(fh, families[j], targetLists[j]),
    if j < length(families) then printf(fh, "~%")
  ),

  close(fh)
)$

/* Preserve the single-family interface used by the other updaters. */
writeKernelDispatchHeader(filename, generator, targetMacro, tables) :=
  writeKernelDispatchFamiliesHeader(filename, generator, [[targetMacro, tables]])$
