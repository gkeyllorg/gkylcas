load("vlasov/dg_fluid/fluid-vars-positivity.mac")$
load(stringproc)$
/* This script generates the kernels fluid_vars_positivity_<c>x_ser_p1, the vertex
   positivity limiter of a fluid state [rho, M, E] (see fluid-vars-positivity.mac). */
for c : 1 thru 3 do (
  funcName : sconcat("fluid_vars_positivity_", c, "x_ser_p1"),
  disp(printf(false, "Creating ~a", funcName)),
  fh : openw(sconcat("~/max-out/", funcName, ".c")),
  calcFluidPositivity(fh, funcName, c, "ser", 1, false),
  close(fh)
)$
