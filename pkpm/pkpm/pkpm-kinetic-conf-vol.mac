/* pkpm-kinetic-conf-vol.mac --------------------------------------------------
   Streaming volume kernel of the configuration-space pass (stage A) of the factored,
   thermal-velocity normalized p=1 PKPM kinetic update. The evolved array is the eight blocks
   [F, G, M0_perp, N_perp] on the grid of w = v_par/xi; with the weak form
   integral(phi dF/dt) = + integral(grad phi . flux) - surface terms, the kernel increments out by

     streaming      integral( d_x phi . (xi w b + u) X )    (all eight blocks X, all conf directions)

   integrated exactly: xi b_d, a product of two p=1 fields, is formed once per cell in the tensor
   basis of degree <= 2 that contains it exactly (as the Vlasov kernels form their alpha), and the
   streaming of each block is then bilinear in it, u and X (one generated helper for all eight).
   Every known velocity-space term of the eight blocks (the w forces, the mirror and coupling
   terms and the sources, F and G included) is in the stored operator of the configuration cell
   and its volume kernel (pkpm-harm-ops.mac, pkpm-harm-vol.mac); the terms that depend on the
   closures belong to the velocity-space pass (stage B, pkpm-kinetic-vel-vol.mac). The streaming
   speeds are accumulated by the surface-flux updaters: the kernel returns 0. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("util_maxima/utilities.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-cas-util.mac")$
load(stringproc)$
fpprec : 24$

cvars : [x, y, z]$
dx1s : [dx10, dx11, dx12]$
/* Names of the eight blocks of the distribution array. */
kBlk : [F_0, G_1, M0x, M0y, M0z, Nx, Ny, Nz]$

calcPKPMKineticConfVol(fh, funcNm, cdim) := block(
  [lb, pkC, pkbC, pkV, pkP, pkbP, NC, NP, vTrans, b_e, u_e, xi_e, X_e, stream_X, clst, d, i, b2, n2, xb_e, xb_c],

  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), pkV : copylist(lb[3]),
  pkP : copylist(lb[5]), pkbP : copylist(lb[6]),
  NC : length(pkbC),
  NP : length(pkbP),
  b2 : pkpmP2Basis(pkC), n2 : length(b2),

  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%~%"),
  /* the streaming of one block: the same operator for all eight */
  printf(fh, "// Streaming volume term of one block X: out += integral( d_x phi . (xi b w + u) X ), with xb[d] the ~%"),
  printf(fh, "// exact degree <= 2 expansion of xi b_d (k0 + 3 k1 + 9 k2). ~%"),
  printf(fh, "GKYL_CU_DH static inline void ~a_block(const double *dx1, double wvpar, double dvpar, ~%", funcNm),
  printf(fh, "  const double *xb, const double *u, const double *X, double* GKYL_RESTRICT out) ~%{ ~%"),
  for d : 1 thru cdim do
    printf(fh, "  const double dx1~a = dx1[~a]; ~%", d-1, d-1),
  for d : 1 thru cdim do
    printf(fh, "  const double *xb~a = &xb[~a]; ~%", cvars[d], (d-1)*n2),
  printf(fh, "  const double *ux = &u[~a]; ~%", 0*NC),
  printf(fh, "  const double *uy = &u[~a]; ~%", 1*NC),
  printf(fh, "  const double *uz = &u[~a]; ~%", 2*NC),
  vTrans : vx*dvpar/2 + wvpar,
  xb_e : makelist(doExpand1(concat(xb, cvars[d]), b2), d, 1, cdim),
  u_e : [doExpand1(ux, pkbC), doExpand1(uy, pkbC), doExpand1(uz, pkbC)],
  clst : [dx10, dx11, dx12, dvpar, wvpar],
  X_e : doExpand1(X, pkbP),
  stream_X : 0,
  for d : 1 thru cdim do
    stream_X : stream_X + dx1s[d]*calcInnerProdList(pkP, 1, diff(pkbP, pkC[d]), (xb_e[d]*vTrans + u_e[d])*X_e),
  pkpmWriteIncrExprs(fh, out, stream_X, clst),
  printf(fh, "} ~%~%"),

  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv, const double *jacob_pos,
  const double *bvar, const double *u, const double *xi, const double *f, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:      Cell-center coordinates (computational). ~%"),
  printf(fh, "  // dxv[NDIM]:    Cell spacing (computational). ~%"),
  printf(fh, "  // jacob_pos:    Position-map Jacobian per configuration direction (cdim blocks of 2 equal ~%"),
  printf(fh, "  //               entries); the streaming divergence in direction d carries 1/J_d. ~%"),
  printf(fh, "  // bvar:         Magnetic field unit vector [bx, by, bz]. ~%"),
  printf(fh, "  // u:            Flow velocity [ux, uy, uz]. ~%"),
  printf(fh, "  // xi:           Thermal speed [xi, xi^2, p] (the first expansion is used). ~%"),
  printf(fh, "  // f:            Input Jacobian-weighted normalized distributions J [F, G, M0_perp, N_perp]. ~%"),
  printf(fh, "  // out:          Incremented output for J [F, G, M0_perp, N_perp]. ~%"),
  printf(fh, "  // Returns 0 (the streaming speeds are accumulated by the surface-flux updaters). ~%"),
  printf(fh, "  double dx1[~a]; ~%", cdim),
  for d : 1 thru cdim do
    printf(fh, "  dx1[~a] = 2.0/(dxv[~a]*jacob_pos[~a]); ~%", d-1, d-1, 2*(d-1)),
  printf(fh, "  const double *bx = &bvar[~a]; ~%", 0*NC),
  printf(fh, "  const double *by = &bvar[~a]; ~%", 1*NC),
  printf(fh, "  const double *bz = &bvar[~a]; ~%", 2*NC),
  printf(fh, "  const double *xi_1 = &xi[~a]; ~%", 0*NC),
  b_e : [doExpand1(bx, pkbC), doExpand1(by, pkbC), doExpand1(bz, pkbC)],
  xi_e : doExpand1(xi_1, pkbC),
  printf(fh, "  // xi b_d in the tensor basis of degree <= 2 (exact) ~%"),
  printf(fh, "  double xb[~a]; ~%", cdim*n2),
  for d : 1 thru cdim do (
    xb_c : calcInnerProdList(pkC, 1, b2, xi_e*b_e[d]),
    for i : 1 thru n2 do
      printf(fh, "  xb[~a] = ~a; ~%", (d-1)*n2 + i - 1, float(expand(xb_c[i])))
  ),
  printf(fh, "  for (int c = 0; c < 8; ++c) { ~%"),
  printf(fh, "    ~a_block(dx1, w[~a], dxv[~a], xb, u, &f[c*~a], &out[c*~a]); ~%", funcNm, cdim, cdim, NP, NP),
  printf(fh, "  } ~%"),
  printf(fh, "  return 0.0; ~%"),
  printf(fh, "} ~%")
)$
