/*
  Generate kernels for the surface projections of the 
  FPO diffusion tensor.
*/

load(stringproc);
load("vlasov/fpo/funcs-fpo-diff-coeff-surf.mac");


/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 2$ /* pure Serendipity p=1 is not supported for the FPO */
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
minVdim_Ser : 3$
maxCdim_Ser : 1$
maxVdim_Ser : 3$

/* Tensor product basis. */
/* Tensor p=1 IS the tensor hybrid basis: p=1 in configuration space and p=2 in
   velocity space. */
minPolyOrder_Tensor : 1$
maxPolyOrder_Tensor : 1$
minCdim_Tensor : 1$
minVdim_Tensor : 3$
maxCdim_Tensor : 2$
maxVdim_Tensor : 3$

/* ...... END OF USER INPUTS........ */

bName        : ["ser", "tensor"]$
minPolyOrder : [minPolyOrder_Ser, minPolyOrder_Tensor]$
maxPolyOrder : [maxPolyOrder_Ser, maxPolyOrder_Tensor]$
minCdim      : [minCdim_Ser, minCdim_Tensor]$
minVdim      : [minVdim_Ser, minVdim_Tensor]$
maxCdim      : [maxCdim_Ser, maxCdim_Tensor]$
maxVdim      : [maxVdim_Ser, maxVdim_Tensor]$

dirs : [vx, vy, vz]$

for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for vidx : 1 thru length(dirs) do (
      dir : dirs[vidx],

      minPolyOrderB : minPolyOrder[bInd],
      maxPolyOrderB : maxPolyOrder[bInd],
      if (c>1 and bName[bInd] = "ser") then maxPolyOrderB : 1, 
      for polyOrder : minPolyOrderB thru maxPolyOrderB do (
        fname : sconcat("~/max-out/fpo_diff_coeff_surf_",c,"x3v_",bName[bInd],"_p",polyOrder,"_",dir,".c"),
        funcNm : sconcat("fpo_diff_coeff_surf_",c,"x3v_",dir, "_", bName[bInd],"_p",polyOrder),
        generateFpoDiffCoeffSurf(fname, funcNm, c, bName[bInd], polyOrder, dir)
      )
    )
  )
)$


