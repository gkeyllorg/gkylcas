/* pkpm-vars-closure.mac ---------------------------------------------------------
   Closures of the thermal-velocity-normalized (p=1) PKPM kinetic update with the first Fourier
   harmonic, with the characteristic velocity-space edges. The evolved distributions are the eight
   blocks U = [F, G, M0_perp (x, y, z), N_perp (x, y, z)] on the grid of w = v_par/xi, with the
   per-cell constraints (weakly, for every p=1 test function)

     M0(F) = 1,   M1(F) = 0,   M2(F) + 2 M0(G) = 3,   I_perp int M0_perp dw = 0.

   Stage A produces the partial right-hand sides rhs_A (streaming, known forces and sources; not
   the closure terms). Stage B adds (pkpm-kinetic-vel-vol.mac)

     c_0 U                          normalization (c_0 = div u in the continuum), every block
     -d_w(alpha_0 U)                pressure force, alpha_0 = a_P/xi, every block
     -d_w(c w U) + k c U            heating rate, k = 0, 2, 1, 3 for F, G, M0_perp, N_perp
     a_perp F, a_perp . M0, 2 G a_perp   perpendicular force (M0_perp, G, N_perp sources)

   and the fluxes through the two velocity-domain edges w_lo, w_up: the HLL flux of the full w flux
   alpha U + T(U) (alpha = alpha_0 + (c - K) w - (b.grad xi) w^2, T the coupling by beta, t, R_B1)
   against an empty exterior, from the w-flux entries of the stored operator (pkpm_ho_wslot of
   gkyl_pkpm_harm_ops.h, in the node layout of gkyl_pkpm_harm_slots.h)
   evaluated at the closure nodes and the node functions of gkyl_pkpm_harm_coeffs.h (the same as
   the w-face kernels'), with the speeds S_L, S_R = alpha + the bounds of T's spectrum taken from
   the closures of the PREVIOUS stage, so that the edge flux

     Phi_e = wf_e (alpha_e U_e + T_e(U_e)) + wu_e U_e

   is linear in the unknowns (upper edge: wf = 1, wu = 0 when S_L > 0 (outflow); wf = wu = 0 when
   S_R <= 0; otherwise wf = S_R/(S_R - S_L), wu = -S_L S_R/(S_R - S_L); the lower edge mirrored).
   The interior velocity faces telescope, so with N = [M0, M2, M0G, M1, ..., mu] of the state,
   R = [r0, r2, r0G, r1, ..., rho_M] of rhs_A (mu = int M0_perp dw, rho_M its rate), the edge
   traces, sgn_e = +1 (lower) / -1 (upper), and k_e = -K w_e - (b.grad xi) w_e^2 the known part of
   alpha at the edge, the four constraint rows are a linear system per node for
   (c_0, alpha_0, c, a_perp):

     M0:  c_0 M0 + alpha_0 eF0 + c eF1 = -r0 - kF0 - xF0
     M1:  c_0 M1 + alpha_0 (M0 + eF1) + c (M1 + eF2) = -r1 - kF1 - xF1
     E :  c_0 s2 + alpha_0 (2 M1 + eF2 + 2 eG0) + c (2 s2 + eF3 + 2 eG1) + 2 mu . a_perp
          = -(r2 + 2 r0G) - kF2 - 2 kG0 - xF2 - 2 xG0,   s2 = M2 + 2 M0G
     perp: M0 a_perp + (c_0 + c) Q + alpha_0 A_a + c A_c = -P

   with eX_k = sum_e sgn_e wf_e w_e^k X_e, kX_k = sum_e sgn_e wf_e w_e^k k_e X_e,
   xX_k = sum_e sgn_e w_e^k (wf_e T_X,e + wu_e X_e), Q = I_perp mu, A_a = I_perp sum_e sgn_e wf_e M0_e,
   A_c = I_perp sum_e sgn_e wf_e w_e M0_e and P = I_perp (rho_M + sum_e sgn_e (wf_e (k_e M0_e + T_M0,e)
   + wu_e M0_e)) (b is a unit vector at the closure nodes). The perpendicular rows are eliminated
   into the energy row (Schur complement: the energy row gains -(2/M0) Q.(P + (c_0 + c) Q + alpha_0
   A_a + c A_c)), the 3x3 is solved by Cramer's rule at the 2^cdim Gauss-Legendre nodes, a_perp
   follows, and everything is interpolated to p=1; the edge fluxes of all eight blocks are then
   formed from the SAME closures and written in the stored face format of the velocity-flux kernels
   (shape coefficients: orthonormal surface coefficients divided by sqrt(1/2)^cdim
   (2 sqrt 3/5)^(linear factors of the mode)), so that what the velocity pass applies at the edges
   is exactly what the closure charged. On the constraint manifold (mu = 0) the system is block
   diagonal; where the distribution does not reach the edges all edge terms vanish.

   Policy: if M0(F) <= 0 or the determinant is not positive at any node, all closures and the edge
   fluxes are zero in the cell and the kernel returns the number of such nodes. cfl[0], cfl[1]
   receive the time-step rates of the edge fluxes for the lowest and uppermost velocity cells,
   (2 p_v + 1)/2 dv1 max_n(|S_L|, |S_R|) with the current closures. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-cas-util.mac")$
load("pkpm/pkpm/pkpm-harm-ops.mac")$
load(stringproc)$
fpprec : 24$

cvarsClo : [x, y, z]$

calcPKPMVarsClosure(fh, funcNm, cdim, basisFun, polyOrder) := block(
  [lb, pkC, pkbC, pkP, pkbP, NC, NP, nodes, weights, NN, nodeSub, n, k, d, i, j, c, nlin,
   n0_e, n1_e, n2_e, nG_e, r0_e, r1_e, r2_e, rG_e, mu_e, rM_e, a0p_e, cp_e, th_e, b_e,
   Ulo_e, Uup_e, c0_c, a0_c, c_c, ap_c, fl_c, fu_c, sc, lst, bP2, n2, wslot_e, s, wsl],

  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), pkP : copylist(lb[5]), pkbP : copylist(lb[6]),
  NC : length(pkbC),
  NP : length(pkbP),
  [nodes, weights] : gaussOrdWeight(2, cdim),
  NN : length(nodes),
  nlin : makelist(length(listofvars(pkbC[k])), k, 1, NC),

  printf(fh, "#include <gkyl_pkpm_vars_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%"),
  printf(fh, "GKYL_CU_DH int ~a(double w_lo, double w_up, double dv, const double *norm_moms, const double *rhs_moms,
  const double *bvar, const double *coef, const double *theta, const double *alpha_0_prev, const double *c_h_prev,
  const double *f_lo, const double *f_up,
  double* GKYL_RESTRICT c_0, double* GKYL_RESTRICT alpha_0, double* GKYL_RESTRICT c_h, double* GKYL_RESTRICT a_perp,
  double* GKYL_RESTRICT flux_lo, double* GKYL_RESTRICT flux_up, double* GKYL_RESTRICT cfl,
  double* GKYL_RESTRICT cond) ~%{ ~%", funcNm),
  printf(fh, "  // w_lo, w_up:   Velocity domain edges; dv: velocity cell size. ~%"),
  printf(fh, "  // norm_moms:    Input [M0, M2, M0_G, M1, M3, M1_G, mu (x, y, z)] moments of the normalized distributions (stage state). ~%"),
  printf(fh, "  // rhs_moms:     Input moments of the stage-A right-hand sides, same layout. ~%"),
  printf(fh, "  // bvar:         Magnetic field unit vector [bx, by, bz]. ~%"),
  printf(fh, "  // coef:         Stored operator of the cell (gkyl_pkpm_harm_ops.h). ~%"),
  printf(fh, "  // theta:        T_perp/T. ~%"),
  printf(fh, "  // alpha_0_prev, c_h_prev: closures of the previous stage (may alias the outputs), for the edge speeds. ~%"),
  printf(fh, "  // f_lo, f_up:   [F, G, M0_perp, N_perp] of the lowest and uppermost velocity cells of this configuration cell. ~%"),
  printf(fh, "  // c_0, alpha_0, c_h, a_perp: Output closures at the ~a Gauss-Legendre nodes, interpolated to p=1. ~%", NN),
  printf(fh, "  // flux_lo, flux_up: Output edge fluxes [8 blocks] in the stored face format. ~%"),
  printf(fh, "  // cfl:          Output [lower, upper] edge-flux time-step rates. ~%"),
  printf(fh, "  // cond:         Output [1]: the smallest determinant of the 3x3 system over the nodes relative to ~%"),
  printf(fh, "  //               its edge-free value (1 when the edge terms vanish; small or negative when the ~%"),
  printf(fh, "  //               velocity-domain edges carry a non-negligible trace: too small velocity extents). ~%"),
  printf(fh, "  // Returns the number of nodes where the closures are undefined (everything is zero in the cell then). ~%"),
  printf(fh, " ~%"),
  printf(fh, "  const double dv1 = 2.0/dv; ~%"),
  printf(fh, "  const double *n0 = &norm_moms[~a]; ~%", 0*NC),
  printf(fh, "  const double *n2 = &norm_moms[~a]; ~%", 1*NC),
  printf(fh, "  const double *nG = &norm_moms[~a]; ~%", 2*NC),
  printf(fh, "  const double *n1 = &norm_moms[~a]; ~%", 3*NC),
  printf(fh, "  const double *r0 = &rhs_moms[~a]; ~%", 0*NC),
  printf(fh, "  const double *r2 = &rhs_moms[~a]; ~%", 1*NC),
  printf(fh, "  const double *rG = &rhs_moms[~a]; ~%", 2*NC),
  printf(fh, "  const double *r1 = &rhs_moms[~a]; ~%", 3*NC),
  for i : 1 thru 3 do printf(fh, "  const double *mu~a = &norm_moms[~a]; ~%", i-1, (5+i)*NC),
  for i : 1 thru 3 do printf(fh, "  const double *rM~a = &rhs_moms[~a]; ~%", i-1, (5+i)*NC),
  for i : 1 thru 3 do printf(fh, "  const double *b~a = &bvar[~a]; ~%", i-1, (i-1)*NC),
  for c : 1 thru 8 do printf(fh, "  const double *lo~a = &f_lo[~a], *up~a = &f_up[~a]; ~%", c-1, (c-1)*NP, c-1, (c-1)*NP),
  printf(fh, " ~%"),

  n0_e : doExpand1(n0, pkbC), n1_e : doExpand1(n1, pkbC), n2_e : doExpand1(n2, pkbC), nG_e : doExpand1(nG, pkbC),
  r0_e : doExpand1(r0, pkbC), r1_e : doExpand1(r1, pkbC), r2_e : doExpand1(r2, pkbC), rG_e : doExpand1(rG, pkbC),
  mu_e : makelist(doExpand1(concat(mu, i-1), pkbC), i, 1, 3),
  rM_e : makelist(doExpand1(concat(rM, i-1), pkbC), i, 1, 3),
  a0p_e : doExpand1(alpha_0_prev, pkbC), cp_e : doExpand1(c_h_prev, pkbC),
  th_e : doExpand1(theta, pkbC),
  b_e : makelist(doExpand1(concat(b, i-1), pkbC), i, 1, 3),
  /* the w-flux slots of the stored coefficients as expansions in the degree <= 2 tensor basis */
  bP2 : pkpmP2Basis(pkC), n2 : length(bP2),
  /* the w-flux slots are entries of the stored operator (pkpmHarmWslots, gkyl_pkpm_harm_ops.h) */
  wsl : pkpmHarmWslots(),
  wslot_e : makelist(sum(coef[wsl[s]*n2 + k-1]*bP2[k], k, 1, n2), s, 1, 62),
  Ulo_e : makelist(subst(vx = -1, doExpand1(concat(lo, c-1), pkbP)), c, 1, 8),
  Uup_e : makelist(subst(vx = 1, doExpand1(concat(up, c-1), pkbP)), c, 1, 8),

  printf(fh, "  double c0_n[~a] = {0.0}, a0_n[~a] = {0.0}, c_n[~a] = {0.0}; ~%", NN, NN, NN),
  printf(fh, "  double ap_n[3][~a] = {{0.0}}, flo_n[8][~a] = {{0.0}}, fup_n[8][~a] = {{0.0}}; ~%", NN, NN, NN),
  printf(fh, "  double cfl_lo = 0.0, cfl_up = 0.0; ~%"),
  printf(fh, "  int num_null = 0; ~%"),
  printf(fh, "  double cond_min = 1.0; ~%"),
  printf(fh, " ~%"),
  for n : 1 thru NN do (
    nodeSub : makelist(pkC[d]=nodes[n][d], d, 1, cdim),
    printf(fh, "  { ~%"),
    printf(fh, "    const double n0_q = ~a; ~%", float(expand(subst(nodeSub, n0_e)))),
    printf(fh, "    const double n1_q = ~a; ~%", float(expand(subst(nodeSub, n1_e)))),
    printf(fh, "    const double n2_q = ~a; ~%", float(expand(subst(nodeSub, n2_e)))),
    printf(fh, "    const double nG_q = ~a; ~%", float(expand(subst(nodeSub, nG_e)))),
    printf(fh, "    const double r0_q = ~a; ~%", float(expand(subst(nodeSub, r0_e)))),
    printf(fh, "    const double r1_q = ~a; ~%", float(expand(subst(nodeSub, r1_e)))),
    printf(fh, "    const double r2_q = ~a + 2.0*(~a); ~%", float(expand(subst(nodeSub, r2_e))), float(expand(subst(nodeSub, rG_e)))),
    printf(fh, "    const double mu_q[3] = {~a, ~a, ~a}; ~%", float(expand(subst(nodeSub, mu_e[1]))), float(expand(subst(nodeSub, mu_e[2]))), float(expand(subst(nodeSub, mu_e[3])))),
    printf(fh, "    const double rM_q[3] = {~a, ~a, ~a}; ~%", float(expand(subst(nodeSub, rM_e[1]))), float(expand(subst(nodeSub, rM_e[2]))), float(expand(subst(nodeSub, rM_e[3])))),
    printf(fh, "    const double a0p_q = ~a; ~%", float(expand(subst(nodeSub, a0p_e)))),
    printf(fh, "    const double cp_q = ~a; ~%", float(expand(subst(nodeSub, cp_e)))),
    printf(fh, "    const double th_q = ~a; ~%", float(expand(subst(nodeSub, th_e)))),
    for i : 1 thru 3 do
      printf(fh, "    const double b~a_q = ~a; ~%", i-1, float(expand(subst(nodeSub, b_e[i])))),
    printf(fh, "    const double Ulo_q[8] = {~a", float(expand(subst(nodeSub, Ulo_e[1])))),
    for c : 2 thru 8 do printf(fh, ", ~a", float(expand(subst(nodeSub, Ulo_e[c])))),
    printf(fh, "}; ~%"),
    printf(fh, "    const double Uup_q[8] = {~a", float(expand(subst(nodeSub, Uup_e[1])))),
    for c : 2 thru 8 do printf(fh, ", ~a", float(expand(subst(nodeSub, Uup_e[c])))),
    printf(fh, "}; ~%"),
    printf(fh, "    const double Flo_q = Ulo_q[0], Glo_q = Ulo_q[1], Fup_q = Uup_q[0], Gup_q = Uup_q[1]; ~%"),
    printf(fh, "    const double b_q[3] = {b0_q, b1_q, b2_q}; ~%"),
    printf(fh, "    // node values of the w flux (the stored coefficients at the node, theta, b and the previous ~%"),
    printf(fh, "    // closures): coupling flux T, its speed bounds and the known part of alpha at the edges ~%"),
    printf(fh, "    double nv[PKPM_HS_NODE_NV]; ~%"),
    for k : 1 thru 62 do
      printf(fh, "    nv[~a] = ~a; ~%", k-1, float(expand(subst(nodeSub, wslot_e[k])))),
    printf(fh, "    nv[PKPM_HS_NODE_THETA] = th_q; ~%"),
    printf(fh, "    nv[PKPM_HS_NODE_B] = b0_q; nv[PKPM_HS_NODE_B + 1] = b1_q; nv[PKPM_HS_NODE_B + 2] = b2_q; ~%"),
    printf(fh, "    nv[PKPM_HS_NODE_A0] = a0p_q; nv[PKPM_HS_NODE_CH] = cp_q; ~%"),
    printf(fh, "    double Tlo[8], Tup[8], llo_lo, lhi_lo, llo_up, lhi_up; ~%"),
    printf(fh, "    pkpm_harm_node_coupling(nv, w_lo, Ulo_q, Tlo); ~%"),
    printf(fh, "    pkpm_harm_node_coupling(nv, w_up, Uup_q, Tup); ~%"),
    printf(fh, "    pkpm_harm_node_bounds(nv, w_lo, &llo_lo, &lhi_lo); ~%"),
    printf(fh, "    pkpm_harm_node_bounds(nv, w_up, &llo_up, &lhi_up); ~%"),
    printf(fh, "    // known part of alpha at the edges, and the HLL weights against the empty exterior from the ~%"),
    printf(fh, "    // previous closures: edge flux = wf (alpha U + T(U)) + wu U ~%"),
    printf(fh, "    const double k_lo = pkpm_harm_node_alpha_k(nv, w_lo), k_up = pkpm_harm_node_alpha_k(nv, w_up); ~%"),
    printf(fh, "    const double ap_lo = a0p_q + cp_q*w_lo + k_lo, ap_up = a0p_q + cp_q*w_up + k_up; ~%"),
    printf(fh, "    double wf_lo = 0.0, wu_lo = 0.0, wf_up = 0.0, wu_up = 0.0; ~%"),
    printf(fh, "    { ~%"),
    printf(fh, "      const double sl = ap_lo + llo_lo, sr = ap_lo + lhi_lo; ~%"),
    printf(fh, "      if (sr < 0.0) { ~%"),
    printf(fh, "        wf_lo = 1.0; ~%"),
    printf(fh, "      } else if (sl < 0.0) { ~%"),
    printf(fh, "        wf_lo = -sl/(sr - sl); wu_lo = sl*sr/(sr - sl); ~%"),
    printf(fh, "      } ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "    { ~%"),
    printf(fh, "      const double sl = ap_up + llo_up, sr = ap_up + lhi_up; ~%"),
    printf(fh, "      if (sl > 0.0) { ~%"),
    printf(fh, "        wf_up = 1.0; ~%"),
    printf(fh, "      } else if (sr > 0.0) { ~%"),
    printf(fh, "        wf_up = sr/(sr - sl); wu_up = -sl*sr/(sr - sl); ~%"),
    printf(fh, "      } ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "    // edge contributions to the moment rates: the k-th moment gains sgn_e w_e^k Phi_e per edge, ~%"),
    printf(fh, "    // sgn_e = +1 lo, -1 up: closure part (alpha_0 + c w_e) wf_e U_e, known part kU (k_e wf_e U_e) and ~%"),
    printf(fh, "    // x (coupling and HLL terms wf_e T_e + wu_e U_e) ~%"),
    printf(fh, "    const double eF0 = wf_lo*Flo_q - wf_up*Fup_q; ~%"),
    printf(fh, "    const double eF1 = wf_lo*w_lo*Flo_q - wf_up*w_up*Fup_q; ~%"),
    printf(fh, "    const double eF2 = wf_lo*w_lo*w_lo*Flo_q - wf_up*w_up*w_up*Fup_q; ~%"),
    printf(fh, "    const double eF3 = wf_lo*w_lo*w_lo*w_lo*Flo_q - wf_up*w_up*w_up*w_up*Fup_q; ~%"),
    printf(fh, "    const double eG0 = wf_lo*Glo_q - wf_up*Gup_q; ~%"),
    printf(fh, "    const double eG1 = wf_lo*w_lo*Glo_q - wf_up*w_up*Gup_q; ~%"),
    printf(fh, "    const double kF0 = wf_lo*k_lo*Flo_q - wf_up*k_up*Fup_q; ~%"),
    printf(fh, "    const double kF1 = wf_lo*w_lo*k_lo*Flo_q - wf_up*w_up*k_up*Fup_q; ~%"),
    printf(fh, "    const double kF2 = wf_lo*w_lo*w_lo*k_lo*Flo_q - wf_up*w_up*w_up*k_up*Fup_q; ~%"),
    printf(fh, "    const double kG0 = wf_lo*k_lo*Glo_q - wf_up*k_up*Gup_q; ~%"),
    printf(fh, "    double xlo[8], xup[8]; ~%"),
    printf(fh, "    for (int c = 0; c < 8; ++c) { ~%"),
    printf(fh, "      xlo[c] = wf_lo*Tlo[c] + wu_lo*Ulo_q[c]; ~%"),
    printf(fh, "      xup[c] = wf_up*Tup[c] + wu_up*Uup_q[c]; ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "    const double xF0 = xlo[0] - xup[0]; ~%"),
    printf(fh, "    const double xF1 = w_lo*xlo[0] - w_up*xup[0]; ~%"),
    printf(fh, "    const double xF2 = w_lo*w_lo*xlo[0] - w_up*w_up*xup[0]; ~%"),
    printf(fh, "    const double xG0 = xlo[1] - xup[1]; ~%"),
    printf(fh, "    // perpendicular rows M0 a_perp + (c_0 + c) Q + alpha_0 A_a + c A_c = -P (b is a unit vector here) ~%"),
    printf(fh, "    double P[3], Q[3], Aa[3], Ac[3], v[3]; ~%"),
    printf(fh, "    for (int a = 0; a < 3; ++a) ~%"),
    printf(fh, "      v[a] = rM_q[a] + (wf_lo*k_lo*Ulo_q[2 + a] + xlo[2 + a]) - (wf_up*k_up*Uup_q[2 + a] + xup[2 + a]); ~%"),
    printf(fh, "    pkpm_harm_perp(b_q, v, P); ~%"),
    printf(fh, "    pkpm_harm_perp(b_q, mu_q, Q); ~%"),
    printf(fh, "    for (int a = 0; a < 3; ++a) v[a] = wf_lo*Ulo_q[2 + a] - wf_up*Uup_q[2 + a]; ~%"),
    printf(fh, "    pkpm_harm_perp(b_q, v, Aa); ~%"),
    printf(fh, "    for (int a = 0; a < 3; ++a) v[a] = wf_lo*w_lo*Ulo_q[2 + a] - wf_up*w_up*Uup_q[2 + a]; ~%"),
    printf(fh, "    pkpm_harm_perp(b_q, v, Ac); ~%"),
    printf(fh, "    // eliminated into the energy row, which carries 2 mu . a_perp (Schur complement) ~%"),
    printf(fh, "    const double fac = n0_q > 0.0 ? 2.0/n0_q : 0.0; ~%"),
    printf(fh, "    const double sQQ = pkpm_harm_dot(Q, Q), sQP = pkpm_harm_dot(Q, P), sQA = pkpm_harm_dot(Q, Aa), sQC = pkpm_harm_dot(Q, Ac); ~%"),
    printf(fh, "    // 3x3 system A [c_0, alpha_0, c] = rhs: stage-A rates + interior stage-B rates + edge rates = 0 ~%"),
    printf(fh, "    const double A00 = n0_q, A01 = eF0, A02 = eF1; ~%"),
    printf(fh, "    const double A10 = n1_q, A11 = n0_q + eF1, A12 = n1_q + eF2; ~%"),
    printf(fh, "    const double A20 = n2_q + 2.0*nG_q - fac*sQQ, A21 = 2.0*n1_q + eF2 + 2.0*eG0 - fac*sQA, A22 = 2.0*(n2_q + 2.0*nG_q) + eF3 + 2.0*eG1 - fac*(sQQ + sQC); ~%"),
    printf(fh, "    const double b0 = -r0_q - kF0 - xF0, b1 = -r1_q - kF1 - xF1, b2 = -r2_q - kF2 - 2.0*kG0 - xF2 - 2.0*xG0 + fac*sQP; ~%"),
    printf(fh, "    const double det = A00*(A11*A22 - A12*A21) - A01*(A10*A22 - A12*A20) + A02*(A10*A21 - A11*A20); ~%"),
    printf(fh, "    // conditioning proxy: the determinant relative to its edge-free value ~%"),
    printf(fh, "    // n0 (2 n0 (M2 + 2 M0G) - 2 M1^2) (positive for admissible moments); a small or negative ~%"),
    printf(fh, "    // ratio means the traces at the velocity-domain edges are not small ~%"),
    printf(fh, "    const double det0 = n0_q*(2.0*n0_q*(n2_q + 2.0*nG_q) - 2.0*n1_q*n1_q); ~%"),
    printf(fh, "    if (det0 > 0.0) cond_min = fmin(cond_min, det/det0); ~%"),
    printf(fh, "    if (n0_q > 0.0 && det > 0.0) { ~%"),
    printf(fh, "      c0_n[~a] = (b0*(A11*A22 - A12*A21) - A01*(b1*A22 - A12*b2) + A02*(b1*A21 - A11*b2))/det; ~%", n-1),
    printf(fh, "      a0_n[~a] = (A00*(b1*A22 - A12*b2) - b0*(A10*A22 - A12*A20) + A02*(A10*b2 - b1*A20))/det; ~%", n-1),
    printf(fh, "      c_n[~a] = (A00*(A11*b2 - b1*A21) - A01*(A10*b2 - b1*A20) + b0*(A10*A21 - A11*A20))/det; ~%", n-1),
    printf(fh, "      for (int a = 0; a < 3; ++a) ~%"),
    printf(fh, "        ap_n[a][~a] = -(P[a] + (c0_n[~a] + c_n[~a])*Q[a] + Aa[a]*a0_n[~a] + Ac[a]*c_n[~a])/n0_q; ~%", n-1, n-1, n-1, n-1, n-1),
    printf(fh, "      const double al_lo = a0_n[~a] + c_n[~a]*w_lo + k_lo, al_up = a0_n[~a] + c_n[~a]*w_up + k_up; ~%", n-1, n-1, n-1, n-1),
    printf(fh, "      for (int c = 0; c < 8; ++c) { ~%"),
    printf(fh, "        flo_n[c][~a] = wf_lo*al_lo*Ulo_q[c] + xlo[c]; ~%", n-1),
    printf(fh, "        fup_n[c][~a] = wf_up*al_up*Uup_q[c] + xup[c]; ~%", n-1),
    printf(fh, "      } ~%"),
    printf(fh, "      cfl_lo = fmax(cfl_lo, fmax(fabs(al_lo + llo_lo), fabs(al_lo + lhi_lo))); ~%"),
    printf(fh, "      cfl_up = fmax(cfl_up, fmax(fabs(al_up + llo_up), fabs(al_up + lhi_up))); ~%"),
    printf(fh, "    } else { ~%"),
    printf(fh, "      num_null += 1; ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "  } ~%")
  ),
  printf(fh, " ~%"),
  printf(fh, "  cfl[0] = 2.5*dv1*cfl_lo; ~%"),
  printf(fh, "  cfl[1] = 2.5*dv1*cfl_up; ~%"),
  printf(fh, "  cond[0] = cond_min; ~%"),
  printf(fh, "  if (num_null > 0) { ~%"),
  printf(fh, "    // a node with M0 <= 0 or a non-positive determinant zeroes everything in the cell, its ~%"),
  printf(fh, "    // CFL rate included (the closures it would have needed are not applied) ~%"),
  printf(fh, "    cfl[0] = 0.0; cfl[1] = 0.0; ~%"),
  printf(fh, "    for (int k = 0; k < ~a; ++k) { ~%", NC),
  printf(fh, "      c_0[k] = 0.0; alpha_0[k] = 0.0; c_h[k] = 0.0; ~%"),
  printf(fh, "    } ~%"),
  printf(fh, "    for (int k = 0; k < ~a; ++k) { ~%", 3*NC),
  printf(fh, "      a_perp[k] = 0.0; ~%"),
  printf(fh, "    } ~%"),
  printf(fh, "    for (int k = 0; k < ~a; ++k) { ~%", 8*NC),
  printf(fh, "      flux_lo[k] = 0.0; flux_up[k] = 0.0; ~%"),
  printf(fh, "    } ~%"),
  printf(fh, "    return num_null; ~%"),
  printf(fh, "  } ~%"),
  printf(fh, " ~%"),

  /* nodal -> modal (2-point rule, exact for p=1) for the closures; the edge fluxes in the
     stored face format (orthonormal coefficient / shape factor). */
  c0_c : makelist(sum(weights[n]*subst(makelist(pkC[d]=nodes[n][d], d, 1, cdim), pkbC[k])*c0_n[n-1], n, 1, NN), k, 1, NC),
  a0_c : makelist(sum(weights[n]*subst(makelist(pkC[d]=nodes[n][d], d, 1, cdim), pkbC[k])*a0_n[n-1], n, 1, NN), k, 1, NC),
  c_c : makelist(sum(weights[n]*subst(makelist(pkC[d]=nodes[n][d], d, 1, cdim), pkbC[k])*c_n[n-1], n, 1, NN), k, 1, NC),
  writeCExprs1(c_0, c0_c),
  writeCExprs1(alpha_0, a0_c),
  writeCExprs1(c_h, c_c),
  printf(fh, " ~%"),
  /* The nodal-to-modal maps of a_perp and of the fluxes as loops over the components. */
  printf(fh, "  for (int a = 0; a < 3; ++a) { ~%"),
  for k : 1 thru NC do (
    printf(fh, "    a_perp[a*~a + ~a] = ", NC, k-1),
    lst : makelist(float(weights[n]*subst(makelist(pkC[d]=nodes[n][d], d, 1, cdim), pkbC[k])), n, 1, NN),
    for n : 1 thru NN do printf(fh, "~a(~a)*ap_n[a][~a]", if n > 1 then " + " else "", lst[n], n-1),
    printf(fh, "; ~%")
  ),
  printf(fh, "  } ~%"),
  sc : makelist(sqrt(2)^cdim*(5/(2*sqrt(3)))^nlin[k], k, 1, NC),
  printf(fh, "  for (int c = 0; c < 8; ++c) { ~%"),
  for k : 1 thru NC do (
    lst : makelist(float(sc[k]*weights[n]*subst(makelist(pkC[d]=nodes[n][d], d, 1, cdim), pkbC[k])), n, 1, NN),
    printf(fh, "    flux_lo[c*~a + ~a] = ", NC, k-1),
    for n : 1 thru NN do printf(fh, "~a(~a)*flo_n[c][~a]", if n > 1 then " + " else "", lst[n], n-1),
    printf(fh, "; ~%"),
    printf(fh, "    flux_up[c*~a + ~a] = ", NC, k-1),
    for n : 1 thru NN do printf(fh, "~a(~a)*fup_n[c][~a]", if n > 1 then " + " else "", lst[n], n-1),
    printf(fh, "; ~%")
  ),
  printf(fh, "  } ~%"),
  printf(fh, " ~%"),
  printf(fh, "  return 0; ~%"),
  printf(fh, "} ~%")
)$
