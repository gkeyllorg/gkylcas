load("conf_diffusion/conf_diffusion-surf.mac")$

/* Directional configuration-space targets: 1x-3x serendipity p1. */
dirName : ["x","y","z"]$
for cdim : 1 thru 3 do (
  for dir : 1 thru cdim do (
    fname : sconcat("~/max-out/conf_diffusion_surf",dirName[dir],"_",
      cdim,"x_ser_p1.c"),
    fh : openw(fname),
    printf(fh, "#include <gkyl_conf_diffusion_kernels.h>~%~%"),
    for derivDir : 1 thru cdim do (
      funcName : sconcat("conf_diffusion_surf",dirName[dir],
        dirName[derivDir],"_",cdim,"x_ser_p1"),
      conf_diffusion_gen_surf_ker(fh,funcName,cdim,"ser",1,dir,derivDir)
    ),
    close(fh),
    fname : sconcat("~/max-out/conf_diffusion_boundary_surf",dirName[dir],"_",
      cdim,"x_ser_p1.c"),
    fh : openw(fname),
    printf(fh, "#include <gkyl_conf_diffusion_kernels.h>~%~%"),
    for derivDir : 1 thru cdim do (
      funcName : sconcat("conf_diffusion_boundary_surf",dirName[dir],
        dirName[derivDir],"_",cdim,"x_ser_p1"),
      conf_diffusion_gen_boundary_surf_ker(fh,funcName,cdim,"ser",1,dir,
        derivDir)
    ),
    close(fh)
  )
)$
