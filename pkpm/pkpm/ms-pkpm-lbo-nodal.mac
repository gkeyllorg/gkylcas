/* Generate the kernels of the PKPM Lenard Bernstein operator at one configuration-space node
   (gkyl_lbo_pkpm_nodal_kernels.h and one file per kernel). */
load("pkpm/pkpm/pkpm-lbo-nodal.mac")$

fhh : openw("~/max-out/gkyl_lbo_pkpm_nodal_kernels.h")$
printf(fhh, "#pragma once ~%~%")$
printf(fhh, "// Generated (gkylcas/pkpm/pkpm/pkpm-lbo-nodal.mac): the Lenard Bernstein operator of the PKPM ~%")$
printf(fhh, "// distributions at one configuration-space node, in the parallel velocity alone (p=2). ~%")$
printf(fhh, "#include <gkyl_util.h> ~%~%")$
printf(fhh, "EXTERN_C_BEG ~%~%")$

nm : "lbo_pkpm_nodal_vol_1v_p2"$
fh : openw(sconcat("~/max-out/", nm, ".c"))$
printf(fh, "#include <gkyl_lbo_pkpm_nodal_kernels.h> ~%")$
pkpmLBONodalVol(fh, nm)$
close(fh)$
printf(fhh, "GKYL_CU_DH void ~a(~a, const double *f, double* GKYL_RESTRICT out); ~%", nm, pkpmLBONodalArgs)$

nm : "lbo_pkpm_nodal_surfvpar_1v_p2"$
fh : openw(sconcat("~/max-out/", nm, ".c"))$
printf(fh, "#include <gkyl_lbo_pkpm_nodal_kernels.h> ~%")$
pkpmLBONodalSurf(fh, nm)$
close(fh)$
printf(fhh, "GKYL_CU_DH void ~a(~a, const double *fl, const double *fc, const double *fr, double* GKYL_RESTRICT out); ~%", nm, pkpmLBONodalArgs)$

nm : "lbo_pkpm_nodal_boundary_surfvpar_1v_p2"$
fh : openw(sconcat("~/max-out/", nm, ".c"))$
printf(fh, "#include <gkyl_lbo_pkpm_nodal_kernels.h> ~%")$
pkpmLBONodalBoundarySurf(fh, nm)$
close(fh)$
printf(fhh, "GKYL_CU_DH void ~a(~a, int edge, const double *fedge, const double *fskin, double* GKYL_RESTRICT out); ~%", nm, pkpmLBONodalArgs)$

printf(fhh, "~%EXTERN_C_END ~%")$
close(fhh)$
