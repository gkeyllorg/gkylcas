/* pkpm-vars-grad-ln-n.mac -------------------------------------------------------
   grad(ln n) = grad(rho)/rho of the factored (p=1) PKPM kinetic update, the
   configuration-space factor of the source -v_par b.grad(ln n) Fbar. The weak
   (face-averaged) gradient of rho is computed by the pkpm_vars_grad_u_* kernels applied
   to the array [rho, 0, 0] (it occupies the first expansion of every direction block);
   here each component is divided by rho at the 2^cdim Gauss-Legendre nodes and the
   quotient interpolated to the p=1 basis with the 2-point rule, as every quotient of the
   solver (pkpm-vars-prim.mac): for p=1 this is the weak division, int phi rho grad(ln n)
   = int phi grad(rho) for every p=1 phi. Near vacuum the quotient, and with it the source
   rate of the time-step estimate, can be large.

   Policy: at a node where rho <= 0 the quotient is zero; the kernel returns the number of
   such nodes. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load(stringproc)$
fpprec : 24$

cvars : [x, y, z]$

calcPKPMVarsGradLnN(fh, funcNm, cdim, basisFun, polyOrder) := block(
  [varsC, bC, NC, nodes, weights, NN, nodeSub, rho_e, g_e, n, k, d, e, g_c],

  kill(varsC, bC),
  [varsC, bC] : loadBasis(basisFun, cdim, polyOrder),
  NC : length(bC),
  [nodes, weights] : gaussOrdWeight(polyOrder+1, cdim),
  NN : length(nodes),

  printf(fh, "#include <gkyl_pkpm_vars_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH int ~a(const double *rho, const double *grad_rho, double* GKYL_RESTRICT grad_ln_n) ~%{ ~%", funcNm),
  printf(fh, "  // rho:       Input mass density. ~%"),
  printf(fh, "  // grad_rho:  Input weak gradient of [rho, 0, 0] (pkpm_vars_grad_u_* layout, cdim x 3 expansions). ~%"),
  printf(fh, "  // grad_ln_n: Output [d_x ln n, ...] (cdim expansions): grad(rho)/rho at the ~a Gauss-Legendre nodes, ~%", NN),
  printf(fh, "  //            interpolated to the p=1 basis (the weak division at p=1). ~%"),
  printf(fh, "  // Returns the number of nodes where rho <= 0 (the quotient is zero there). ~%"),
  printf(fh, " ~%"),
  for d : 1 thru cdim do (
    printf(fh, "  const double *grho_~a = &grad_rho[~a]; ~%", cvars[d], (d-1)*3*NC),
    printf(fh, "  double *gln_~a = &grad_ln_n[~a]; ~%", cvars[d], (d-1)*NC)
  ),
  printf(fh, " ~%"),

  rho_e : doExpand1(rho, bC),
  g_e : makelist(doExpand1(eval_string(sconcat("grho_", cvars[d])), bC), d, 1, cdim),
  printf(fh, "  double gln_n[~a][~a] = {{0.0}}; ~%", cdim, NN),
  printf(fh, "  int num_null = 0; ~%"),
  for n : 1 thru NN do (
    nodeSub : makelist(varsC[d]=nodes[n][d], d, 1, cdim),
    printf(fh, "  { ~%"),
    printf(fh, "    const double rho_q = ~a; ~%", float(expand(subst(nodeSub, rho_e)))),
    printf(fh, "    if (rho_q > 0.0) { ~%"),
    printf(fh, "      const double inv_rho = 1.0/rho_q; ~%"),
    for d : 1 thru cdim do
      printf(fh, "      gln_n[~a][~a] = (~a)*inv_rho; ~%", d-1, n-1, float(expand(subst(nodeSub, g_e[d])))),
    printf(fh, "    } else { ~%"),
    printf(fh, "      num_null += 1; ~%"),
    printf(fh, "    } ~%"),
    printf(fh, "  } ~%")
  ),
  printf(fh, " ~%"),
  for d : 1 thru cdim do (
    g_c : makelist(sum(weights[n]*subst(makelist(varsC[e]=nodes[n][e], e, 1, cdim), bC[k])*gln_n[d-1][n-1], n, 1, NN), k, 1, NC),
    writeCExprs1(eval_string(sconcat("gln_", cvars[d])), g_c)
  ),
  printf(fh, " ~%"),
  printf(fh, "  return num_null; ~%"),
  printf(fh, "} ~%")
)$
