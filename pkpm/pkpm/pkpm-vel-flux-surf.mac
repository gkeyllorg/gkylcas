/* pkpm-vel-flux-surf.mac --------------------------------------------------------
   v_par surface flux of the PKPM kinetic equations (velocity-space pass, stage B), on the eight
   blocks U = [F, G, M0_perp (x, y, z), N_perp (x, y, z)], at the tensor Gauss-Legendre nodes with
   pkpmVelFluxNumPts points per configuration direction (node i0 + N i1 + N^2 i2, direction 0
   fastest; the nodes of the build of the stored operator, pkpm-harm-build.mac).

   pkpm_vel_flux_nodes_<c>x_ser_p1(wn, theta, bvar, alpha_0, c_h, nv)
     Once per configuration cell: the node values nv[node][PKPM_HS_NODE_NV] of the w flux: the RAW
     values of the 62 w-flux coefficients written by the build (wn), then theta, b, alpha_0 and c
     (p=1 fields) at the nodes, and the w-independent part of the spectrum bounds
     (pkpm_harm_node_spec).

   pkpm_vel_flux_vpar_<c>x1v_ser_p1(w, dxv, nv, f_l, f_r, flux)
     On the LOWER w face of the current cell (f_r the current cell, f_l the cell below): the traces
     of the eight blocks on both sides at the nodes, the HLL flux of the w flux alpha U + T(U) at
     every node (pkpm_harm_node_wflux, gkyl_pkpm_harm_coeffs.h: alpha = alpha_0 + (c - K) w_face -
     (b.grad xi) w_face^2, T the coupling by beta, t and R_B1 with the closures H and O, the speeds
     alpha + the bounds of the spectrum of T; exact upwinding when S_L >= 0 or S_R <= 0, the HLL
     average otherwise), projected onto the stored face format (the orthonormal surface
     coefficients divided by (1/sqrt 2)^cdim (2 sqrt 3/5)^(linear factors of the mode)). With
     the raw coefficients the node rule integrates the flux exactly wherever it is upwind
     (degree 1 + 7 + 1 per direction); elsewhere the speeds and the branch are those of the actual
     local operator at the nodes. Traces, node values and projections direction by direction.
     No time-step rate: that of the w fluxes is the column rate of the closure kernel (plan 17.27).

   The flux at the domain edges of velocity space is the closure's (pkpm-vars-closure.mac): the
   updater does not call the face kernel there. */
load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-nodal.mac")$
load(stringproc)$
fpprec : 24$

calcPKPMVelFluxNodes(fh, funcNm, cdim) := block(
  [lb, pkC, pkbC, NC, sOf, xw, x1, NQ, NN],
  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]),
  NC : length(pkbC),
  sOf : pkpmP1PatternIndex(pkC, pkbC),
  xw : gaussOrdWeight1D(pkpmVelFluxNumPts), x1 : float(xw[1]),
  NQ : length(x1), NN : NQ^cdim,

  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%~%"),
  pkpmEmitP1Nodes(fh, sconcat(funcNm, "_p1"), cdim, sOf, x1),
  printf(fh, "GKYL_CU_DH void ~a(const double *wn, const double *theta, const double *bvar, const double *alpha_0,
  const double *c_h, double* GKYL_RESTRICT nv) ~%{ ~%", funcNm),
  printf(fh, "  // wn:      Raw w-flux values at the ~a nodes [node][PKPM_HS_W_END] (the build of the stored operator). ~%", NN),
  printf(fh, "  // theta:   T_perp/T. ~%"),
  printf(fh, "  // bvar:    Magnetic field unit vector [bx, by, bz]. ~%"),
  printf(fh, "  // alpha_0: Pressure force a_P/xi. ~%"),
  printf(fh, "  // c_h:     Heating rate. ~%"),
  printf(fh, "  // nv:      Output node values [~a nodes][PKPM_HS_NODE_NV]. ~%", NN),
  pkpmEmitWNodeFields(fh, sconcat(funcNm, "_p1"), NN, NC, "alpha_0", "c_h"),
  printf(fh, "  for (int n = 0; n < ~a; ++n) { ~%", NN),
  printf(fh, "    double *v = &nv[n*PKPM_HS_NODE_NV]; ~%"),
  pkpmEmitWNodeFill(fh, "    ", "v"),
  printf(fh, "  } ~%"),
  printf(fh, "} ~%")
)$

calcPKPMVelFluxSurf(fh, funcNm, cdim) := block(
  [lb, pkC, pkbC, pkbV, pkbP, NC, NP, vv, pidx, sOf, xw, x1, w1, NQ, NN, c],

  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), vv : lb[3][1], pkbV : copylist(lb[4]),
  pkbP : copylist(lb[6]),
  NC : length(pkbC), NP : length(pkbP),
  pidx : pkpmPhaseIndex(pkC, pkbC, vv, pkbV, pkbP),
  sOf : pkpmP1PatternIndex(pkC, pkbC),
  xw : gaussOrdWeight1D(pkpmVelFluxNumPts), x1 : float(xw[1]), w1 : float(xw[2]),
  NQ : length(x1), NN : NQ^cdim,

  printf(fh, "#include <gkyl_pkpm_kinetic_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%~%"),
  pkpmEmitP1Nodes(fh, sconcat(funcNm, "_p1"), cdim, sOf, x1),
  /* the stored face format: per direction 1 for Phat_0, x/0.4 for Phat_1 (the orthonormal
     coefficient divided by (1/sqrt 2) (2 sqrt 3/5) per linear factor) */
  printf(fh, "// Projection of node values onto the stored face format of the p=1 surface basis (gkyl order). ~%"),
  pkpmEmitNodeProj(fh, sconcat(funcNm, "_prj"), cdim, NQ,
    [makelist(w1[i], i, 1, NQ), makelist(w1[i]*x1[i]/0.4, i, 1, NQ)], sOf),

  printf(fh, "GKYL_CU_DH void ~a(const double *w, const double *dxv, const double *nv,
  const double *f_l, const double *f_r, double* GKYL_RESTRICT flux) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:   Cell-center coordinates (current cell). ~%"),
  printf(fh, "  // dxv[NDIM]: Cell spacing (current cell). ~%"),
  printf(fh, "  // nv:        Node values [~a nodes][PKPM_HS_NODE_NV] of the w flux of the configuration cell. ~%", NN),
  printf(fh, "  // f_l/f_r:   Distributions [F, G, M0_perp, N_perp] in the cell below/current cell. ~%"),
  printf(fh, "  // flux:      Output surface fluxes [8 blocks] on the lower w face (stored face format). ~%"),
  printf(fh, "  // (The time-step rate of the w fluxes is the column rate of the closure kernel, plan 17.27.) ~%"),
  printf(fh, "  const double v_face = w[~a] - 0.5*dxv[~a]; ~%", cdim, cdim),
  /* traces: f_l at its upper edge (eta = 1), f_r at its lower edge (eta = -1) */
  printf(fh, "  double tl[~a], tr[~a], ul[8][~a], ur[8][~a]; ~%", NC, NC, NN, NN),
  for c : 0 thru 7 do (
    pkpmEmitTrace(fh, "tl", f_l, c, 1, NP, pidx, pkbV, vv),
    pkpmEmitTrace(fh, "tr", f_r, c, -1, NP, pidx, pkbV, vv),
    printf(fh, "  ~a_p1(tl, ul[~a]); ~a_p1(tr, ur[~a]); ~%", funcNm, c, funcNm, c)
  ),
  printf(fh, "  double Fhat[8][~a]; ~%", NN),
  printf(fh, "  for (int n = 0; n < ~a; ++n) { ~%", NN),
  printf(fh, "    double U_l[8], U_r[8], Fn[8]; ~%"),
  printf(fh, "    for (int c = 0; c < 8; ++c) { U_l[c] = ul[c][n]; U_r[c] = ur[c][n]; } ~%"),
  printf(fh, "    pkpm_harm_node_wflux(&nv[n*PKPM_HS_NODE_NV], v_face, U_l, U_r, Fn); ~%"),
  printf(fh, "    for (int c = 0; c < 8; ++c) Fhat[c][n] = Fn[c]; ~%"),
  printf(fh, "  } ~%"),
  printf(fh, "  for (int c = 0; c < 8; ++c) ~a_prj(Fhat[c], &flux[c*~a]); ~%", funcNm, NC),
  printf(fh, "} ~%")
)$
