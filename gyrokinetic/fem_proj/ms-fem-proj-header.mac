/* Create the header file for the FEM mass projection kernels.
   Run from the gkylcas repository root, independently of ms-fem-proj.mac. */

load(stringproc)$

/* ...... USER INPUTS........ */

/* Match the basis, dimension and order ranges in ms-fem-proj.mac. */
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
maxCdim_Ser : 2$

/* Output directory must exist. May be set before loading this script. */
if not stringp(fem_proj_out) then fem_proj_out : "~/max-out"$

/* ...... END OF USER INPUTS........ */

bName        : ["ser"]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

disp(printf(false, "Creating gkyl_fem_proj_kernels.h"))$
fname : sconcat(fem_proj_out, "/gkyl_fem_proj_kernels.h")$
fh    : openw(fname)$
printf(fh, "/* Generated by gkylcas/gyrokinetic/fem_proj/ms-fem-proj-header.mac. */~%")$
printf(fh, "#pragma once~%")$
printf(fh, "#include <gkyl_util.h>~%")$
printf(fh, "EXTERN_C_BEG~%")$

for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : 1 thru maxPolyOrder[bInd] do (
      funcName : sconcat("fem_proj_", c, "x_", bName[bInd], "_p", polyOrder),

      /* Global node count and local-to-global grid node indices. */
      printf(fh, "long ~a_num_nodes(const int *cells, const bool *periodic);~%", funcName),
      printf(fh, "void ~a_local_to_global(const int *idx, const int *shape, long *global_idx);~%", funcName),

      /* Consistent mass and source kernels, with unity or DG weights. */
      for suffix in ["", "_weighted"] do (
        printf(fh, "GKYL_CU_DH void ~a_mass~a(const double *weight, double *out);~%", funcName, suffix),
        printf(fh, "GKYL_CU_DH void ~a_src~a(const double *weight, const double *rhs, double *out);~%",
          funcName, if suffix = "" then "_noweight" else suffix)
      ),

      /* Boundary evaluation and solution reconstruction. */
      for suffix in ["eval", "sol"] do (
        printf(fh, "GKYL_CU_DH void ~a_~a(const double *input, double *out);~%", funcName, suffix)
      )
    )
  )
)$

printf(fh, "EXTERN_C_END~%")$
close(fh)$
