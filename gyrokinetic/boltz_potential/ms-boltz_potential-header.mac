/* Generate declarations for all Boltzmann potential kernel families. */
load(stringproc)$

/* ...... USER INPUTS........ */

basisNm : "ser"$

minDim : 1$
maxDim : 3$

minPolyOrder : 1$
maxPolyOrder : 2$

/* Set before loading this script to override the default output directory. */
if not boundp('boltzPotentialOutDir) then boltzPotentialOutDir : "~/max-out"$

/* ...... END OF USER INPUTS........ */

fh : openw(sconcat(boltzPotentialOutDir, "/gkyl_boltz_potential_kernels.h"))$

printf(fh, "#pragma once~%")$
printf(fh, "#include <gkyl_util.h>~%")$
printf(fh, "#include <math.h>~%")$
printf(fh, "EXTERN_C_BEG~%~%")$

for cdim : minDim thru maxDim do (
  for polyOrder : minPolyOrder thru maxPolyOrder do (

    suffix : sconcat(cdim, "x_", basisNm, "_p", polyOrder),

    for edge in ["lower", "upper"] do
      printf(fh, "GKYL_CU_DH void boltz_potential_boundary_~a_~a(const double *flux, const double *area, const double *m0_elc, const double *wall, double *out);~%", edge, suffix),
    printf(fh, "GKYL_CU_DH void boltz_potential_phi_~a(double q_e, double T_e, const double *m0Elc, const double *nphi_ref, double *phi);~%", suffix),

    for model in ["ambi", "0curr"] do
      printf(fh, "GKYL_CU_DH void boltz_pot_~a_reference_~a(double q_e, double T_e, double m_e, const double *lower, const double *upper, double *out);~%", model, suffix)
  )
)$

printf(fh, "~%EXTERN_C_END~%")$
close(fh)$
