/* Generate the header file for the PKPM configuration-space variable kernels of the
   energy-constrained (p=1) PKPM solver: nodal quotients (the weak division at p=1),
   closures, weak gradients, sources and diagnostics. */

/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 1$
maxPolyOrder_Ser : 1$
minCdim_Ser : 1$
maxCdim_Ser : 3$

/* ...... END OF USER INPUTS........ */

cvars : [x, y, z]$

bName        : ["ser"]$
minPolyOrder : [minPolyOrder_Ser]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

printPKPMVarsPrototype(deco, ci, bStr, pi) := block([si, d],
  for d : 1 thru ci do
    printf(fh, "~avoid pkpm_vars_grad_u_~a_~ax_~a_p~a(const double *dxv, const double *jacob_pos, const double *u_l, const double *u_c, const double *u_r, double* GKYL_RESTRICT grad_u); ~%", deco, cvars[d], ci, bStr, pi),
  printf(fh, "~aint pkpm_vars_closure_~ax_~a_p~a(double w_lo, double w_up, double dv, const double *norm_moms, const double *rhs_moms,
  const double *bvar, const double *wn, const double *theta, const double *alpha_0_prev, const double *c_h_prev,
  const double *f_lo, const double *f_up,
  double* GKYL_RESTRICT c_0, double* GKYL_RESTRICT alpha_0, double* GKYL_RESTRICT c_h, double* GKYL_RESTRICT a_perp,
  double* GKYL_RESTRICT flux_lo, double* GKYL_RESTRICT flux_up, double* GKYL_RESTRICT cfl, double* GKYL_RESTRICT cond); ~%", deco, ci, bStr, pi),
  printf(fh, "~aint pkpm_vars_grad_ln_n_~ax_~a_p~a(const double *rho, const double *grad_rho, double* GKYL_RESTRICT grad_ln_n); ~%", deco, ci, bStr, pi),
  printf(fh, "~aint pkpm_vars_prim_~ax_~a_p~a(const double *fluid, double* GKYL_RESTRICT u, double* GKYL_RESTRICT xi); ~%", deco, ci, bStr, pi),
  printf(fh, "~aint pkpm_dtB_over_magB_~ax_~a_p~a(const double *em, const double *dt_em, double* GKYL_RESTRICT out); ~%", deco, ci, bStr, pi),
  printf(fh, "~aint pkpm_fluid_positivity_~ax_~a_p~a(double eps, double* GKYL_RESTRICT fluid); ~%", deco, ci, bStr, pi),
  printf(fh, "~avoid pkpm_vars_int_~ax_~a_p~a(const double *fluid, const double *vlasov_pkpm_moms, const double *u, double* GKYL_RESTRICT int_pkpm_vars); ~%", deco, ci, bStr, pi),
  printf(fh, "~avoid pkpm_vars_source_~ax_~a_p~a(const double *qmem, const double *fluid, double* GKYL_RESTRICT out); ~%", deco, ci, bStr, pi),
  printf(fh, "~avoid pkpm_vars_diag_~ax_~a_p~a(const double *dxv, const double *vlasov_pkpm_moms, const double *euler_pkpm,
  const double *bvar, const double *grad_b, const double *u, const double *grad_u, const double *theta, const double *alpha_0,
  const double *xi, const double *c_h, double* GKYL_RESTRICT fluid_io, double* GKYL_RESTRICT pkpm_vars_io); ~%", deco, ci, bStr, pi),
  printf(fh, "~%")
)$

/* ............ Write out the C header file ............ */
fh : openw("~/max-out/gkyl_pkpm_vars_kernels.h")$

printf(fh, "#pragma once ~%")$
printf(fh, "#include <math.h> ~%")$
printf(fh, "#include <stdbool.h> ~%")$
printf(fh, "#include <gkyl_util.h> ~%")$
printf(fh, "#include <gkyl_mat.h> ~%")$
printf(fh, "EXTERN_C_BEG ~%")$
printf(fh, "~%")$

decorator : "GKYL_CU_DH "$
for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : minPolyOrder[bInd] thru maxPolyOrder[bInd] do (
      printPKPMVarsPrototype(decorator, c, bName[bInd], polyOrder)
    )
  )
);
printf(fh, "EXTERN_C_END ~%")$
close(fh)$
