load("pkpm/pkpm/pkpm-vars-in-cell-grad.mac")$
load(stringproc)$
/* This script generates the in-cell gradient kernels pkpm_vars_in_cell_grad_{x,y,z}_<c>x_ser_p1
   of the p=1 PKPM solver (see pkpm-vars-in-cell-grad.mac). */

cvarsStr : ["x", "y", "z"]$

for c : 1 thru 3 do (
  for d : 1 thru c do (
    funcName : sconcat("pkpm_vars_in_cell_grad_", cvarsStr[d], "_", c, "x_ser_p1"),
    disp(printf(false, "Creating ~a", funcName)),
    fh : openw(sconcat("~/max-out/", funcName, ".c")),
    calcPKPMVarsInCellGrad(d, fh, funcName, c),
    close(fh)
  )
)$
