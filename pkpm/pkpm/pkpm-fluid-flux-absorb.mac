/* pkpm-fluid-flux-absorb.mac -----------------------------------------------------------
   Fluid fluxes at an absorbing boundary face of the (p=1) energy-constrained PKPM
   solver, assembled from the moments of the kinetic upwind flux so that the fluid
   system loses exactly what the distribution functions lose through the wall (the HLL
   flux against a zero ghost state is a vacuum Riemann problem and does not).

   At an absorbing face the kinetic configuration-space flux (pkpm-conf-flux-surf.mac,
   HLL with a zero ghost state) reduces to the one-sided upwind flux of the skin cell,
     Phi_F(w) = max(a, 0) F_skin   (upper boundary),   min(a, 0) F_skin   (lower boundary),
   with a = xi w b_n + u_n the normal speed of the normalized parallel velocity w, and
   likewise Phi_G. With the moments
     I_k = int w^k Phi_F dw (k = 0, 1, 2),   J_0 = int Phi_G dw,
   the fluxes of [rho, rho u, E] through the face are
     F_rho = rho I_0,
     F_Mi  = rho (u_i I_0 + xi b_i I_1) + rho xi^2 (delta_in - b_i b_n) J_0,
     F_E   = rho/2 (|u|^2 I_0 + 2 xi (b.u) I_1 + xi^2 I_2) + rho xi^2 J_0.

   Two kernels per direction:
   - pkpm_fluid_flux_absorb_accum_<d>_<c>x1v_ser_p1(edge, w, dxv, bvar, u, xi, f, I):
     accumulates the nodal moments I[k*NN + n] (k = 0..3: I_0, I_1, I_2, J_0) of one
     velocity cell at the NN transverse Gauss-Legendre nodes of the face (3 per
     transverse direction, as the kinetic flux kernel), with 3 Gauss-Legendre nodes in w;
   - pkpm_fluid_flux_absorb_<d>_<c>x_ser_p1(edge, bvar, u, xi, fluid, I, flux): forms
     the fluxes above at the nodes from the traces of the skin cell and projects them
     onto the surface basis in the layout of pkpm_fluid_flux_<d>_<c>x_ser_p1.
   edge = -1 (lower boundary, face at z_d = -1 of the skin cell) or +1 (upper). */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-fluid-flux-surf.mac")$
load("pkpm/pkpm/pkpm-cas-util.mac")$
load(stringproc)$

pkpmAbsorbNumV : 3$

calcPKPMFluidFluxAbsorbAccum(dir, fh, funcNm, cdim) := block(
  [lb, pkC, pkbC, pkP, pkbP, NC, NP, cv, surfVars, sf, bSurf, nodes, weights, NN, vow, vnodes,
   vweights, F_e, G_e, n, j, sub],

  cdimGlobal : cdim,
  lb : loadPKPMPhaseBasis(cdim),
  pkC : copylist(lb[1]), pkbC : copylist(lb[2]), pkP : copylist(lb[5]), pkbP : copylist(lb[6]),
  NC : length(pkbC),
  NP : length(pkbP),
  cv : pkC[dir],
  surfVars : delete(cv, pkC),
  sf : pkpmFluidSurf(cdim, surfVars),
  bSurf : sf[1], nodes : sf[2], weights : sf[3],
  NN : length(nodes),
  vow : gaussOrdWeight(pkpmAbsorbNumV, 1),
  vnodes : vow[1], vweights : vow[2],

  printf(fh, "#include <gkyl_pkpm_fluid_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(int edge, const double *w, const double *dxv,
  const double *bvar, const double *u, const double *xi, const double *f,
  double* GKYL_RESTRICT I) ~%{ ~%", funcNm),
  printf(fh, "  // edge:      -1 for the lower boundary (face at z_~a = -1 of the skin cell), +1 for the upper. ~%", cv),
  printf(fh, "  // w[NDIM]:   Cell-center coordinates of the phase-space cell. ~%"),
  printf(fh, "  // dxv[NDIM]: Cell spacing of the phase-space cell. ~%"),
  printf(fh, "  // bvar:      Magnetic field unit vector [bx, by, bz] of the skin cell. ~%"),
  printf(fh, "  // u:         Flow velocity [ux, uy, uz] of the skin cell. ~%"),
  printf(fh, "  // xi:        Thermal speed [xi, xi^2, p] of the skin cell (the first expansion is used). ~%"),
  printf(fh, "  // f:         Normalized distribution functions [F, G] of the phase-space cell. ~%"),
  printf(fh, "  // I:         Accumulated nodal moments of the upwind flux at the ~a transverse face nodes: ~%", NN),
  printf(fh, "  //            I[k*~a + n], k = 0..3 for [int Phi_F dw, int w Phi_F dw, int w^2 Phi_F dw, int Phi_G dw]. ~%", NN),
  printf(fh, "  const double ze = edge < 0 ? -1.0 : 1.0; ~%"),
  printf(fh, "  const double wv = w[~a], dv = dxv[~a]; ~%", cdim, cdim),
  printf(fh, "  const double *bd = &bvar[~a]; ~%", (dir-1)*NC),
  printf(fh, "  const double *ud = &u[~a]; ~%", (dir-1)*NC),
  printf(fh, "  const double *xd = &xi[0]; ~%"),
  printf(fh, "  const double *F = &f[0]; ~%"),
  printf(fh, "  const double *G = &f[~a]; ~%", NP),
  printf(fh, "  const double vz[~a] = {~{~a~^, ~}}; ~%", pkpmAbsorbNumV, float(makelist(vnodes[j][1], j, 1, pkpmAbsorbNumV))),
  printf(fh, "  const double vw[~a] = {~{~a~^, ~}}; ~%", pkpmAbsorbNumV, float(vweights)),
  printf(fh, " ~%"),
  printf(fh, "  double bq[~a] = {0.0}; ~%", NN),
  printf(fh, "  double uq[~a] = {0.0}; ~%", NN),
  printf(fh, "  double xq[~a] = {0.0}; ~%", NN),
  pkpmWriteFaceEvals(fh, "bq", bd, pkbC, cv, ze, surfVars, nodes),
  pkpmWriteFaceEvals(fh, "uq", ud, pkbC, cv, ze, surfVars, nodes),
  pkpmWriteFaceEvals(fh, "xq", xd, pkbC, cv, ze, surfVars, nodes),
  printf(fh, " ~%"),

  /* Traces of F and G at the face nodes and the w nodes of this velocity cell. */
  F_e : doExpand1(F, pkbP),
  G_e : doExpand1(G, pkbP),
  printf(fh, "  double Fq[~a] = {0.0}; ~%", NN*pkpmAbsorbNumV),
  printf(fh, "  double Gq[~a] = {0.0}; ~%", NN*pkpmAbsorbNumV),
  for n : 1 thru NN do (
    sub : if cdim > 1 then makelist(surfVars[d] = nodes[n][d], d, 1, cdim-1) else [],
    for j : 1 thru pkpmAbsorbNumV do (
      printf(fh, "  Fq[~a] = ~a; ~%", (n-1)*pkpmAbsorbNumV + j-1,
        float(expand(subst(vx = vnodes[j][1], subst(cv = ze, subst(sub, F_e)))))),
      printf(fh, "  Gq[~a] = ~a; ~%", (n-1)*pkpmAbsorbNumV + j-1,
        float(expand(subst(vx = vnodes[j][1], subst(cv = ze, subst(sub, G_e))))))
    )
  ),
  printf(fh, " ~%"),
  printf(fh, "  for (int n = 0; n < ~a; ++n) { ~%", NN),
  printf(fh, "    for (int j = 0; j < ~a; ++j) { ~%", pkpmAbsorbNumV),
  printf(fh, "      const double wq = wv + 0.5*dv*vz[j]; ~%"),
  printf(fh, "      const double a = xq[n]*bq[n]*wq + uq[n]; ~%"),
  printf(fh, "      const double phi = (edge < 0 ? fmin(a, 0.0) : fmax(a, 0.0))*0.5*dv*vw[j]; ~%"),
  printf(fh, "      const double fq = Fq[n*~a + j], gq = Gq[n*~a + j]; ~%", pkpmAbsorbNumV, pkpmAbsorbNumV),
  printf(fh, "      I[0*~a + n] += phi*fq; ~%", NN),
  printf(fh, "      I[1*~a + n] += wq*phi*fq; ~%", NN),
  printf(fh, "      I[2*~a + n] += wq*wq*phi*fq; ~%", NN),
  printf(fh, "      I[3*~a + n] += phi*gq; ~%", NN),
  printf(fh, "    } ~%"),
  printf(fh, "  } ~%"),
  printf(fh, "} ~%")
)$

calcPKPMFluidFluxAbsorb(dir, fh, funcNm, cdim) := block(
  [varsC, bC, NC, cv, surfVars, sf, bSurf, nodes, weights, NN, NSurf, i, n, c, k, chi, expr,
   cvarsStr],

  cdimGlobal : cdim,
  kill(varsC, bC),
  [varsC, bC] : loadBasis("ser", cdim, 1),
  NC : length(bC),
  cv : varsC[dir],
  surfVars : delete(cv, varsC),
  sf : pkpmFluidSurf(cdim, surfVars),
  bSurf : sf[1], nodes : sf[2], weights : sf[3],
  NN : length(nodes),
  NSurf : length(bSurf),
  cvarsStr : ["x", "y", "z"],

  printf(fh, "#include <gkyl_pkpm_fluid_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(int edge, const double *jacob_pos, const double *bvar, const double *u,
  const double *xi, const double *fluid, const double *I, double* GKYL_RESTRICT flux) ~%{ ~%", funcNm),
  printf(fh, "  // edge:  -1 for the lower boundary (face at z_~a = -1 of the skin cell), +1 for the upper. ~%", cv),
  printf(fh, "  // jacob_pos: Position-map Jacobian per configuration direction of the skin cell (cdim blocks of 2 equal entries). ~%"),
  printf(fh, "  // bvar:  Magnetic field unit vector [bx, by, bz] of the skin cell. ~%"),
  printf(fh, "  // u:     Flow velocity [ux, uy, uz] of the skin cell. ~%"),
  printf(fh, "  // xi:    Thermal speed [xi, xi^2, p] of the skin cell. ~%"),
  printf(fh, "  // fluid: PHYSICAL fluid state [rho, rho ux, rho uy, rho uz, E] of the skin cell (Jacobian divided out). ~%"),
  printf(fh, "  // I:     Nodal moments [I_0, I_1, I_2, J_0] of the kinetic upwind flux of the Jacobian-weighted ~%"),
  printf(fh, "  //        J [F, G] at the ~a face nodes (pkpm_fluid_flux_absorb_accum_~a_~ax1v_ser_p1 summed over ~%", NN, cvarsStr[dir], cdim),
  printf(fh, "  //        the velocity cells); they carry one factor of J. ~%"),
  printf(fh, "  // flux:  Output modal surface fluxes [F_rho, F_x, F_y, F_z, F_E] of the face for the evolved ~%"),
  printf(fh, "  //        J-weighted fluid: the physical flux times the face Jacobian J/J_~a, i.e. the ~%", cv),
  printf(fh, "  //        J-carrying nodal fluxes divided by J_~a. ~%", cv),
  printf(fh, "  const double ze = edge < 0 ? -1.0 : 1.0; ~%"),
  printf(fh, "  const double jdinv = 1.0/jacob_pos[~a]; ~%", 2*(dir-1)),
  printf(fh, "  const double *rho = &fluid[0]; ~%"),
  printf(fh, "  const double *xd = &xi[0]; ~%"),
  printf(fh, "  const double *x2d = &xi[~a]; ~%", NC),
  for i : 1 thru 3 do (
    printf(fh, "  const double *b~a = &bvar[~a]; ~%", i-1, (i-1)*NC),
    printf(fh, "  const double *u~a = &u[~a]; ~%", i-1, (i-1)*NC)
  ),
  printf(fh, " ~%"),
  printf(fh, "  double rq[~a] = {0.0}; ~%", NN),
  printf(fh, "  double xq[~a] = {0.0}; ~%", NN),
  printf(fh, "  double x2q[~a] = {0.0}; ~%", NN),
  for i : 1 thru 3 do (
    printf(fh, "  double bq~a[~a] = {0.0}; ~%", i-1, NN),
    printf(fh, "  double uq~a[~a] = {0.0}; ~%", i-1, NN)
  ),
  pkpmWriteFaceEvals(fh, "rq", rho, bC, cv, ze, surfVars, nodes),
  pkpmWriteFaceEvals(fh, "xq", xd, bC, cv, ze, surfVars, nodes),
  pkpmWriteFaceEvals(fh, "x2q", x2d, bC, cv, ze, surfVars, nodes),
  for i : 1 thru 3 do (
    pkpmWriteFaceEvals(fh, sconcat("bq", i-1), concat(b, i-1), bC, cv, ze, surfVars, nodes),
    pkpmWriteFaceEvals(fh, sconcat("uq", i-1), concat(u, i-1), bC, cv, ze, surfVars, nodes)
  ),
  printf(fh, " ~%"),
  printf(fh, "  // Nodal fluxes [F_rho, F_x, F_y, F_z, F_E]. ~%"),
  printf(fh, "  double Fq[~a] = {0.0}; ~%", 5*NN),
  printf(fh, "  for (int n = 0; n < ~a; ++n) { ~%", NN),
  printf(fh, "    const double I0 = I[n], I1 = I[~a + n], I2 = I[~a + n], J0 = I[~a + n]; ~%", NN, 2*NN, 3*NN),
  printf(fh, "    const double bn = bq~a[n]; ~%", dir-1),
  printf(fh, "    const double bu = bq0[n]*uq0[n] + bq1[n]*uq1[n] + bq2[n]*uq2[n]; ~%"),
  printf(fh, "    const double uu = uq0[n]*uq0[n] + uq1[n]*uq1[n] + uq2[n]*uq2[n]; ~%"),
  printf(fh, "    Fq[n] = rq[n]*I0; ~%"),
  for i : 1 thru 3 do
    printf(fh, "    Fq[~a + n] = rq[n]*(uq~a[n]*I0 + xq[n]*bq~a[n]*I1) + rq[n]*x2q[n]*(~a - bq~a[n]*bn)*J0; ~%",
      i*NN, i-1, i-1, if i = dir then "1.0" else "0.0", i-1),
  printf(fh, "    Fq[~a + n] = 0.5*rq[n]*(uu*I0 + 2.0*xq[n]*bu*I1 + x2q[n]*I2) + rq[n]*x2q[n]*J0; ~%", 4*NN),
  printf(fh, "    for (int c = 0; c < 5; ++c) Fq[c*~a + n] *= jdinv; ~%", NN),
  printf(fh, "  } ~%"),
  printf(fh, " ~%"),
  printf(fh, "  // Projection of the nodal fluxes onto the surface basis. ~%"),
  for c : 1 thru 5 do (
    for k : 1 thru NSurf do (
      expr : "",
      for n : 1 thru NN do (
        chi : if cdim > 1 then subst(makelist(surfVars[d] = nodes[n][d], d, 1, cdim-1), bSurf[k]) else 1,
        expr : sconcat(expr, if n > 1 then " + " else "", float(expand(weights[n]*chi)), "*Fq[", (c-1)*NN + n-1, "]")
      ),
      printf(fh, "  flux[~a] = ~a; ~%", (c-1)*NSurf + k-1, expr)
    )
  ),
  printf(fh, "} ~%")
)$
