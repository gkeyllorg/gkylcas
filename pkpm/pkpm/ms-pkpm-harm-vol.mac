load("pkpm/pkpm/pkpm-harm-vol.mac")$
load(stringproc)$
/* Generates the first-harmonic volume kernels (see pkpm-harm-vol.mac, pkpm-harm-ops.mac): the
   per-configuration-cell matrices pkpm_harm_mat_<c>x_ser_p1, the per-phase-cell volume terms
   pkpm_harm_vol_<c>x1v_ser_p1, and the header of the stored-operator layout gkyl_pkpm_harm_ops.h. */
fh : openw("~/max-out/gkyl_pkpm_harm_ops.h")$
writePKPMHarmOpsHeader(fh)$
close(fh)$
for c : 1 thru 3 do (
  funcName : sconcat("pkpm_harm_mat_", c, "x_ser_p1"),
  disp(printf(false, "Creating ~a", funcName)),
  fh : openw(sconcat("~/max-out/", funcName, ".c")),
  calcPKPMHarmMat(fh, funcName, c),
  close(fh),
  funcName : sconcat("pkpm_harm_vol_", c, "x1v_ser_p1"),
  disp(printf(false, "Creating ~a", funcName)),
  fh : openw(sconcat("~/max-out/", funcName, ".c")),
  calcPKPMHarmVol(fh, funcName, c),
  close(fh)
)$
