load("new_vlasov/vlasovVelFluxSurfFuncs")$
load(stringproc)$
/* This script calls the functions which calculate the
   components of the modal DG expansion of the velocity space 
   flux, first accumulating different forces into an array
   storing the phase space characteristics alpha_v at quadrature
   points, and then constructing a nodal Lax-Friedrichs flux,
   G = alpha/2*(f^+ + f^-) - |alpha|/2*(f^+ - f^-)
   and converting that back to a modal expansion. */

/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 1$
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
minVdim_Ser : 1$    /* see begining of v loop below though. */
maxCdim_Ser : 3$
maxVdim_Ser : 3$

/* Tensor product basis. */
/* Tensor p=1 IS the tensor hybrid (p1 conf x p2 vel); pure p=1 tensor
   kernels still do not exist anywhere. */
minPolyOrder_Tensor : 1$
maxPolyOrder_Tensor : 2$
minCdim_Tensor : 1$
minVdim_Tensor : 1$    /* see begining of v loop below though. */
maxCdim_Tensor : 3$
maxVdim_Tensor : 3$

/* ...... END OF USER INPUTS........ */

bName        : ["ser","tensor"]$
minPolyOrder : [minPolyOrder_Ser, minPolyOrder_Tensor]$
maxPolyOrder : [maxPolyOrder_Ser, maxPolyOrder_Tensor]$
minCdim      : [minCdim_Ser, minCdim_Tensor]$
minVdim      : [minVdim_Ser, minVdim_Tensor]$
maxCdim      : [maxCdim_Ser, maxCdim_Tensor]$
maxVdim      : [maxVdim_Ser, maxVdim_Tensor]$
useHigherOrderList : [false, true]$
/* Hamiltonian representations to generate magnetic-force kernels for.
   "phase" (GR Vlasov-Maxwell coupling) is skipped for tensor p>1. */
hamilReps : ["vel_dense", "vel_sparse", "phase"]$

clabels : ["x","y","z"]$
vlabels : ["vx","vy","vz"]$

for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    minVdimB : max(c,minVdim[bInd]), 
    maxVdimB : maxVdim[bInd], 
    if (c = 2) then minVdimB : 1, /* We support 2x1v. */
    for v : minVdimB thru maxVdimB do (

      minPolyOrderB : minPolyOrder[bInd],
      maxPolyOrderB : maxPolyOrder[bInd],
      if (v=1) then maxPolyOrderB : 3, /* Generate p=3 kernels if vdim = 1 */
      if (c+v>5 and maxPolyOrderB > 1) then maxPolyOrderB : 1,
      /* Skip 2x3v tensor kernels: not used by the kernel tables and very
         expensive to generate. */
      if (bName[bInd] = "tensor" and c = 2 and v = 3) then maxPolyOrderB : 1,
      for polyOrder : minPolyOrderB thru maxPolyOrderB do (

        /* High-Order itegration Logic */
        for hoInd : 1 thru length(useHigherOrderList) do (
          useHigherOrder : useHigherOrderList[hoInd],
          if useHigherOrder then si : "ho_" else si : "",
          if (not((bName[bInd] = "ser") and (polyOrder = 1) and (useHigherOrder = true)) and not((useHigherOrder = false) and (bName[bInd] = "tensor") and (polyOrder > 1))) then (
            if (((bName[bInd] = "ser") and (polyOrder = 1) and (useHigherOrder = false)) or ((useHigherOrder = true) and (bName[bInd] = "tensor") and (polyOrder > 1))) then si : "",

            disp(printf(false,sconcat("Creating velocity flux ",bName[bInd]," ~ax~av_p~a"),c,v,polyOrder)),
            /* Can only have scalar potential force in directions where we can take configuration space gradients. */
            maxC : c, /* Which directions are we generating surface kernels for? */
            if (v < c) then maxC : v, /* In 2x1v, only generate the vx surface kernel. */
            for dir : 1 thru maxC do (
              fname : sconcat("~/max-out/phi_",si,"alpha_quad_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
              fh : openw(fname),
              funcName : sconcat("phi_",si,"alpha_quad_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
              calcPhiVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, useHigherOrder), 
              close(fh)         
            ),
            for dir : 1 thru v do (
              fname : sconcat("~/max-out/E_",si,"alpha_quad_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
              fh : openw(fname),
              funcName : sconcat("E_",si,"alpha_quad_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
              calcEVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, useHigherOrder), 
              close(fh), 

              /* Magnetic force with velocity-space Hamiltonian volume component. Only valid for vdim > 1. */
              if (v > 1) then (
                for hrInd : 1 thru length(hamilReps) do (
                  hamilRep : hamilReps[hrInd],
                  /* RULE: hamil_phase at c+v>=5 is p=1 only; also no
                     phase-space Hamiltonian magnetic force for tensor p>1 (cubic rep). */
                  if (((bName[bInd] = "tensor" and polyOrder > 1) or (c+v>=5 and polyOrder>1)) and (hamilRep = "phase")) then (
                    disp(printf(false,sconcat("Skipping B alpha ",vlabels[dir]," kernel for phase hamil ",bName[bInd]," ~ax~avP~a"),c,v,polyOrder))
                  )
                  else (
                    fname : sconcat("~/max-out/B_",si,"hamil_", hamilRep, "_alpha_quad_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
                    fh : openw(fname),
                    funcName : sconcat("B_",si,"hamil_", hamilRep, "_alpha_quad_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
                    if (bName[bInd] = "tensor") then (
                      calcBHamilVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, hamilRep, "cubic", useHigherOrder)
                    )
                    else (
                      calcBHamilVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, hamilRep, "linear", useHigherOrder)
                    ),
                    close(fh)
                  )
                )
              ),

              fname : sconcat("~/max-out/rad_",si,"alpha_quad_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
              fh : openw(fname),
              funcName : sconcat("rad_",si,"alpha_quad_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
              calcRadVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, useHigherOrder), 
              close(fh),
              if (bName[bInd] = "tensor") then (
                fname : sconcat("~/max-out/",si,"lax_flux_nodal_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
                fh : openw(fname),
                funcName : sconcat(si,"lax_flux_nodal_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
                calcNodalLaxToModalVelFlux(dir, fh, funcName, c, v, bName[bInd], polyOrder, "cubic", useHigherOrder), 
                close(fh)  
              )
              else (
                fname : sconcat("~/max-out/",si,"lax_flux_nodal_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
                fh : openw(fname),
                funcName : sconcat(si,"lax_flux_nodal_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
                calcNodalLaxToModalVelFlux(dir, fh, funcName, c, v, bName[bInd], polyOrder, "linear", useHigherOrder), 
                close(fh)  
              )       
            )
          )
        )
      ),
      if (v=1) then maxPolyOrderB : 3, /* Generate p=3 kernels if vdim = 1 */
      /* We do not generate 5D and 6D p>1 phase-space Hamiltonian kernels. */
      if (c+v>5 and maxPolyOrderB > 1) then maxPolyOrderB : 1,
      for polyOrder : minPolyOrderB thru maxPolyOrderB do (

        /* High-Order itegration Logic */
        for hoInd : 1 thru length(useHigherOrderList) do (
          useHigherOrder : useHigherOrderList[hoInd],
          if useHigherOrder then si : "ho_" else si : "",
          if (not((bName[bInd] = "ser") and (polyOrder = 1) and (useHigherOrder = true)) and not((useHigherOrder = false) and (bName[bInd] = "tensor") and (polyOrder > 1))) then (
            if (((bName[bInd] = "ser") and (polyOrder = 1) and (useHigherOrder = false)) or ((useHigherOrder = true) and (bName[bInd] = "tensor") and (polyOrder > 1))) then si : "",

            disp(printf(false,sconcat("Creating hamiltonian force velocity flux ",bName[bInd]," ~ax~av_p~a"),c,v,polyOrder)),
            /* Can only have Hamiltonian force in directions where we can take configuration space gradients. */
            maxC : c, /* Which directions are we generating surface kernels for? */
            if (v < c) then maxC : v, /* In 2x1v, only generate the vx surface kernel. */
            for dir : 1 thru maxC do (
              /* Phase-space Hamiltonian surface component: Serendipity and the
                 tensor p=1 hybrid (no phase rep for tensor p>1). */
              if ((bName[bInd] = "ser" or bName[bInd] = "tensor") and not(c+v>=5 and polyOrder>1)) then (
                fname : sconcat("~/max-out/hamil_phase_",si,"alpha_quad_", vlabels[dir], "_", c, "x", v, "v_", bName[bInd], "_p", polyOrder, ".c"),
                fh : openw(fname),
                funcName : sconcat("hamil_phase_",si,"alpha_quad_",vlabels[dir],"_", c, "x", v, "v_", bName[bInd], "_p", polyOrder),
                calcHamilPhaseVelSurfForce(dir, fh, funcName, c, v, bName[bInd], polyOrder, useHigherOrder), 
                close(fh)
              )
            )
          )
        )
      )
    )
  )
);
