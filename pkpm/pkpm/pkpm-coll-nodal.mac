/* Conversions between the modal PKPM expansions and the configuration-nodal, velocity-modal form
   of the collision kernels. In a configuration cell the nodes are the 2^cdim interior
   Gauss-Legendre points x_d = +-1/sqrt(3), node q having bit d set when x_d > 0 (direction 0
   fastest). The node values of the p=1 basis are 2^(-cdim/2) times +-1, so the modeMap is orthogonal,
   its inverse is its transpose, and it factors into one sum/difference sweep per direction.

   A nodal phase-space cell is g[(q*8 + b)*3 + j]: node q, block b of the 8 PKPM blocks, Legendre
   mode j of the 1V p=2 basis in v_par. It holds the same number of values as the modal cell. */
load("core/modal-basis.mac")$
load(stringproc)$
fpprec : 24$

/* 1-based index in the basis bas of the function that is linear in the variables with e[d] = 1
   of vars, constant in the others, and of degree pv in the velocity variable (ignored if pv < 0). */
pkpmCollBasisIndex(bas, vars, e, pv) := block(
  [i, d, match, found],
  found : 0,
  for i : 1 thru length(bas) do (
    match : true,
    for d : 1 thru length(vars) do (
      if hipow(expand(bas[i]), vars[d]) # e[d] then match : false
    ),
    if pv >= 0 and hipow(expand(bas[i]), vx) # pv then match : false,
    if match then found : i
  ),
  if found = 0 then error("pkpmCollBasisIndex: no basis function found"),
  return(found)
)$

/* Bits of the tensor index n in cdim directions, direction 0 first. */
pkpmCollBits(n, cdim) := makelist(mod(floor(n/2^d), 2), d, 0, cdim-1)$

/* Print "const double <nm>[<len>] = {...};" with the entries of the list vals. */
pkpmCollPrintArray(fh, indent, nm, vals) := block(
  [i],
  printf(fh, "~aconst double ~a[~a] = {", indent, nm, length(vals)),
  for i : 1 thru length(vals) do (
    printf(fh, "~a~a", vals[i], if i < length(vals) then ", " else "")
  ),
  printf(fh, "};~%")
)$

/* One sum/difference sweep per direction over a tensor array of nv copies of 2^cdim entries.
   forward: the modal-to-nodal sweep; otherwise its transpose. Leaves the result in t<cdim>. */
pkpmCollSweeps(fh, indent, cdim, nv, forward) := block(
  [ne, d, v, n, lo, hi, vals, a, b],
  ne : 2^cdim,
  for d : 0 thru cdim-1 do (
    vals : makelist(0, i, 1, nv*ne),
    for v : 0 thru nv-1 do (
      for n : 0 thru ne-1 do (
        if mod(floor(n/2^d), 2) = 0 then (
          lo : v*ne + n,
          hi : lo + 2^d,
          a : sconcat("t", d, "[", lo, "]"),
          b : sconcat("t", d, "[", hi, "]"),
          if forward then (
            vals[lo+1] : sconcat(a, "-", b),
            vals[hi+1] : sconcat(a, "+", b)
          ) else (
            vals[lo+1] : sconcat(a, "+", b),
            vals[hi+1] : sconcat(b, "-", a)
          )
        )
      )
    ),
    pkpmCollPrintArray(fh, indent, sconcat("t", d+1), vals)
  )
)$

/* Modal to nodal and nodal to modal for a p=1 configuration-space field. */
pkpmCollConf(fh, cdim) := block(
  [varsC, bC, ne, modeMap, n, scale],
  [varsC, bC] : loadBasis("Ser", cdim, 1),
  ne : 2^cdim,
  scale : float(1/sqrt(2)^cdim),
  modeMap : makelist(pkpmCollBasisIndex(bC, varsC, pkpmCollBits(n, cdim), -1) - 1, n, 0, ne-1),

  printf(fh, "// The p=1 configuration-space expansion c at the ~a nodes.~%", ne),
  printf(fh, "GKYL_CU_DH static inline void~%pkpm_coll_conf_to_nodal_~ax(const double *c, double* GKYL_RESTRICT n)~%{~%", cdim),
  pkpmCollPrintArray(fh, "  ", "t0", makelist(sconcat("c[", modeMap[n], "]"), n, 1, ne)),
  pkpmCollSweeps(fh, "  ", cdim, 1, true),
  for n : 0 thru ne-1 do (
    printf(fh, "  n[~a] = ~a*t~a[~a];~%", n, scale, cdim, n)
  ),
  printf(fh, "}~%~%"),

  printf(fh, "// The p=1 expansion c of the ~a node values n.~%", ne),
  printf(fh, "GKYL_CU_DH static inline void~%pkpm_coll_nodal_to_conf_~ax(const double *n, double* GKYL_RESTRICT c)~%{~%", cdim),
  pkpmCollPrintArray(fh, "  ", "t0", makelist(sconcat("n[", n, "]"), n, 0, ne-1)),
  pkpmCollSweeps(fh, "  ", cdim, 1, false),
  for n : 0 thru ne-1 do (
    printf(fh, "  c[~a] = ~a*t~a[~a];~%", modeMap[n+1], scale, cdim, n)
  ),
  printf(fh, "}~%~%")
)$

/* Modal to nodal, and accumulation of a nodal increment onto a modal array, for the 8 blocks. */
pkpmCollPhase(fh, cdim) := block(
  [varsC, bC, varsP, bP, NP, ne, nv, j, n, q, modeMap, bV, varsConf, scale, k, i, e, chk, vals],
  [varsC, bC, varsP, bP] : loadPhaseBasis("hyb", cdim, 1, 1),
  NP : length(bP),
  ne : 2^cdim,
  nv : 3,
  scale : float(1/sqrt(2)^cdim),
  bV : [1/sqrt(2), sqrt(3/2)*vx, sqrt(5/8)*(3*vx^2-1)],

  /* modeMap[j*ne + n + 1]: index of the modal coefficient of velocity mode j, tensor index n. Each
     hybrid basis function must be the product of a configuration and a velocity function. */
  modeMap : makelist(0, k, 1, nv*ne),
  for j : 0 thru nv-1 do (
    for n : 0 thru ne-1 do (
      e : pkpmCollBits(n, cdim),
      k : pkpmCollBasisIndex(bP, varsC, e, j),
      i : pkpmCollBasisIndex(bC, varsC, e, -1),
      chk : float(subst([x=0.37, y=-0.21, z=0.53, vx=0.61], bP[k] - bC[i]*bV[j+1])),
      if abs(chk) > 1.0e-13 then error("pkpmCollPhase: the hybrid basis is not a tensor product", chk),
      modeMap[j*ne + n + 1] : k - 1
    )
  ),

  printf(fh, "// The 8 modal blocks f (~a coefficients each) at the ~a nodes: g[(q*8 + b)*3 + j].~%", NP, ne),
  printf(fh, "GKYL_CU_DH static inline void~%pkpm_coll_phase_to_nodal_~ax1v(const double *f, double* GKYL_RESTRICT g)~%{~%", cdim),
  printf(fh, "  for (int b = 0; b < 8; ++b) {~%"),
  printf(fh, "    const double *fb = &f[b*~a];~%", NP),
  pkpmCollPrintArray(fh, "    ", "t0", makelist(sconcat("fb[", modeMap[k], "]"), k, 1, nv*ne)),
  pkpmCollSweeps(fh, "    ", cdim, nv, true),
  for j : 0 thru nv-1 do (
    for q : 0 thru ne-1 do (
      printf(fh, "    g[~a + 3*b] = ~a*t~a[~a];~%", 24*q + j, scale, cdim, j*ne + q)
    )
  ),
  printf(fh, "  }~%}~%~%"),

  printf(fh, "// Accumulate the nodal increment g[(q*8 + b)*3 + j] onto the 8 modal blocks out.~%"),
  printf(fh, "GKYL_CU_DH static inline void~%pkpm_coll_nodal_to_phase_accumulate_~ax1v(const double *g, double* GKYL_RESTRICT out)~%{~%", cdim),
  printf(fh, "  for (int b = 0; b < 8; ++b) {~%"),
  printf(fh, "    double *outb = &out[b*~a];~%", NP),
  vals : [],
  for j : 0 thru nv-1 do (
    for q : 0 thru ne-1 do (
      vals : endcons(sconcat("g[", 24*q + j, " + 3*b]"), vals)
    )
  ),
  pkpmCollPrintArray(fh, "    ", "t0", vals),
  pkpmCollSweeps(fh, "    ", cdim, nv, false),
  for k : 1 thru nv*ne do (
    printf(fh, "    outb[~a] += ~a*t~a[~a];~%", modeMap[k], scale, cdim, k-1)
  ),
  printf(fh, "  }~%}~%~%")
)$
