load("pkpm/pkpm/pkpm-dist-transverse.mac")$
load(stringproc)$
/* This script generates the transversality projection kernels pkpm_dist_transverse_<c>x1v_ser_p1
   of the first-harmonic blocks of the normalized PKPM distributions (see pkpm-dist-transverse.mac). */
for c : 1 thru 3 do (
  funcName : sconcat("pkpm_dist_transverse_", c, "x1v_ser_p1"),
  disp(printf(false, "Creating ~a", funcName)),
  fh : openw(sconcat("~/max-out/", funcName, ".c")),
  calcPKPMDistTransverse(fh, funcName, c),
  close(fh)
)$
