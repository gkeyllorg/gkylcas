/* Generate boltz_potential kernels. Run from the gkylcas root. */
load("gyrokinetic/boltz_potential/boltz_potential_funcs.mac")$

/* ...... USER INPUTS........ */

basisNm : "ser"$

minDim : 1$
maxDim : 3$

minPolyOrder : 1$
maxPolyOrder : 2$

/* Set before loading this script to override the default output directory. */
if not boundp('boltzPotentialOutDir) then boltzPotentialOutDir : "~/max-out"$

/* ...... END OF USER INPUTS........ */

for cdim : minDim thru maxDim do (
  for polyOrder : minPolyOrder thru maxPolyOrder do (

    suffix : sconcat(cdim, "x_", basisNm, "_p", polyOrder),

    fh : openw(sconcat(boltzPotentialOutDir, "/boltz_potential_", suffix, ".c")),
    printf(fh, "#include <gkyl_boltz_potential_kernels.h>~%~%"),

    genBoltzBoundaryKernel(fh,
      [sconcat("boltz_potential_boundary_lower_", suffix), sconcat("boltz_potential_boundary_upper_", suffix)], cdim, basisNm, polyOrder),
    genBoltzPhiKernel(fh, sconcat("boltz_potential_phi_", suffix), cdim, basisNm, polyOrder),

    close(fh)
  )
)$
