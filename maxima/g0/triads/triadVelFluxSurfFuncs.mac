/* Functions which compute the components of the surface flux in velocity space.
   The procedure we utilize to generalize to the presence of different forces/different
   flavors of the Vlasov equation is a set of functions that compute the characteristics
   alpha_v at surface quadrature points of the needed order, accumulating each component,
   e.g., Hamiltonian forces, the Lorentz force, or forces due to a scalar potential,
   into a total alpha_v at the surface.

   We then evaluate the Lax-Friedrichs flux G = alpha/2*(f^+ + f^-) - |alpha|/2*(f^+ - f^-)
   at each quadrature point, and then convert that back to a modal expansion of the
   velocity-space flux for use in the final update in hyper_dg.

   Note that we do not make any assumptions on the order of the phase space expansion
   and thus to evaluate G, we must utilize enough Gauss-Legendre quadrature points
   to integrate a 3*p polynomial (cubic for p=1, sixth order for p=2, ninth order for p=3).
   We thus must use 2, 4, and 5 Gauss-Legendre points respectively.

   In velocity space, certain Hamiltonians such as H = v^2/2 require fewer velocity space
   quadrature points since these Hamiltonians are "sparse." We separate the velocity space
   vs. configuration space quadrature loops and generate separate nodal configuration space
   and nodal velocity space surface bases. Since these quadrature rules are all tensor products
   of configuration space and velocity space, the final phase space basis is simply a tensor
   product of the configuration space and velocity space bases.
*/

load("modal-basis");
load("out-scripts");
load("utilities")$
load("nodal_operations/nodal_functions")$
load("new_vlasov/vlasov-basis");
load("new_vlasov/nodal-lax-emit");
load("new_vlasov/alpha-factor-emit");
load("new_vlasov/surf-eval-tables");
load(stringproc)$
fpprec : 24$

clabels : ["x","y","z"]$
vlabels : ["vx","vy","vz"]$
cidx(cdim) := makelist(i,i,0,cdim-1)$
vidx(cdim,vdim) := makelist(i,i,cdim,cdim+vdim-1)$

/* Phase-space Hamiltonian forces at velocity-space surface quadrature points
   for the non-canonical (triad) bracket:

     alpha^dir = Pi^{dir,xi} dH/dz^xi,  z^xi = (x, y, z, vx, vy, vz)

   evaluated at (v_dir = -1, conf node i, vel node j); each cell owns its
   lower edge. The Pi_px block contracts H's configuration gradient (phase
   Hamiltonians only; velocity Hamiltonians have none) and the Pi_pp block
   enters through omega_ab = vTrans . Pi with the transverse velocity
   coordinates read from the shared vel_nodes table (Pi_pp vanishes in 1V).
   The node function does one (i, j) node's work (Design A); the flat node
   is n = i*NIv + j. */
calcHamilVelSurfForceNonCanonical(dir, fh, funcNm, cdim, vdim, basisFun, polyOrder, hamil_rep, useHigherOrder) := block(
  [varsC,bC,varsV,bV,varsP,bP,cid,vid,vv,surfVars,surfVVars,bSurf,
   nodes_conf,basisNodalConf,nodes_vel,basisNodalVel,surfNodes,
   num_nodes_conf,num_nodes_vel,NC,NV,NB,tag,tabP,fact,NA,NMV,NS,
   transK,omDefs,ppRows,k,m,c,b,r,om,p,nJPts,pp,nidx,
   varsMap1,bMap1,vmapS,xnS,xnSqS,vt_e,NT,nPhase,prelude,outerBody,innerBody,tOff,kk,rows,sgn],

  [varsC,bC,varsV,bV,varsP,bP] : loadVlasovBasis(basisFun, cdim, vdim, polyOrder),
  NC : length(bC), NV : length(bV), NB : length(bP),
  cid : cidx(cdim), vid : vidx(cdim,vdim),

  vv : varsV[dir],
  surfVars : delete(vv,varsP),  /* Surface variables at constant vv surface. */
  surfVVars : delete(vv,varsV), /* Remaining variables in v. */
  [bSurf,nodes_conf,basisNodalConf,nodes_vel,basisNodalVel,surfNodes] : loadVlasovVelSurfBasis(cdim, vdim, basisFun, polyOrder, surfVars, surfVVars, varsC, useHigherOrder),
  num_nodes_conf : length(nodes_conf),
  num_nodes_vel : length(nodes_vel),
  laxAssertNodeOrder(surfNodes, nodes_conf, nodes_vel),
  tag : surfTabTag(cdim, vdim, basisFun, polyOrder, useHigherOrder),

  printf(fh, "#include <gkyl_flux_vlasov_kernels.h> ~%"),
  surfTabInclude(fh, cdim, vdim, basisFun, polyOrder),

  /* Terms of alpha^dir = Pi^{dir,xi} dH/dz^xi as outer x inner products:
     - Pi_px block (phase Hamiltonians only), one term per outer shape a:
         O_a(i) = -sum_c Pi^{dir,c}_{px}(i) dCm_c[i][a] dx1_c / J_x,c,
         I_a(j) = G[j][a]  (the -1-edge contraction of H onto the inner shapes);
     - Pi_pp block (vdim > 1), one term per (transverse direction k, velocity
       component m) of omega_ab = vTrans . Pi:
         O(i) = +/- Pi_pp row(i),  I(j) = v_m(j) dH/dv_k(j) dv1_k / J_v,k(j).
     Mesh maps: each derivative picks up the inverse Jacobian of ITS OWN
     direction (dH/dx_c -> 1/J_x,c via jacob_pos; transverse dH/dv_k ->
     1/J_v,k via jacob_vel_surf, per node for the C^1 cubic map whose in-cell
     Jacobian is quadratic); the physical velocity comes from the vmap in its
     native representation (linear for Serendipity, cubic for Tensor). */
  prelude : [], outerBody : [], innerBody : [],
  nPhase : if (hamil_rep = "phase") then (
    fact : laxFactorizeBasis(bP, varsC, cons(vv, surfVVars)),
    NA : laxFactorSizes(fact, vv)[1],
    NMV : laxFactorSizes(fact, vv)[2],
    tabP : sconcat("vst_", tag, "_ph_v", dir-1),
    NA) else 0,
  NT : nPhase + (if vdim > 1 then (vdim-1)*vdim else 0),

  if (NT > 0) then (
    transK : delete(dir, makelist(k, k, 1, vdim)),

    if (hamil_rep = "phase") then (
      /* --- Pi_px block: outer factors. Row c of column dir lives at
         NC*((dir-1) + vdim*(c-1)). --- */
      for c : 1 thru cdim do prelude : endcons(printf(false, "const double dx1~a = 2.0/dxv[~a];", c-1, c-1), prelude),
      for c : 1 thru cdim do prelude : endcons(printf(false, "const double jacob_c~a_inv = 1.0/jacob_pos[~a];", clabels[c], (polyOrder+1)*(c-1)), prelude),
      for c : 1 thru cdim do
        prelude : endcons(printf(false, "const double *poisson_tensor_conf_x~a = &poisson_tensor_conf[~a];", (dir-1) + vdim*(c-1), NC*((dir-1) + vdim*(c-1))), prelude),
      for c : 1 thru cdim do outerBody : endcons(printf(false, "double px~a_q = 0.0;", c-1), outerBody),
      outerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) {", NC), outerBody),
      for c : 1 thru cdim do
        outerBody : endcons(printf(false, "  px~a_q += vst_~a_conf_ev[i*~a + a]*poisson_tensor_conf_x~a[a];", c-1, tag, NC, (dir-1) + vdim*(c-1)), outerBody),
      outerBody : endcons("}", outerBody),
      outerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) O[a*~a + i] = -(~a);", NA, num_nodes_conf,
        simplode(makelist(sconcat("px", c-1, "_q*", tabP, "_CmDx", c-1, "[i*", NA, " + a]*dx1", c-1, "*jacob_c", clabels[c], "_inv"), c, 1, cdim), " + ")), outerBody),
      /* --- Pi_px block: inner factors, G[j][a]; the transverse derivative
         contractions Gd_k[j][a] feed dH/dv_k below. --- */
      innerBody : endcons(printf(false, "double G[~a];", NA), innerBody),
      for k in transK do innerBody : endcons(printf(false, "double Gd~a[~a];", k-1, NA), innerBody),
      innerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) { G[a] = 0.0; ~a}", NA,
        if transK = [] then "" else simplode(makelist(sconcat("Gd", k-1, "[a] = 0.0; "), k, transK))), innerBody),
      innerBody : endcons(printf(false, "for (int k = 0; k < ~a; ++k) {", NB), innerBody),
      innerBody : endcons(printf(false, "  const int a = ~a_cmap[k];", tabP), innerBody),
      innerBody : endcons(printf(false, "  G[a] += ~a_V[j*~a + ~a_vrmap[k]]*(~a_coefr[k]*hamil[k]);", tabP, NMV, tabP, tabP), innerBody),
      for k in transK do block([NMd],
        NMd : laxDerivSizes(fact, vv, varsV[k]),
        innerBody : endcons(printf(false, "  Gd~a[a] += ~a_Vd~a[j*~a + ~a_vrd~amap[k]]*(~a_dcoefr~a[k]*hamil[k]);",
          k-1, tabP, k-1, NMd, tabP, k-1, tabP, k-1), innerBody)
      ),
      innerBody : endcons("}", innerBody),
      innerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) I[a*~a + j] = G[a];", NA, num_nodes_vel), innerBody)
      /* For the Pi_pp block below, dH/dv_k(i, j) = sum_a Cm[i][a] Gd_k[j][a]
         is not inner-only: the (k, m) terms get NA sub-terms, one per outer
         shape a. */
    )
    else (
      /* Velocity-space Hamiltonian: dH/dv_k depends on the inner node only;
         the sparse (separable) flavor only references the constant and
         single-velocity-variable coefficients via the shared sparse index list. */
      NS : 0,
      for b : 1 thru NV do
        if length(intersection(setify(listofvars(bV[b])), setify(varsV))) <= 1 then NS : NS + 1,
      for k in transK do (
        innerBody : endcons(printf(false, "double dH_dv~a = 0.0;", k-1), innerBody),
        if (hamil_rep = "vel_sparse") then
          innerBody : append(innerBody, [
            printf(false, "for (int s = 0; s < ~a; ++s) {", NS),
            printf(false, "  const int b = vst_~a_vel_sparse_idx[s];", tag),
            printf(false, "  dH_dv~a += vst_~a_vel_dv~a_v~a[j*~a + b]*hamil[b];", k-1, tag, k-1, dir-1, NV),
            "}"])
        else
          innerBody : endcons(printf(false, "for (int b = 0; b < ~a; ++b) dH_dv~a += vst_~a_vel_dv~a_v~a[j*~a + b]*hamil[b];", NV, k-1, tag, k-1, dir-1, NV), innerBody)
      )
    ),

    /* --- Pi_pp block (vdim > 1): omega_ab = vTrans . Pi; v_dir sits at its
       -1 edge, transverse coordinates come from the shared node table. --- */
    if (vdim > 1) then (
      for m : 1 thru vdim do prelude : endcons(printf(false, "const double *vmap_v~a = &vmap[~a];", m-1, 4*(m-1)), prelude),
      for k in transK do prelude : endcons(printf(false, "const double dv1~a = 2.0/dxv[~a];", k-1, vid[k]), prelude),
      nJPts : vlasovJacSurfStride(basisFun, polyOrder, useHigherOrder),
      /* Inverse transverse Jacobians: per node (inner body) for the cubic
         map, cell constants (prelude) for the linear map. */
      if (vlasovVelMapRep(basisFun) = "cubic") then (
        for k in transK do block([pp, nidx],
          pp : if k < dir then k-1 else k-2,
          if (vdim = 2) then nidx : "j"
          else nidx : if (pp = 0) then sconcat("j/", nJPts) else sconcat("j%", nJPts),
          innerBody : endcons(printf(false, "const double jacob_v~a_inv = 1.0/jacob_vel_surf[~a + ~a];", clabels[k], nJPts*(k-1), nidx), innerBody)
        )
      )
      else (
        for k in transK do prelude : endcons(printf(false, "const double jacob_v~a_inv = 1.0/jacob_vel_surf[~a];", clabels[k], nJPts*(k-1)), prelude)
      ),
      /* Physical velocity at the inner node from the velocity map (p1 linear
         rep or p3 cubic rep 1D modal basis); v_dir at its -1 edge. */
      if (vlasovVelMapRep(basisFun) = "cubic") then block([varsMap1, bMap1, vmapS, xnS, xnSqS, vt_e],
        [varsMap1, bMap1] : loadBasis("Tensor", 1, 3),
        for m : 1 thru vdim do (
          vmapS : eval_string(sconcat("vmap_v", m-1)),
          if (m = dir) then (
            vt_e : float(expand(subst(x = -1, doExpand1(vmapS, bMap1)))),
            innerBody : endcons(printf(false, "const double vt~a = ~a;", m, vt_e), innerBody)
          )
          else block([p],
            p : if m < dir then m-1 else m-2,
            innerBody : endcons(printf(false, "const double xn~a = vst_~a_vel_nodes_v~a[j*~a + ~a];", m-1, tag, dir-1, vdim-1, p), innerBody),
            innerBody : endcons(printf(false, "const double xn~a_sq = xn~a*xn~a;", m-1, m-1, m-1), innerBody),
            xnS : eval_string(sconcat("xn", m-1)),
            xnSqS : eval_string(sconcat("xn", m-1, "_sq")),
            vt_e : float(expand(subst(x = xnS, doExpand1(vmapS, bMap1)))),
            vt_e : subst([xnS^3 = xnS*xnSqS, xnS^2 = xnSqS], vt_e),
            innerBody : endcons(printf(false, "const double vt~a = ~a;", m, vt_e), innerBody)
          )
        )
      )
      else (
        for m : 1 thru vdim do (
          if (m = dir) then
            innerBody : endcons(printf(false, "const double vt~a = ~a*vmap_v~a[0] - ~a*vmap_v~a[1];",
              m, float(1/sqrt(2)), m-1, float(sqrt(3/2)), m-1), innerBody)
          else block([p],
            p : if m < dir then m-1 else m-2,
            innerBody : endcons(printf(false, "const double vt~a = ~a*vmap_v~a[0] + ~a*vmap_v~a[1]*vst_~a_vel_nodes_v~a[j*~a + ~a];",
              m, float(1/sqrt(2)), m-1, float(sqrt(3/2)), m-1, tag, dir-1, vdim-1, p), innerBody)
          )
        )
      ),
      /* omega_ab and the Pi_pp rows (0-based, within the block offset
         vdim*vdim*NC) entering each, with the sign of the term in alpha^dir:
         om12 <- (0,3,6), om13 <- (1,4,7), om23 <- (2,5,8) in 3V; om12 <- (0,1)
         in 2V. Entry = [transverse direction k, rows, sign]. */
      if (vdim = 2) then
        omDefs : (if (dir = 1) then [[2, [0, 1], "+"]] else [[1, [0, 1], "-"]])
      else (
        if (dir = 1) then omDefs : [[2, [0, 3, 6], "+"], [3, [1, 4, 7], "+"]]
        else if (dir = 2) then omDefs : [[1, [0, 3, 6], "-"], [3, [2, 5, 8], "+"]]
        else omDefs : [[1, [1, 4, 7], "-"], [2, [2, 5, 8], "-"]]
      ),
      ppRows : sort(unique(flatten(makelist(om[2], om, omDefs)))),
      for r in ppRows do
        prelude : endcons(printf(false, "const double *poisson_tensor_conf_~a = &poisson_tensor_conf[~a];", r, vdim*vdim*NC + NC*r), prelude),
      for r in ppRows do outerBody : endcons(printf(false, "double p~a_q = 0.0;", r), outerBody),
      outerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) {", NC), outerBody),
      for r in ppRows do
        outerBody : endcons(printf(false, "  p~a_q += vst_~a_conf_ev[i*~a + a]*poisson_tensor_conf_~a[a];", r, tag, NC, r), outerBody),
      outerBody : endcons("}", outerBody),
      /* Term (k, m): outer +/- Pi_pp row, inner v_m dH/dv_k dv1_k / J_v,k. For
         phase Hamiltonians dH/dv_k(i, j) = sum_a Cm[i][a] Gd_k[j][a] adds the
         outer shape a: NA sub-terms per (k, m). */
      tOff : nPhase,
      for kk : 1 thru length(omDefs) do block([k, rows, sgn],
        k : omDefs[kk][1], rows : omDefs[kk][2], sgn : omDefs[kk][3],
        for m : 1 thru vdim do (
          if (hamil_rep = "phase") then (
            outerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) O[(~a + a)*~a + i] = ~ap~a_q*~a_Cm[i*~a + a];",
              NA, tOff, num_nodes_conf, if sgn = "-" then "-" else "", rows[m], tabP, NA), outerBody),
            innerBody : endcons(printf(false, "for (int a = 0; a < ~a; ++a) I[(~a + a)*~a + j] = vt~a*Gd~a[a]*dv1~a*jacob_v~a_inv;",
              NA, tOff, num_nodes_vel, m, k-1, k-1, clabels[k]), innerBody),
            tOff : tOff + NA
          )
          else (
            outerBody : endcons(printf(false, "O[~a*~a + i] = ~ap~a_q;", tOff, num_nodes_conf, if sgn = "-" then "-" else "", rows[m]), outerBody),
            innerBody : endcons(printf(false, "I[~a*~a + j] = vt~a*dH_dv~a*dv1~a*jacob_v~a_inv;", tOff, num_nodes_vel, m, k-1, k-1, clabels[k]), innerBody),
            tOff : tOff + 1
          )
        )
      ),
      NT : tOff
    )
  ),

  alphaEmitFactored(fh, funcNm,
    "const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, const double *hamil",
    NT, num_nodes_conf, num_nodes_vel, prelude, outerBody, innerBody)
)$
