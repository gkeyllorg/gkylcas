/* Generate the two Vlasov kernel headers:
   gkyl_vlasov_kernels.h (vlasov/ker/vlasov): volume, surface, boundary
     surface, Hamiltonian/radiation-drag construction, and Jv utility
     kernels -- everything the vlasov (hyper_dg) updater family calls.
   gkyl_flux_vlasov_kernels.h (vlasov/ker/flux_vlasov): the alpha_quad
     producers and lax_flux_nodal kernels the vlasov_{vel,conf}_flux_surf
     updaters call, plus (via gkyl_vlasov_surf_node_kernels.h) their
     per-node companions. */

/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 1$
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
minVdim_Ser : 1$    /* see begining of v loop below though. */
maxCdim_Ser : 3$
maxVdim_Ser : 3$

/* Tensor product basis. */
/* Tensor p=1 IS the tensor hybrid (p1 conf x p2 vel). */
minPolyOrder_Tensor : 1$
maxPolyOrder_Tensor : 2$
minCdim_Tensor : 1$
minVdim_Tensor : 1$    /* see begining of v loop below though. */
maxCdim_Tensor : 3$
maxVdim_Tensor : 3$

/* ...... END OF USER INPUTS........ */

cvars : [x, y, z]$

bName        : ["ser","tensor"]$
minPolyOrder : [minPolyOrder_Ser, minPolyOrder_Tensor]$
maxPolyOrder : [maxPolyOrder_Ser, maxPolyOrder_Tensor]$
minCdim      : [minCdim_Ser, minCdim_Tensor]$
minVdim      : [minVdim_Ser, minVdim_Tensor]$
maxCdim      : [maxCdim_Ser, maxCdim_Tensor]$
maxVdim      : [maxVdim_Ser, maxVdim_Tensor]$

printPrototype(deco, ci, vi, bStr, pi) := block([si],

  printf(fh, "~avoid vlasov_divide_Jv_~ax~av_~a_p~a(const double *jacob_vel_gauss, const double *Jf, double* GKYL_RESTRICT f_no_J); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_rescale_Jv_~ax~av_~a_p~a(const double *jacob_vel_gauss, const double *Jf, double* GKYL_RESTRICT f_no_J); ~%", deco, ci, vi, bStr, pi),

  printf(fh, "~avoid vlasov_hamil_vel_dense_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, 
    const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  /* Sparse (separable) velocity-space Hamiltonian kernels only exist for vi > 1
     (in 1V sparse and dense are identical; tables alias 1V sparse to dense). */
  if (vi > 1) then (
    printf(fh, "~avoid vlasov_hamil_vel_sparse_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, 
      const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi)
  ),
  if ((ci <= vi  and pi < 3) and not(bStr = "tensor")) then (
    printf(fh, "~avoid vlasov_nc_hamil_vel_dense_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap,
      const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
    if (vi > 1) then (
      printf(fh, "~avoid vlasov_nc_hamil_vel_sparse_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap,
        const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi)
    ),
    if not(ci+vi>=5 and pi>1) then
      printf(fh, "~avoid vlasov_nc_hamil_phase_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap,
      const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi)
  ),
  /* Phase-space Hamiltonian volume: Serendipity and the tensor p=1 hybrid
     (no phase rep for tensor p>1). */
  if ((bStr = "ser" or bStr = "tensor") and not(ci+vi>=5 and pi>1)) then (
    printf(fh, "~avoid vlasov_hamil_phase_vol_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, 
      const double *jacob_pos, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi)
  ),
  printf(fh, "~avoid vlasov_phi_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_pos, const double *jacob_vel, const double *phi, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_E_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_vel, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_Bx_hamil_vel_dense_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_By_hamil_vel_dense_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_Bz_hamil_vel_dense_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  if (vi > 1) then (
    printf(fh, "~avoid vlasov_Bx_hamil_vel_sparse_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
      const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
    printf(fh, "~avoid vlasov_By_hamil_vel_sparse_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
      const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
    printf(fh, "~avoid vlasov_Bz_hamil_vel_sparse_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
      const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi)
  ),
  printf(fh, "~avoid vlasov_Bx_hamil_phase_vol_~ax~av_~a_p~a(const double *w, const double *dxv,
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_By_hamil_phase_vol_~ax~av_~a_p~a(const double *w, const double *dxv,
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_Bz_hamil_phase_vol_~ax~av_~a_p~a(const double *w, const double *dxv,
    const double *jacob_vel, const double *hamil, const double *qmem, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),
  printf(fh, "~avoid vlasov_rad_vol_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_vel, const double *rad, const double *f, double* GKYL_RESTRICT out); ~%", deco, ci, vi, bStr, pi),

  for si : 1 thru ci do (
    printf(fh, "~adouble vlasov_hamil_vel_dense_boundary_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_pos_edge, const double *jacob_pos_skin, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, 
    const int edge, const double *fedge, const double *fskin, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
    printf(fh, "~adouble vlasov_hamil_vel_dense_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv, 
    const double *jacob_pos_l, const double *jacob_pos_c, const double *jacob_pos_r, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, 
    const double *fl, const double *fc, const double *fr, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
    if (vi > 1) then (
      printf(fh, "~adouble vlasov_hamil_vel_sparse_boundary_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv, 
      const double *jacob_pos_edge, const double *jacob_pos_skin, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, 
      const int edge, const double *fedge, const double *fskin, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_hamil_vel_sparse_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv, 
      const double *jacob_pos_l, const double *jacob_pos_c, const double *jacob_pos_r, const double *jacob_vel, const double *poisson_tensor_conf, const double *hamil, 
      const double *fl, const double *fc, const double *fr, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi)
    ),
    /* Conf-direction from-flux consumers: Serendipity, and the tensor p=1
       hybrid (which lands in the else branch and gets both lo and ho_). */
    if ((ci <= vi  and pi < 3) and not(bStr = "tensor" and pi > 1)) then (
      if ((bStr = "ser") and (pi = 1)) or ((bStr = "tensor") and (pi > 1)) then ( 
        printf(fh, "~adouble vlasov_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
        printf(fh, "~adouble vlasov_boundary_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ) 
      else (
        printf(fh, "~adouble vlasov_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
        printf(fh, "~adouble vlasov_boundary_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
        printf(fh, "~adouble vlasov_ho_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
        printf(fh, "~adouble vlasov_boundary_ho_surf~a_~ax~av_~a_p~a(const double *w, const double *dxv,
        const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi)
      )
    ),
    /* The inline phase-Hamiltonian stream-surface kernels were retired:
       canonical-PB models stream through the configuration-space flux
       machinery and the Hamiltonian-agnostic vlasov_(boundary_)(ho_)surf*
       consumers declared above. */
    if ((bStr = "ser") and (pi = 1)) or ((bStr = "tensor") and (pi > 1)) then (
      printf(fhx, "~adouble lax_flux_nodal_~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos_l, const double *jacob_pos_c, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT conf_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid hamil_vel_dense_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid hamil_vel_sparse_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid hamil_phase_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
    )
    else (
      printf(fhx, "~adouble lax_flux_nodal_~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos_l, const double *jacob_pos_c, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT conf_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~adouble ho_lax_flux_nodal_~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos_l, const double *jacob_pos_c, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT conf_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid hamil_vel_dense_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid hamil_vel_sparse_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid hamil_vel_dense_ho_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid hamil_vel_sparse_ho_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid hamil_phase_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid hamil_phase_ho_alpha_quad_~a_~ax~av_~a_p~a(const double *w, const double *dxv, const int hamil_pt_edge,
      const double *vmap, const double *jacob_pos, const double *jacob_vel_surf,
      const double *poisson_tensor_conf, const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
    )
  ),
  for si : 1 thru vi do (
    if ((ci <= vi  and pi < 3) and not(bStr = "tensor")) then (
      if ((bStr = "ser") and (pi = 1)) or ((bStr = "tensor") and (pi > 1)) then ( 
        printf(fhx, "~avoid nc_hamil_vel_dense_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
          const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
        if (vi > 1) then (
          printf(fhx, "~avoid nc_hamil_vel_sparse_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
          const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
        ),
        if not(ci+vi>=5 and pi>1) then printf(fhx, "~avoid nc_hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
          const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      )
      else (
        printf(fhx, "~avoid nc_hamil_vel_dense_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
        if (vi > 1) then (
          printf(fhx, "~avoid nc_hamil_vel_sparse_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
        ),
        printf(fhx, "~avoid nc_hamil_vel_dense_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
        if (vi > 1) then (
          printf(fhx, "~avoid nc_hamil_vel_sparse_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
        ),
        if not(ci+vi>=5 and pi>1) then printf(fhx, "~avoid nc_hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
        if not(ci+vi>=5 and pi>1) then printf(fhx, "~avoid nc_hamil_phase_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf, 
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      )
    ),
    if ((bStr = "ser") and (pi = 1)) or ((bStr = "tensor") and (pi > 1)) then ( 
      printf(fhx, "~adouble lax_flux_nodal_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_vel_surf_l, const double *jacob_vel_surf_r, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT vel_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_boundary_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if ((bStr = "ser" or bStr = "tensor") and not(ci+vi>=5 and pi>1)) then (
        printf(fhx, "~avoid hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf,
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid phi_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos, const double *phi, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi), 
      printf(fhx, "~avoid E_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),   
      printf(fhx, "~avoid B_hamil_vel_dense_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid B_hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid B_hamil_vel_sparse_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
        const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid rad_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *rad, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
    )
    else (
      printf(fhx, "~adouble lax_flux_nodal_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_vel_surf_l, const double *jacob_vel_surf_r, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT vel_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~adouble ho_lax_flux_nodal_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_vel_surf_l, const double *jacob_vel_surf_r, const double *alpha_quad, 
      const double *f_l, const double *f_r, double* GKYL_RESTRICT vel_flux_surf) ; ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_boundary_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_ho_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const double *flux_l, const double *flux_r, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fh, "~adouble vlasov_boundary_ho_surfv~a_~ax~av_~a_p~a(const double *w, const double *dxv,
      const int edge, const double *flux, double* GKYL_RESTRICT out); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if ((bStr = "ser" or bStr = "tensor") and not(ci+vi>=5 and pi>1)) then (
        printf(fhx, "~avoid hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf,
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid phi_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos, const double *phi, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid E_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid B_hamil_vel_dense_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid B_hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid B_hamil_vel_sparse_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
        const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid rad_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *rad, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if ((bStr = "ser" or bStr = "tensor") and not(ci+vi>=5 and pi>1)) then (
        printf(fhx, "~avoid hamil_phase_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *w, const double *dxv, const double *vmap, const double *jacob_pos, const double *jacob_vel_surf, const double *poisson_tensor_conf,
        const double *hamil, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid phi_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *jacob_pos, const double *phi, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi), 
      printf(fhx, "~avoid E_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),   
      printf(fhx, "~avoid B_ho_hamil_vel_dense_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      printf(fhx, "~avoid B_ho_hamil_phase_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
      const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi),
      if (vi > 1) then (
        printf(fhx, "~avoid B_ho_hamil_vel_sparse_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, const double *jacob_vel,
        const double *hamil, const double *qmem, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
      ),
      printf(fhx, "~avoid rad_ho_alpha_quad_v~a_~ax~av_~a_p~a(const double *dxv, 
      const double *rad, double* GKYL_RESTRICT alpha_quad); ~%", deco, cvars[si], ci, vi, bStr, pi)
    )
  ),

  printf(fh, "~%"),
  printf(fhx, "~%")
)$

printPrototypeHamiltonian(deco, vi, bStr, pi) := block([si],
  /* Variations of the Hamiltonian. */
  printf(fh, "~avoid hamil_default_~av_~a_p~a(const double *w, const double *dxv, const double *vmap, double* GKYL_RESTRICT hamil, double* GKYL_RESTRICT hamil_inv); ~%", deco, vi, bStr, pi),
  printf(fh, "~avoid hamil_sr_~av_~a_p~a(const double *w, const double *dxv, const double *vmap, double* GKYL_RESTRICT hamil, double* GKYL_RESTRICT hamil_inv); ~%", deco, vi, bStr, pi),
  printf(fh, "~%")  
)$

printPrototypeRadiation(deco, vi, bStr, pi) := block([si],
  /* Variations of the Radiation. */
  printf(fh, "~avoid rad_compton_~av_~a_p~a(const double *w, const double *dxv, const double *vmap, double t_cool, double p0, double* GKYL_RESTRICT rad); ~%", deco, vi, bStr, pi),
  printf(fh, "~avoid rad_curvature_~av_~a_p~a(const double *w, const double *dxv, const double *vmap, double t_cool, double p0, double* GKYL_RESTRICT rad); ~%", deco, vi, bStr, pi),
  printf(fh, "~%")  
)$

/* ............ Write out the C header files ............ */
fh : openw("~/max-out/gkyl_vlasov_kernels.h")$
fhx : openw("~/max-out/gkyl_flux_vlasov_kernels.h")$

printf(fh, "#pragma once~%")$
printf(fh, "#include <math.h>~%")$
printf(fh, "#include <gkyl_util.h>~%")$
printf(fh, "EXTERN_C_BEG~%")$
printf(fh, "~%")$

printf(fhx, "#pragma once~%")$
printf(fhx, "#include <math.h>~%")$
printf(fhx, "#include <gkyl_util.h>~%")$
printf(fhx, "// Declares the per-node surface kernels with C linkage so their definitions~%")$
printf(fhx, "// in the kernel .c files (compiled as C++ under nvcc) match the unmangled~%")$
printf(fhx, "// references from the dispatch code.~%")$
printf(fhx, "#include <gkyl_vlasov_surf_node_kernels.h>~%")$
printf(fhx, "EXTERN_C_BEG~%")$
printf(fhx, "~%")$

decorator : "GKYL_CU_DH "$
for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    minVdimB : max(c,minVdim[bInd]), 
    maxVdimB : maxVdim[bInd], 
    if (c = 2) then minVdimB : 1, /* We support 2x1v. */
    for v : minVdimB thru maxVdimB do (

      minPolyOrderB : minPolyOrder[bInd],
      maxPolyOrderB : maxPolyOrder[bInd],
      if (v=1) then maxPolyOrderB : 3, /* Generate p=3 kernels if vdim = 1 */
      if (c+v>5 and maxPolyOrderB > 1) then maxPolyOrderB : 1,

      for polyOrder : minPolyOrderB thru maxPolyOrderB do (
        printPrototype(decorator, c, v, bName[bInd], polyOrder)
      )
    )
  ),
  for v : 1 thru maxVdim[bInd] do ( 
    minPolyOrderB : minPolyOrder[bInd],
    maxPolyOrderB : maxPolyOrder[bInd],
    if (v=1) then maxPolyOrderB : 3, /* Generate p=3 kernels if vdim = 1 */
    for polyOrder : minPolyOrderB thru maxPolyOrderB do (
      printPrototypeHamiltonian(decorator, v, bName[bInd], polyOrder), 
      printPrototypeRadiation(decorator, v, bName[bInd], polyOrder)  
    )
  )  
);
printf(fh, "EXTERN_C_END ~%")$
close(fh)$
printf(fhx, "EXTERN_C_END ~%")$
close(fhx)$
/* ............ Finished writing out the C header file ............ */
