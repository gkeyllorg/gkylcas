/* Emit updater selection tables and CUDA call targets from one description.
   Each table is [C name, C element type, nested initializer]. Initializer leaves
   are C function names or "NULL"; nested lists retain the C aggregate shape.
   No knowledge of basis, dimension, stencil, or BC indices is needed here. */
load(stringproc)$

/* Collect non-null function names from every level of the initializer. */
dispatchInitializerTargets(initializer) := block([targets : [], entry],
  if not listp(initializer) then (
    if not stringp(initializer) then error("Expected a C function name or NULL", initializer),
    return(if initializer = "NULL" then [] else [initializer])
  ),

  for entry in initializer do
    targets : append(targets, dispatchInitializerTargets(entry)),

  targets
)$

writeDispatchInitializer(fh, initializer, indent) := block([i, nested : false, entry],
  if not listp(initializer) then return(printf(fh, "~a", initializer)),

  /* Keep leaf rows on one line; indent nested aggregates. */
  for entry in initializer do if listp(entry) then nested : true,
  printf(fh, "{"),
  for i : 1 thru length(initializer) do (
    if nested then printf(fh, "~%~a  ", indent),
    writeDispatchInitializer(fh, initializer[i], sconcat(indent, "  ")),
    if i < length(initializer) then printf(fh, if nested then "," else ", ")
  ),
  if nested then printf(fh, "~%~a", indent),
  printf(fh, "}")
)$

writeKernelDispatchHeader(filename, generator, targetMacro, tables) := block(
  [fh, targets : [], names : [], table, i],

  /* Validate before opening the output, and deduplicate across all tables. */
  for table in tables do (
    if length(table) # 3 then error("Expected [name, type, initializer]", table),
    if member(table[1], names) then error("Duplicate dispatch table", table[1]),
    names : cons(table[1], names),
    targets : append(targets, dispatchInitializerTargets(table[3]))
  ),

  targets : listify(setify(targets)),
  if targets = [] then error("An indirect call must have at least one target"),

  fh : openw(filename),
  printf(fh, "// Generated by gkylcas/~a. Do not edit.~%", generator),
  printf(fh, "// Include after the callback table types and kernel declarations.~%"),
  printf(fh, "#pragma once~%~%"),

  for table in tables do (
    printf(fh, "GKYL_CU_D static const ~a ~a[] = ", table[2], table[1]),
    writeDispatchInitializer(fh, table[3], ""),
    printf(fh, ";~%~%")
  ),

  /* Emit adjacent C strings: ASCII 34 is a quote, 92 a continuation backslash. */
  printf(fh, "// Complete, deduplicated targets for this callback family.~%"),
  printf(fh, "#define ~a ~a~%", targetMacro, ascii(92)),
  for i : 1 thru length(targets) do (
    printf(fh, "  ~a~a~a~a", ascii(34), if i = 1 then "" else ",", targets[i], ascii(34)),
    if i < length(targets) then printf(fh, " ~a", ascii(92)),
    printf(fh, "~%")
  ),

  close(fh)
)$
