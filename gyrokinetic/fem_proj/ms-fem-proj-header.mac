/* Create the header file for the FEM mass projection kernels.
   Run from the gkylcas repository root, independently of ms-fem-proj.mac. */

load(stringproc)$
load("gyrokinetic/fem_proj/fem-proj.mac")$

/* ...... USER INPUTS........ */

/* Match the basis, dimension and order ranges in ms-fem-proj.mac. */
maxPolyOrder_Ser : 2$
minCdim_Ser : 1$
maxCdim_Ser : 2$

/* Output directory must exist. May be set before loading this script. */
if not stringp(fem_proj_out) then fem_proj_out : "~/max-out"$

/* ...... END OF USER INPUTS........ */

bName        : ["ser"]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

disp(printf(false, "Creating gkyl_fem_proj_kernels.h"))$
fname : sconcat(fem_proj_out, "/gkyl_fem_proj_kernels.h")$
fh    : openw(fname)$
printf(fh, "/* Generated by gkylcas/gyrokinetic/fem_proj/ms-fem-proj-header.mac. */~%")$
printf(fh, "#pragma once~%")$
printf(fh, "#include <gkyl_util.h>~%")$
printf(fh, "#include <gkyl_mat_triples.h>~%")$
printf(fh, "EXTERN_C_BEG~%")$

for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : 1 thru maxPolyOrder[bInd] do (
      funcName : sconcat("fem_proj_", c, "x_", bName[bInd], "_p", polyOrder),

      /* Global node count and local-to-global grid node indices. */
      printf(fh, "long ~a_num_nodes(const int *cells, const bool *periodic);~%", funcName),
      for periodicMask : 0 thru 2^c-1 do (
        for upperMask : 0 thru 2^c-1 do (
          suffix : fem_proj_l2g_suffix(c, periodicMask, upperMask),
          printf(fh, "GKYL_CU_DH void ~a_local_to_global~a(const int *num_cells, const int *idx, long *global_idx);~%", funcName, suffix)
        )
      ),

      /* Mass uses constrained-face flags; source distinguishes constant/varying data. */
      for weighted in [false, true] do (
        weightSuffix : if weighted then "_weighted" else "_noweight",
        for code : 0 thru 2^(2*c)-1 do (
          suffix : fem_proj_bc_suffix(fem_proj_face_types(c,code,2)),
          printf(fh, "void ~a_mass~a~a(const double *weight, const long *global_idx, gkyl_mat_triples *matrix);~%",
            funcName,weightSuffix,suffix)
        ),
        for code : 0 thru 3^(2*c)-1 do (
          suffix : fem_proj_bc_suffix(fem_proj_face_types(c,code,3)),
          printf(fh, "GKYL_CU_DH void ~a_src~a~a(const double *weight, const double *rhs, const double *bc_values, const double *boundary_values, const long *global_idx, double *out);~%",
            funcName,weightSuffix,suffix)
        )
      ),
      printf(fh, "GKYL_CU_DH void ~a_sol(const double *input, double *out);~%",funcName)
    )
  )
)$

printf(fh, "EXTERN_C_END~%")$
close(fh)$
