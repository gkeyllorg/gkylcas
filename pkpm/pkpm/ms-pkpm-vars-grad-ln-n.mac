load("pkpm/pkpm/pkpm-vars-grad-ln-n.mac")$
load(stringproc)$
/* This script generates the kernels pkpm_vars_grad_ln_n_<c>x_ser_p1 computing
   grad(ln n) from the weak gradient of rho (see pkpm-vars-grad-ln-n.mac). */
for c : 1 thru 3 do (
  funcName : sconcat("pkpm_vars_grad_ln_n_", c, "x_ser_p1"),
  disp(printf(false, "Creating ~a", funcName)),
  fh : openw(sconcat("~/max-out/", funcName, ".c")),
  calcPKPMVarsGradLnN(fh, funcName, c, "ser", 1),
  close(fh)
)$
