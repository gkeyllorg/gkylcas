/* pkpm-fluid-flux-kinetic.mac ----------------------------------------------------------
   Fluid face fluxes of the (p=1) energy-constrained PKPM solver as the moments of the
   kinetic configuration-space flux of the eight blocks X = [F, G, M0_perp, N_perp], so that the
   fluid system [rho, M, E] and the normalized distributions see ONE discrete transport (plan
   17.14; notes, eq. fluid-flux-map).

   At a face node and a w node the kinetic flux (pkpm-conf-flux-surf.mac, pkpm_harm_conf_flux) is
   the HLL flux of the eight blocks, split into the contributions of the two sides,
     Phi = Phi^l + Phi^r,  Phi^l = A_l X_l + (S_R/ds) T_l,  Phi^r = A_r X_r - (S_L/ds) T_r,
   with T the first-harmonic coupling (xi M0_d, xi N_d, xi G (e_d - b b_d), xi H (e_d - b b_d)).
   Since f = n F/xi with v = u + xi (w b + z) on each side, the physical fluxes are the moment map
   of each contribution with its own frame. With the one-sided moments I_k^s = int w^k Phi^s_F dw
   (k = 0, 1, 2), I_G^s = int Phi^s_G dw and I_M^s = int Phi^s_M0 dw (three components),
     F_rho = sum_s rho_s I_0^s,
     F_M   = sum_s rho_s (u^s I_0^s + xi^s b^s I_1^s + xi^s I_M^s),
     F_E   = sum_s rho_s (|u^s|^2/2 I_0^s + xi^s (b^s.u^s) I_1^s + xi^s u^s.I_M^s
                          + (xi^s)^2 (I_2^s/2 + I_G^s)).
   xi G (e_d - b b_d) in the M0 flux carries the perpendicular pressure force and its work (no
   separate central term), xi M0_d and xi N_d the first-harmonic mass and heat fluxes; the HLL
   dissipation of rho, rho u and E is the moment of S_L S_R (X_r - X_l). Every xi is the trace of
   the cell's xi expansion that defines the w of the traces (xi^2 the square of that trace).

   Two kernels per direction (the face is the LOWER face of the r cell in direction d; the
   l cell is its lower neighbor, evaluated at its upper edge):
   - pkpm_fluid_flux_accum_<d>_<c>x1v_ser_p1(w, dxv, jacob_pos_l, jacob_pos_r, b_l, b_r, u_l, u_r,
       xi_l, xi_r, theta_l, theta_r, f_l, f_r, I):
     accumulates the nodal moments I[k*NN + n], k = 0..6 for [I_0, I_1, I_2, I_G, I_Mx, I_My, I_Mz]^l
     then k = 7..13 the same for r, of one velocity cell at the NN transverse nodes of the face,
     with the node loop of the kinetic flux kernel (pkpmEmitConfFaceFlux: same traces, same HLL).
     The traces of the Jacobian-weighted J X are divided by J_d of their cell, so the moments carry
     the face Jacobian J/J_d of the evolved J-weighted fluid, as the kinetic flux does.
   - pkpm_fluid_flux_<d>_<c>x_ser_p1(bvar_l, bvar_r, u_l, u_r, xi_l, xi_r, fluid_l, fluid_r, I, flux):
     forms the fluxes above at the nodes from the PHYSICAL traces of both cells and projects them
     onto the surface basis: flux = [F_rho, F_x, F_y, F_z, F_E] (NSurf each), the layout read by
     pkpm_fluid_surf<d>_<c>x_ser_p1. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
load("core/nodal_operations/quadrature_functions.mac")$
load("pkpm/pkpm/pkpm-flux-tables.mac")$
load("pkpm/pkpm/pkpm-conf-flux-surf.mac")$
load("pkpm/pkpm/pkpm-fluid-flux-surf.mac")$
load("pkpm/pkpm/pkpm-cas-util.mac")$
load(stringproc)$

/* Number of nodal moments per side and face node: [I_0, I_1, I_2, I_G, I_Mx, I_My, I_Mz]. */
pkpmFluidNumMoms : 7$

calcPKPMFluidFluxKineticAccum(dir, fh, funcNm, cdim) := block([sz, NN, NI, cvarsStr],
  sz : pkpmConfFaceSizes(dir, cdim),
  NN : sz[3], NI : sz[4],
  cvarsStr : ["x", "y", "z"],
  printf(fh, "#include <gkyl_pkpm_fluid_kernels.h> ~%"),
  printf(fh, "#include <gkyl_pkpm_harm_coeffs.h> ~%"),
  pkpmFluxTabInclude(fh, cdim),
  pkpmEmitConfFaceStage1(fh, funcNm, dir, cdim),
  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv,
  const double *jacob_pos_l, const double *jacob_pos_r, const double *b_l, const double *b_r,
  const double *u_l, const double *u_r, const double *xi_l, const double *xi_r,
  const double *theta_l, const double *theta_r, const double *f_l, const double *f_r,
  double* GKYL_RESTRICT I) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:   Cell-center coordinates of the phase-space cell (r side). ~%"),
  printf(fh, "  // dxv[NDIM]: Cell spacing of the phase-space cell. ~%"),
  printf(fh, "  // jacob_pos_l/r: Position-map Jacobian per configuration direction (cdim blocks of 2 equal ~%"),
  printf(fh, "  //            entries) of the left/right cell. ~%"),
  printf(fh, "  // b_l/r:     Magnetic field unit vector [bx, by, bz] of the left/right cell. ~%"),
  printf(fh, "  // u_l/r:     Flow velocity [ux, uy, uz] of the left/right cell. ~%"),
  printf(fh, "  // xi_l/r:    Thermal speed [xi, xi^2, p] of the left/right cell (the first expansion is used). ~%"),
  printf(fh, "  // theta_l/r: T_perp/T of the left/right cell. ~%"),
  printf(fh, "  // f_l/r:     Jacobian-weighted normalized distributions J [F, G, M0_perp, N_perp] of the left/right ~%"),
  printf(fh, "  //            phase-space cell. ~%"),
  printf(fh, "  // I:         Accumulated nodal moments of the kinetic HLL flux at the ~a transverse face nodes: ~%", NN),
  printf(fh, "  //            I[k*~a + n], k = 0..6 for [int Phi_F, int w Phi_F, int w^2 Phi_F, int Phi_G, int Phi_M0 (x, y, z)] ~%", NN),
  printf(fh, "  //            of the left contribution Phi^l and k = 7..13 the same of the right one; the traces are ~%"),
  printf(fh, "  //            divided by J_~a of their cell, so the moments carry the face Jacobian J/J_~a. ~%", cvarsStr[dir], cvarsStr[dir]),
  printf(fh, "  // Returns the largest width S_R - S_L of the speed bounds over the nodes (for the CFL rate). ~%"),
  printf(fh, "  // Gauss-Legendre weights in w times 1/2 (the w integral of a cell is dv sum_j wg[j] (.)_j) ~%"),
  printf(fh, "  const double wg[~a] = {~{~a~^, ~}}; ~%", NI, float(0.5*gaussOrdWeight(pkpmConfFluxNumWPts, 1)[2])),
  printf(fh, "  double alpha_max = 0.0; ~%"),
  pkpmEmitConfFaceFlux(fh, funcNm, dir, cdim, lambda([fh],
    printf(fh, "      const double wgt = wg[j]*dv; ~%"),
    printf(fh, "      I[~a + i] += wgt*phi_l[0]; ~%", 0*NN),
    printf(fh, "      I[~a + i] += wgt*wq*phi_l[0]; ~%", 1*NN),
    printf(fh, "      I[~a + i] += wgt*wq*wq*phi_l[0]; ~%", 2*NN),
    printf(fh, "      I[~a + i] += wgt*phi_l[1]; ~%", 3*NN),
    printf(fh, "      for (int a = 0; a < 3; ++a) I[(4 + a)*~a + i] += wgt*phi_l[2 + a]; ~%", NN),
    printf(fh, "      I[~a + i] += wgt*phi_r[0]; ~%", 7*NN),
    printf(fh, "      I[~a + i] += wgt*wq*phi_r[0]; ~%", 8*NN),
    printf(fh, "      I[~a + i] += wgt*wq*wq*phi_r[0]; ~%", 9*NN),
    printf(fh, "      I[~a + i] += wgt*phi_r[1]; ~%", 10*NN),
    printf(fh, "      for (int a = 0; a < 3; ++a) I[(11 + a)*~a + i] += wgt*phi_r[2 + a]; ~%", NN),
    printf(fh, "      alpha_max = fmax(alpha_max, sb[1] - sb[0]); ~%"))),
  printf(fh, "  return alpha_max; ~%"),
  printf(fh, "} ~%")
)$

calcPKPMFluidFluxKinetic(dir, fh, funcNm, cdim) := block(
  [varsC, bC, NC, cv, surfVars, sf, bSurf, nodes, weights, NN, NSurf, i, n, c, k, chi, expr,
   cvarsStr, side, sd, edge, off],

  cdimGlobal : cdim,
  kill(varsC, bC),
  [varsC, bC] : loadBasis("ser", cdim, 1),
  NC : length(bC),
  cv : varsC[dir],
  surfVars : delete(cv, varsC),
  sf : pkpmFluidSurf(cdim, surfVars),
  bSurf : sf[1], nodes : sf[2], weights : sf[3],
  NN : length(nodes),
  NSurf : length(bSurf),
  cvarsStr : ["x", "y", "z"],

  printf(fh, "#include <gkyl_pkpm_fluid_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(const double *bvar_l, const double *bvar_r,
  const double *u_l, const double *u_r, const double *xi_l, const double *xi_r,
  const double *fluid_l, const double *fluid_r, const double *I, double* GKYL_RESTRICT flux) ~%{ ~%", funcNm),
  printf(fh, "  // bvar_l/r:  Magnetic field unit vector [bx, by, bz] of the left/right cell. ~%"),
  printf(fh, "  // u_l/r:     Flow velocity [ux, uy, uz] of the left/right cell. ~%"),
  printf(fh, "  // xi_l/r:    Thermal speed [xi, xi^2, p] of the left/right cell (the first expansion is used: ~%"),
  printf(fh, "  //            xi^2 is the square of its trace, the xi of the streaming speed). ~%"),
  printf(fh, "  // fluid_l/r: PHYSICAL fluid state [rho, rho ux, rho uy, rho uz, E] of the left/right cell (Jacobian divided out). ~%"),
  printf(fh, "  // I:         Nodal moments [I_0, I_1, I_2, I_G, I_M (3)]^l, then ^r, of the kinetic HLL flux at the ~%"),
  printf(fh, "  //            ~a face nodes (pkpm_fluid_flux_accum_~a_~ax1v_ser_p1 summed over the velocity cells); ~%", NN, cvarsStr[dir], cdim),
  printf(fh, "  //            they carry the face Jacobian J/J_~a. ~%", cvarsStr[dir]),
  printf(fh, "  // flux:      Output modal surface fluxes [F_rho, F_x, F_y, F_z, F_E] of the lower face of the right ~%"),
  printf(fh, "  //            cell for the evolved J-weighted fluid. ~%"),
  for side : 1 thru 2 do (
    sd : if side = 1 then "l" else "r",
    printf(fh, "  const double *rho_~a = &fluid_~a[0]; ~%", sd, sd),
    printf(fh, "  const double *xd_~a = &xi_~a[0]; ~%", sd, sd),
    for i : 1 thru 3 do (
      printf(fh, "  const double *b~a_~a = &bvar_~a[~a]; ~%", i-1, sd, sd, (i-1)*NC),
      printf(fh, "  const double *u~a_~a = &u_~a[~a]; ~%", i-1, sd, sd, (i-1)*NC)
    )
  ),
  printf(fh, " ~%"),
  for side : 1 thru 2 do (
    sd : if side = 1 then "l" else "r",
    edge : if side = 1 then 1 else -1,
    printf(fh, "  double rq_~a[~a] = {0.0}; ~%", sd, NN),
    printf(fh, "  double xq_~a[~a] = {0.0}; ~%", sd, NN),
    for i : 1 thru 3 do (
      printf(fh, "  double bq~a_~a[~a] = {0.0}; ~%", i-1, sd, NN),
      printf(fh, "  double uq~a_~a[~a] = {0.0}; ~%", i-1, sd, NN)
    ),
    pkpmWriteFaceEvals(fh, sconcat("rq_", sd), concat(rho_, sd), bC, cv, edge, surfVars, nodes),
    pkpmWriteFaceEvals(fh, sconcat("xq_", sd), concat(xd_, sd), bC, cv, edge, surfVars, nodes),
    for i : 1 thru 3 do (
      pkpmWriteFaceEvals(fh, sconcat("bq", i-1, "_", sd), concat(b, i-1, '_, sd), bC, cv, edge, surfVars, nodes),
      pkpmWriteFaceEvals(fh, sconcat("uq", i-1, "_", sd), concat(u, i-1, '_, sd), bC, cv, edge, surfVars, nodes)
    )
  ),
  printf(fh, " ~%"),
  printf(fh, "  // Nodal fluxes [F_rho, F_x, F_y, F_z, F_E]: the moment maps of the two one-sided contributions. ~%"),
  printf(fh, "  double Fq[~a] = {0.0}; ~%", 5*NN),
  printf(fh, "  for (int n = 0; n < ~a; ++n) { ~%", NN),
  for side : 1 thru 2 do (
    sd : if side = 1 then "l" else "r",
    off : (side-1)*pkpmFluidNumMoms,
    printf(fh, "    { ~%"),
    printf(fh, "      const double I0 = I[~a + n], I1 = I[~a + n], I2 = I[~a + n], J0 = I[~a + n]; ~%",
      off*NN, (off+1)*NN, (off+2)*NN, (off+3)*NN),
    printf(fh, "      const double IM[3] = {I[~a + n], I[~a + n], I[~a + n]}; ~%", (off+4)*NN, (off+5)*NN, (off+6)*NN),
    printf(fh, "      const double rq = rq_~a[n], xq = xq_~a[n], x2q = xq*xq; ~%", sd, sd),
    printf(fh, "      const double bu = bq0_~a[n]*uq0_~a[n] + bq1_~a[n]*uq1_~a[n] + bq2_~a[n]*uq2_~a[n]; ~%", sd, sd, sd, sd, sd, sd),
    printf(fh, "      const double uu = uq0_~a[n]*uq0_~a[n] + uq1_~a[n]*uq1_~a[n] + uq2_~a[n]*uq2_~a[n]; ~%", sd, sd, sd, sd, sd, sd),
    printf(fh, "      const double uIM = uq0_~a[n]*IM[0] + uq1_~a[n]*IM[1] + uq2_~a[n]*IM[2]; ~%", sd, sd, sd),
    printf(fh, "      Fq[n] += rq*I0; ~%"),
    for i : 1 thru 3 do
      printf(fh, "      Fq[~a + n] += rq*(uq~a_~a[n]*I0 + xq*bq~a_~a[n]*I1) + rq*xq*IM[~a]; ~%",
        i*NN, i-1, sd, i-1, sd, i-1),
    printf(fh, "      Fq[~a + n] += 0.5*rq*(uu*I0 + 2.0*xq*bu*I1 + x2q*I2) + rq*x2q*J0 + rq*xq*uIM; ~%", 4*NN),
    printf(fh, "    } ~%")
  ),
  printf(fh, "  } ~%"),
  printf(fh, " ~%"),
  printf(fh, "  // Projection of the nodal fluxes onto the surface basis. ~%"),
  for c : 1 thru 5 do (
    for k : 1 thru NSurf do (
      expr : "",
      for n : 1 thru NN do (
        chi : if cdim > 1 then subst(makelist(surfVars[d] = nodes[n][d], d, 1, cdim-1), bSurf[k]) else 1,
        expr : sconcat(expr, if n > 1 then " + " else "", float(expand(weights[n]*chi)), "*Fq[", (c-1)*NN + n-1, "]")
      ),
      printf(fh, "  flux[~a] = ~a; ~%", (c-1)*NSurf + k-1, expr)
    )
  ),
  printf(fh, "} ~%")
)$
