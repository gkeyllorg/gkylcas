/* This script generates the kernels for limiting the fluid equations in DG. 
   Limiter is a characteristic limiter that computes the waves and 
   limits the slopes based on the characteristic variables. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac")$
fpprec : 24$

/* isIso = false: Euler, [rho, rho ux, rho uy, rho uz, energy], with the Roe waves of the Euler
   wave equation at the cell average. isIso = true: isothermal Euler, [rho, rho ux, rho uy, rho uz],
   with the waves of the isothermal flux Jacobian at the cell average (the Roe waves of the
   isothermal wave equation for equal left and right states, whose solvers are not inlined). */
calcEulerLimiter(dir, fh, funcNm, cdim, basisFun, polyOrder, isIso) := block(
  [varsC, bC, NC, numEq, flds, rotLocal, s, k],

  kill(varsC, bC),

  /* Load basis of dimensionality requested. */
  [varsC,bC] : loadBasis(basisFun, cdim, polyOrder),

  /* Number of basis monomials. */
  NC : length(bC),

  numEq : if isIso then 4 else 5,
  flds : ["rho", "rhoux", "rhouy", "rhouz", "energy"],
  rotLocal : if isIso then "iso_euler_rot_to_local" else "rot_to_local",

  if isIso then (
    printf(fh, "#include <gkyl_iso_euler_kernels.h> ~%"),
    printf(fh, "#include <gkyl_wv_iso_euler_priv.h> ~%")
  ) else
    printf(fh, "#include <gkyl_euler_kernels.h> ~%"),
  printf(fh, "GKYL_CU_DH void ~a(double limiter_fac, const struct gkyl_wv_eqn *wv_eqn, 
  const struct gkyl_wave_cell_geom *geom, 
  double *fluid_l, double *fluid_c, double *fluid_r)~%{ ~%", funcNm),
  printf(fh, "  // limiter_fac:            Factor for relationship between cell slopes and cell average differences (by default: 1/sqrt(3)).~%"),
  printf(fh, "  // wv_eqn:                 Wave equation for computing waves for limiting characteristics.~%"),
  printf(fh, "  // geom:                   Geometry on the left (*only works with Cartesian components*).~%"),
  if isIso then
    printf(fh, "  // fluid_l/c/r: [rho, rho ux, rho uy, rho uz], Fluid input state vector in left/center/right cells.~%")
  else
    printf(fh, "  // fluid_l/c/r: [rho, rho ux, rho uy, rho uz, energy], Fluid input state vector in left/center/right cells.~%"),
  printf(fh, "~%"),

  printf(fh, "  const double *norm = geom->norm[~a]; ~%", dir-1),
  printf(fh, "  const double *tau1 = geom->tau1[~a]; ~%", dir-1),
  printf(fh, "  const double *tau2 = geom->tau2[~a]; ~%", dir-1),
  printf(fh, "~%"),

  for s in ["l", "c", "r"] do (
    for k : 1 thru numEq do
      printf(fh, "  double *~a_~a = &fluid_~a[~a]; ~%", flds[k], s, s, (k-1)*NC),
    printf(fh, "~%")
  ),

  /* State vector from cell averages on left, center, and right */
  for s in ["l", "c", "r"] do (
    printf(fh, "  double q_avg_~a[~a] = {0.0}; ~%", s, numEq),
    for k : 1 thru numEq do
      printf(fh, "  q_avg_~a[~a] = ~a_~a[0]; ~%", s, k-1, flds[k], s)
  ),

  /* Rotate to local coordinates */
  for s in ["l", "c", "r"] do
    printf(fh, "  double q_~a_local[~a] = {0.0}; ~%", s, numEq),
  for s in ["l", "c", "r"] do
    printf(fh, "  ~a(wv_eqn, tau1, tau2, norm, q_avg_~a, q_~a_local); ~%", rotLocal, s, s),
  printf(fh, "~%"),

  /* Compute jumps for calculating fluctuations */
  for s in ["l", "c", "r"] do
    printf(fh, "  double delta_~a[~a] = {0.0}; ~%", s, numEq),

  for k : 1 thru numEq do
    printf(fh, "  delta_l[~a] = limiter_fac*(q_c_local[~a] - q_l_local[~a]); ~%", k-1, k-1, k-1),

  for k : 1 thru numEq do
    printf(fh, "  delta_c[~a] = ~a_c[~a]; ~%", k-1, flds[k], dir),

  for k : 1 thru numEq do
    printf(fh, "  delta_r[~a] = limiter_fac*(q_r_local[~a] - q_c_local[~a]); ~%", k-1, k-1, k-1),
  printf(fh, "~%"),

  /* Rotate the slopes into the local coordinate system */
  printf(fh, "  double delta_c_local[~a] = {0.0}; ~%", numEq),
  printf(fh, "  ~a(wv_eqn, tau1, tau2, norm, delta_c, delta_c_local); ~%", rotLocal),
  printf(fh, "~%"),

  /* Compute local waves and speeds at interface */
  for s in ["l", "c", "r"] do
    printf(fh, "  double waves_slope_~a[~a] = {0.0}; ~%", s, 3*numEq),
  if isIso then (
    printf(fh, "  // Waves of the isothermal flux Jacobian at the cell average: the two sound waves ~%"),
    printf(fh, "  // (u -+ vt) and the shear wave (u). ~%"),
    printf(fh, "  const double vt = container_of(wv_eqn, struct wv_iso_euler, eqn)->vt; ~%"),
    printf(fh, "  const double u_n = q_c_local[1]/q_c_local[0]; ~%"),
    printf(fh, "  const double u_t1 = q_c_local[2]/q_c_local[0]; ~%"),
    printf(fh, "  const double u_t2 = q_c_local[3]/q_c_local[0]; ~%"),
    for s in [["l", "delta_l"], ["c", "delta_c_local"], ["r", "delta_r"]] do (
      printf(fh, "  const double am_~a = 0.5*(~a[0]*(vt + u_n) - ~a[1])/vt; ~%", s[1], s[2], s[2]),
      printf(fh, "  const double ap_~a = 0.5*(~a[0]*(vt - u_n) + ~a[1])/vt; ~%", s[1], s[2], s[2]),
      printf(fh, "  waves_slope_~a[0] = am_~a; ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[1] = am_~a*(u_n - vt); ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[2] = am_~a*u_t1; ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[3] = am_~a*u_t2; ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[6] = ~a[2] - ~a[0]*u_t1; ~%", s[1], s[2], s[2]),
      printf(fh, "  waves_slope_~a[7] = ~a[3] - ~a[0]*u_t2; ~%", s[1], s[2], s[2]),
      printf(fh, "  waves_slope_~a[8] = ap_~a; ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[9] = ap_~a*(u_n + vt); ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[10] = ap_~a*u_t1; ~%", s[1], s[1]),
      printf(fh, "  waves_slope_~a[11] = ap_~a*u_t2; ~%", s[1], s[1])
    )
  ) else (
    printf(fh, "  double speeds[3] = {0.0}; ~%"),
    printf(fh, "  double my_max_speed_l = wave_roe(wv_eqn, delta_l, q_c_local, q_c_local, waves_slope_l, speeds); ~%"),
    printf(fh, "  double my_max_speed_c = wave_roe(wv_eqn, delta_c_local, q_c_local, q_c_local, waves_slope_c, speeds); ~%"),
    printf(fh, "  double my_max_speed_r = wave_roe(wv_eqn, delta_r, q_c_local, q_c_local, waves_slope_r, speeds); ~%")
  ),
  printf(fh, "~%"),

  printf(fh, "  double mm[~a] = {0.0}; ~%", 3*numEq),
  printf(fh, "  double slope[~a] = {0.0}; ~%", numEq),

  printf(fh, "  for (int i = 0; i < 3; ++i) { ~%"),

  printf(fh, "    mm[~a*i] = gkyl_minmod(waves_slope_c[~a*i], waves_slope_l[~a*i], waves_slope_r[~a*i]); ~%", numEq, numEq, numEq, numEq),
  for k : 2 thru numEq do
    printf(fh, "    mm[~a*i+~a] = gkyl_minmod(waves_slope_c[~a*i+~a], waves_slope_l[~a*i+~a], waves_slope_r[~a*i+~a]); ~%", numEq, k-1, numEq, k-1, numEq, k-1, numEq, k-1),
  printf(fh, "    slope[0] += mm[~a*i]; ~%", numEq),
  for k : 2 thru numEq do
    printf(fh, "    slope[~a] += mm[~a*i+~a]; ~%", k-1, numEq, k-1),
  printf(fh, "  } ~%"),
  printf(fh, "~%"),

  printf(fh, "  // Rotate limited slope back to global coordinates ~%"), 
  printf(fh, "  rho_c[~a] = slope[0]; ~%", dir), 
  printf(fh, "  rhoux_c[~a] = slope[1]*norm[0] + slope[2]*tau1[0] + slope[3]*tau2[0]; ~%", dir), 
  printf(fh, "  rhouy_c[~a] = slope[1]*norm[1] + slope[2]*tau1[1] + slope[3]*tau2[1]; ~%", dir), 
  printf(fh, "  rhouz_c[~a] = slope[1]*norm[2] + slope[2]*tau1[2] + slope[3]*tau2[2]; ~%", dir), 
  if not isIso then printf(fh, "  energy_c[~a] = slope[4]; ~%", dir), 

  if (polyOrder > 1 or cdim > 1) then (
    /* The higher coefficients of a component are dropped when the limiter changed its slope.
       The test is on the components in the local (rotated) frame: a limited local momentum
       component drops the higher coefficients of the global momentum components it projects onto. */
    /* A component counts as limited when the slopes of its waves changed by more than round-off:
       the summed change against the size of the component (its averages in the three cells) plus
       the summed size of its slopes there. */
    printf(fh, "  // Components (in the local frame) whose slope the limiter changed by more than round-off: ~%"),
    printf(fh, "  // the change summed over the waves against the size of the component and of its slopes in ~%"),
    printf(fh, "  // the three cells. ~%"),
    printf(fh, "  int is_limited[~a] = {0}; ~%", numEq),
    printf(fh, "  for (int k = 0; k < ~a; ++k) { ~%", numEq),
    printf(fh, "    double slope_change = 0.0; ~%"),
    printf(fh, "    double slope_size = fabs(q_l_local[k]) + fabs(q_c_local[k]) + fabs(q_r_local[k]); ~%"),
    printf(fh, "    for (int i = 0; i < 3; ++i) { ~%"),
    printf(fh, "      slope_change += fabs(mm[~a*i+k] - waves_slope_c[~a*i+k]); ~%", numEq, numEq),
    printf(fh, "      slope_size += fabs(waves_slope_c[~a*i+k]) + fabs(waves_slope_l[~a*i+k]) + fabs(waves_slope_r[~a*i+k]); ~%", numEq, numEq, numEq),
    printf(fh, "    } ~%"),
    printf(fh, "    is_limited[k] = slope_change > 1.0e-12*slope_size; ~%"),
    printf(fh, "  } ~%"),
    printf(fh, "  // A limited local momentum component drops the higher coefficients of the global ~%"),
    printf(fh, "  // momentum components it projects onto. ~%"),
    printf(fh, "  int is_limited_ux = (is_limited[1] && norm[0] != 0.0) || (is_limited[2] && tau1[0] != 0.0) || (is_limited[3] && tau2[0] != 0.0); ~%"),
    printf(fh, "  int is_limited_uy = (is_limited[1] && norm[1] != 0.0) || (is_limited[2] && tau1[1] != 0.0) || (is_limited[3] && tau2[1] != 0.0); ~%"),
    printf(fh, "  int is_limited_uz = (is_limited[1] && norm[2] != 0.0) || (is_limited[2] && tau1[2] != 0.0) || (is_limited[3] && tau2[2] != 0.0); ~%"),

    printf(fh, "  if (is_limited[0]) { ~%"),
    for j : 1 thru (NC-1-cdim) do (
      printf(fh, "    rho_c[~a] = 0.0; ~%", j+cdim)
    ),
    printf(fh, "  } ~%"),

    printf(fh, "  if (is_limited_ux) { ~%"),
    for j : 1 thru (NC-1-cdim) do (
      printf(fh, "    rhoux_c[~a] = 0.0; ~%", j+cdim)
    ),
    printf(fh, "  } ~%"),

    printf(fh, "  if (is_limited_uy) { ~%"),
    for j : 1 thru (NC-1-cdim) do (
      printf(fh, "    rhouy_c[~a] = 0.0; ~%", j+cdim)
    ),
    printf(fh, "  } ~%"),

    printf(fh, "  if (is_limited_uz) { ~%"),
    for j : 1 thru (NC-1-cdim) do (
      printf(fh, "    rhouz_c[~a] = 0.0; ~%", j+cdim)
    ),
    printf(fh, "  } ~%"),

    if not isIso then (
      printf(fh, "  if (is_limited[4]) { ~%"),
      for j : 1 thru (NC-1-cdim) do (
        printf(fh, "    energy_c[~a] = 0.0; ~%", j+cdim)
      ),
      printf(fh, "  } ~%")
    )
  ),
  printf(fh, "} ~%")
)$
