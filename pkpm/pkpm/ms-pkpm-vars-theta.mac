load("pkpm/pkpm/pkpm-vars-theta.mac")$
load(stringproc)$
/* This script generates the kernels computing theta = T_perp/m = p_perp/rho by a
   pointwise quotient at the Gauss-Legendre nodes and interpolation to the p=1 modal
   basis (see pkpm-vars-theta.mac). Only p=1 is generated. */

/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 1$
maxPolyOrder_Ser : 1$
minCdim_Ser : 1$
maxCdim_Ser : 3$

/* ...... END OF USER INPUTS........ */

bName        : ["ser"]$
minPolyOrder : [minPolyOrder_Ser]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : minPolyOrder[bInd] thru maxPolyOrder[bInd] do (
      disp(printf(false,sconcat("Creating pkpm_vars_theta ",bName[bInd]," ~axp~a"),c,polyOrder)),
      fname : sconcat("~/max-out/pkpm_vars_theta_", c, "x_", bName[bInd], "_p", polyOrder, ".c"),
      fh : openw(fname),
      funcName : sconcat("pkpm_vars_theta_", c, "x_", bName[bInd], "_p", polyOrder),
      calcPKPMVarsTheta(fh, funcName, c, bName[bInd], polyOrder),
      close(fh)
    )
  )
);
