/* This script generates the kernels for the surface term
   diffusion contribution from Lenard Bernstein operator. */

load("core/modal-basis.mac")$
load("util_maxima/out-scripts.mac");
load("core/recovery.mac")$
load(stringproc)$
load("pkpm/pkpm/lbo-pkpm-blocks.mac")$
fpprec : 24$

makelistNoZeros(vals, name) := makelist(if vals[i] # 0 then name[i-1] else 0, i, 1, length(vals))$

calcVlasovPKPMLBODiffSurfUpdater(fh, funcNm, cdim, vdim, basisFun, polyOrder) := block(
  [varsC,bC,varsP,bP,NP,NC,pDim,bType,h_e,nuVtSqSum_e,temp_diff_c,diff_incr_c],

  /* Load basis of dimensionality requested. */
  [varsC,bC,varsP,bP] : loadPhaseBasis(if polyOrder=1 then "hyb" else basisFun, cdim, vdim, polyOrder),

  /* Number of basis monomials. */
  NP : length(bP),  NC : length(bC),
  
  pDim : cdim+vdim,

  /* Construct the recovery polynomial */
  if polyOrder=1 then /* Force p=1 to mean hybrid. */
    bType : "hyb"
  else
    bType : basisFun,
  /* The same diffusion acts on every block (F_0, G_1, M0_perp, N_perp). */
  blk : pkpmLBOBlocks,
  h_e : makelist(calcRecov1CellGen(bType, vx, varsP, polyOrder, 1,
          dg(makelist(arraymake(parse_string(sconcat(blk[k], "l")), [i-1]),i,1,NP)),
          dg(makelist(arraymake(parse_string(sconcat(blk[k], "c")), [i-1]),i,1,NP)),
          dg(makelist(arraymake(parse_string(sconcat(blk[k], "r")), [i-1]),i,1,NP))), k, 1, length(blk)),
  /*............. RECOVERY DONE ..............................*/

  printf(fh, "#include <gkyl_lbo_pkpm_kernels.h> ~%"),    
  printf(fh, "GKYL_CU_DH double ~a(const double *w, const double *dxv, const double *nuSum, const double *nuPrimMomsSum, const double *fl, const double *fc, const double *fr, double* GKYL_RESTRICT out) ~%{ ~%", funcNm),
  printf(fh, "  // w[NDIM]:       Cell-center coordinates. ~%"),
  printf(fh, "  // dxv[NDIM]:     Cell spacing. ~%"),
  printf(fh, "  // nuSum:         Collisionalities added (self and cross species collisionalities). ~%"),
  printf(fh, "  // nuPrimMomsSum: Sum of bulk velocities and thermal speeds (squared) times their respective collisionalities. ~%"),
  printf(fh, "  // fl/fc/fr:      Input Distribution function [F_0, T_perp G = T_perp (F_1 - F_0), M0_perp, N_perp] in left/center/right cells ~%"),
  printf(fh, "  // out:           Incremented distribution functions in center cell. ~%"),

  printf(fh, "  double rdvSq4 = 4.0/(dxv[~a]*dxv[~a]); ~%", cdim, cdim),
  /* Create a pointer to nuVtSqSum. */
  printf(fh, "  const double *nuVtSqSum = &nuPrimMomsSum[~a];~%", vdim*NC),
  printf(fh, "~%"),
  
  for k : 1 thru length(blk) do (
    printf(fh, "  const double *~al = &fl[~a]; ~%", blk[k], (k-1)*NP),
    printf(fh, "  const double *~ac = &fc[~a]; ~%", blk[k], (k-1)*NP),
    printf(fh, "  const double *~ar = &fr[~a]; ~%", blk[k], (k-1)*NP)
  ),
  for k : 1 thru length(blk) do
    printf(fh, "  double *out_~a = &out[~a]; ~%", blk[k], (k-1)*NP),
  for k : 1 thru length(blk) do
    printf(fh, "  double incr_~a[~a] = {0.0}; ~%", blk[k], NP),
  printf(fh, "~%"),
    
  /* Write out the second derivative of the recovered distribution. */
  nuVtSqSum_e : doExpand1(nuVtSqSum,bC),

  for k : 1 thru length(blk) do (
    if (polyOrder=1 or sdowncase(basisFun)="tensor") then (
      /* This simplification only works for p=1 because it is a tensor product of
         conf and velocity space (remains to be checked for tensor basis). */
      xx : parse_string(sconcat(blk[k], "_xx")),
      printf(fh, "  double ~a_xx[~a] = {0.0}; ~%", blk[k], NP),
      xx_c : calcInnerProdList(varsP, 1, bP, diff(h_e[k], vx, 2)),
      writeCExprs1(xx, xx_c),
      printf(fh, "~%"),
      xx_e : doExpand(makelistNoZeros(xx_c, xx),bP)
    ) else (
      xx_e : diff(h_e[k], vx, 2)
    ),
    incr : parse_string(sconcat("incr_", blk[k])),
    incr_c : calcInnerProdList(varsP, nuVtSqSum_e, bP, xx_e),
    writeCExprs1(incr, incr_c),
    writeCIncrExprs1(parse_string(sconcat("out_", blk[k])), rdvSq4*makelistNoZeros(incr_c, incr)),
    printf(fh, "~%")
  ),

  printf(fh, "  return 0.;~%"),  /* Return CFL frequency from volume kernel. */
  printf(fh, "~%"),

  printf(fh, "} ~%")
);
