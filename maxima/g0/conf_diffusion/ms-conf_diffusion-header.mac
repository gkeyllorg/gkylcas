fh : openw("~/max-out/gkyl_conf_diffusion_kernels.h")$
printf(fh, "#pragma once~%")$
printf(fh, "#include <math.h>~%")$
printf(fh, "#include <gkyl_util.h>~%~%")$
printf(fh, "EXTERN_C_BEG~%~%")$
dirName : ["x","y","z"]$
for cdim : 1 thru 3 do (
  printf(fh, "GKYL_CU_DH double conf_diffusion_vol_~ax_ser_p1(const double *w, const double *dx, const double *K, const double *jacobgeo_inv, const double *f, double* GKYL_RESTRICT out);~%",cdim),
  for dir : 1 thru cdim do
    (printf(fh, "GKYL_CU_DH double conf_diffusion_surf~a_~ax_ser_p1(const double *wc, const double *dxc, const double *Kl, const double *Kc, const double *Kr, const double *fl, const double *fc, const double *fr, double* GKYL_RESTRICT out);~%",dirName[dir],cdim),
    printf(fh, "GKYL_CU_DH double conf_diffusion_boundary_surf~a_~ax_ser_p1(const double *wskin, const double *dxskin, const double *Kedge, const double *Kskin, int edge, const double *fedge, const double *fskin, double* GKYL_RESTRICT out);~%",dirName[dir],cdim)),
  printf(fh,"~%")
)$
printf(fh, "EXTERN_C_END~%")$
close(fh)$
