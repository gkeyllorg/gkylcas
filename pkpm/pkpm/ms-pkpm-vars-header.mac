/* Generate the header file for the PKPM configuration-space variable kernels of the
   refactored (p=1) PKPM solver: nodal quotients, force closure, and fluid fluxes.
   Legacy kernels remain declared in gkyl_euler_pkpm_kernels.h until retired. */

/* ...... USER INPUTS........ */

/* Serendipity basis. */
minPolyOrder_Ser : 1$
maxPolyOrder_Ser : 1$
minCdim_Ser : 1$
maxCdim_Ser : 3$

/* ...... END OF USER INPUTS........ */

cvars : [x, y, z]$

bName        : ["ser"]$
minPolyOrder : [minPolyOrder_Ser]$
maxPolyOrder : [maxPolyOrder_Ser]$
minCdim      : [minCdim_Ser]$
maxCdim      : [maxCdim_Ser]$

printPKPMVarsPrototype(deco, ci, bStr, pi) := block([si, d],
  printf(fh, "~aint pkpm_vars_theta_~ax_~a_p~a(const double *vlasov_pkpm_moms, double* GKYL_RESTRICT theta); ~%", deco, ci, bStr, pi),
  for d : 1 thru ci do
    printf(fh, "~avoid pkpm_vars_grad_u_~a_~ax_~a_p~a(const double *dxv, const double *u_l, const double *u_c, const double *u_r, double* GKYL_RESTRICT grad_u); ~%", deco, cvars[d], ci, bStr, pi),
  printf(fh, "~aint pkpm_vars_p_force_closure_~ax_~a_p~a(const double *vlasov_pkpm_moms, const double *rhs_moms, double* GKYL_RESTRICT a_P); ~%", deco, ci, bStr, pi),
  printf(fh, "~avoid pkpm_vars_pressure_proj_~ax_~a_p~a(const double *vlasov_pkpm_moms, const double *bvar, double* GKYL_RESTRICT p_ij); ~%", deco, ci, bStr, pi),
  printf(fh, "~avoid pkpm_vars_diag_~ax_~a_p~a(const double *dxv, const double *vlasov_pkpm_moms, const double *euler_pkpm,
  const double *bvar, const double *grad_b, const double *u, const double *grad_u, const double *theta, const double *a_P,
  double* GKYL_RESTRICT fluid_io, double* GKYL_RESTRICT pkpm_vars_io); ~%", deco, ci, bStr, pi),
  printf(fh, "~%")
)$

/* ............ Write out the C header file ............ */
fh : openw("~/max-out/gkyl_pkpm_vars_kernels.h")$

printf(fh, "#pragma once ~%")$
printf(fh, "#include <math.h> ~%")$
printf(fh, "#include <gkyl_util.h> ~%")$
printf(fh, "EXTERN_C_BEG ~%")$
printf(fh, "~%")$

decorator : "GKYL_CU_DH "$
for bInd : 1 thru length(bName) do (
  for c : minCdim[bInd] thru maxCdim[bInd] do (
    for polyOrder : minPolyOrder[bInd] thru maxPolyOrder[bInd] do (
      printPKPMVarsPrototype(decorator, c, bName[bInd], polyOrder)
    )
  )
);
printf(fh, "EXTERN_C_END ~%")$
close(fh)$
